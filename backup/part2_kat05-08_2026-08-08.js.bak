// KvízParty kérdésbázis – 2/5 darab (kategóriák: 5–8)
// ---------- 5. Magyar nyelv és szólások ----------
{cat:5,type:'mc',d:1,q:"Mit jelent a szólás: „Egyik kutya, másik eb”?",
 o:["Mindkettő ugyanolyan (rossz)","Nagyon különböznek egymástól","Halálosan összevesztek","Elválaszthatatlan jó barátok"], c:0},
{cat:5,type:'mc',d:1,q:"Hogyan folytatódik a közmondás? „Aki másnak vermet ás...”",
 o:["...maga esik bele","...az nagyot esik","...annak nem lesz nyugta","...az aranyat talál"], c:0},
{cat:5,type:'mc',d:1,q:"Melyik a helyes írásmód?",
 o:["muszáj","muszály","musszáj","musszály"], c:0},
{cat:5,type:'mc',d:2,q:"Mit jelent, ha valaki „kivágja a rezet”?",
 o:["Kiválóan helytáll","Elszökik a munka elől","Dühbe gurul","Elszórja a pénzét"], c:0},
{cat:5,type:'mc',d:2,q:"Mit jelent a szólás: „Vaj van a fején”?",
 o:["Van takargatnivalója, bűnös","Nagyon gazdag","Kissé buta","Szerencsés ember"], c:0},
{cat:5,type:'mc',d:2,q:"Hogyan folytatódik a közmondás: „Ki korán kel...”?",
 o:["...aranyat lel","...sokra megy","...messzire jut","...nagyot alkot"], c:0},
{cat:5,type:'mc',d:2,q:"Mit jelent a közmondás: „Nem esik messze az alma a fájától”?",
 o:["A gyermek tulajdonságaiban a szüleire hasonlít","A gyümölcsöt érdemes frissen leszedni","Aki keveset utazik, keveset tapasztal","Ami közel van, azt könnyű megszerezni"], c:0},
{cat:5,type:'mc',d:2,q:"Melyik írásmód helyes?",
 o:["kisebb","kissebb","kisseb","kiseb"], c:0},
{cat:5,type:'mc',d:2,q:"Melyik nyelvcsaládba tartozik a magyar nyelv?",
 o:["uráli (finnugor)","indoeurópai","türk","sémi"], c:0},
{cat:5,type:'mc',d:3,q:"Az alábbi szavak közül melyik török eredetű jövevényszó?",
 o:["papucs","ablak","asztal","iskola"], c:0},
{cat:5,type:'mc',d:3,q:"Mit jelent a szólás: „köti az ebet a karóhoz”?",
 o:["Makacsul ragaszkodik az állításához","Felelőtlenül ígérget","Szándékosan félrevezet másokat","Erőn felül vállalkozik valamire"], c:0},
{cat:5,type:'mc',d:3,q:"Mit jelent a közmondás: „Fejétől bűzlik a hal”?",
 o:["A bajok forrása többnyire a vezetőknél keresendő","A romlott ételt messziről megérezni","A hibát mindig ott keresd, ahol keletkezett","A rossz hír gyorsan terjed"], c:0},
{cat:5,type:'mc',d:3,q:"Mit jelent, ha „kenyértörésre kerül a sor”?",
 o:["Végleges szakításra, döntő összecsapásra kerül sor","Megegyezés születik a felek között","Kibékülnek a haragosok","Szűkös időszak köszönt be"], c:0},
{cat:5,type:'mc',d:3,q:"Mit jelent a szólás: „kibújik a szög a zsákból”?",
 o:["Kiderül valakinek a titkolt szándéka, igazi természete","Előkerül egy rég elveszett tárgy","Váratlan segítség érkezik","Apró hibából nagy baj lesz"], c:0},
{cat:5,type:'mc',d:3,q:"Melyik magyar település nevéből ered a „kocsi” szavunk, amely számos idegen nyelvbe is átkerült?",
 o:["Kocs","Tata","Mór","Paks"], c:0},
{cat:5,type:'mc',d:3,q:"Melyik a legkorábbi ismert, összefüggő magyar nyelvű szövegemlék?",
 o:["Halotti beszéd és könyörgés","Ómagyar Mária-siralom","Tihanyi apátság alapítólevele","Margit-legenda"], c:0},
{cat:5,type:'mc',d:3,q:"Mit jelent a szólás: „kutyaharapást szőrével”?",
 o:["A bajt azzal orvosoljuk, ami okozta","A sérelmet nem szabad elfelejteni","Kis sebből is lehet nagy baj","A támadásra támadás a válasz"], c:0},
{cat:5,type:'mc',d:3,q:"Mit jelent a régies „kelme” szó?",
 o:["Szövet, textília","Cserépedény","Fejfedő","Kéziszerszám"], c:0},
{cat:5,type:'mc',d:3,q:"Melyik írásmód helyes abban a jelentésben, hogy 'naponta'?",
 o:["mindennap (egybeírva)","minden nap (különírva)","minden-nap (kötőjellel)","mindenap (egy n-nel)"], c:0},
{cat:5,type:'mc',d:3,q:"Melyik a „hisz” ige helyes felszólító módú alakja alanyi ragozásban (te)?",
 o:["higgy","higyj","hidj","higgyj"], c:0},
{cat:5,type:'mc',d:3,q:"Mit jelent a mondás: „Több nap, mint kolbász”?",
 o:["Be kell osztani a javakat, mert nem jut mindennap a jóból","Az idő minden sebet begyógyít","A várakozás meghozza gyümölcsét","Aki sokat ígér, keveset ad"], c:0},
{cat:5,type:'mc',d:4,q:"A 2015-ös akadémiai helyesírási szabályzat (12. kiadás) szerint melyik a helyes írásmód?",
 o:["észszerű","ésszerű","észerű","ész-szerű"], c:0},
{cat:5,type:'mc',d:4,q:"Melyik szavunk szláv eredetű jövevényszó?",
 o:["király","kéz","ház","hal"], c:0},
{cat:5,type:'mc',d:4,q:"Mit jelent a „hűbelebalázs módjára” kifejezés?",
 o:["Meggondolatlanul, elhamarkodottan","Alaposan, körültekintően","Titokban, lopakodva","Nagy zajjal, feltűnően"], c:0},
{cat:5,type:'mc',d:4,q:"Mi volt eredetileg a „csízió”, amelyre az „érti a csíziót” szólás utal?",
 o:["Verses öröknaptár (kalendárium)","Titkosírás","Kártyajáték","Céhszabályzat"], c:0},
{cat:5,type:'mc',d:4,q:"Mit tanácsol a régi mondás: „Suba subához, guba gubához”?",
 o:["Mindenki a maga társadalmi rangjából válasszon párt","A ruhát alkalomhoz illően kell viselni","A hasonló munkákat egyszerre végezzük","Télen két réteg ruha is elkél"], c:0},
{cat:5,type:'mc',d:4,q:"Kire mondták régen, hogy „hétszilvafás nemes”?",
 o:["Elszegényedett, kevés birtokú kisnemesre","Nagy gyümölcsösöket birtokló főúrra","Hét falut birtokló várúrra","Nemesi címét pénzen vevő polgárra"], c:0},
{cat:5,type:'mc',d:5,q:"Mit jelentett eredetileg a „féreg” szó az „ordít, mint a fába szorult féreg” szólásban?",
 o:["Farkast","Kukacot","Kígyót","Egeret"], c:0},
{cat:5,type:'mc',d:5,q:"Mit jelentett eredetileg az „ildomos” szó a régi magyar nyelvben?",
 o:["Okosat, eszélyeset","Illedelmeset","Gyorsat","Bőkezűt"], c:0},
{cat:5,type:'mc',d:5,q:"Mit jelentett a régi magyar nyelvben a „pest” szó, amely Pest városnevében is fennmaradt?",
 o:["Kemencét","Révátkelőt","Vásárteret","Mocsarat"], c:0},
{cat:5,type:'tip',d:1,q:"Hány írásjegyből áll a magyar ábécé „cs” betűje?",a:2,unit:"db",note:"A cs kétjegyű betű: a c és az s írásjegyekből áll."},
{cat:5,type:'tip',d:1,q:"Hány szótagból áll a „kikelet” szó?",a:3,unit:"db",note:"Ki-ke-let; a kikelet a tavasz régies, költői neve."},
{cat:5,type:'tip',d:2,q:"Hány betűből áll a magyar ábécé?",a:44,unit:"betű",note:"a kétjegyű és háromjegyű betűkkel együtt"},
{cat:5,type:'tip',d:2,q:"Hány magánhangzó van a magyar ábécében?",a:14,unit:"",note:"a–á, e–é, i–í, o–ó, ö–ő, u–ú, ü–ű"},
{cat:5,type:'tip',d:2,q:"Hány millió ember beszéli a magyart anyanyelvként?",a:13,unit:"millió fő",note:"kb. 13 millió világszerte"},
{cat:5,type:'tip',d:2,q:"Hányféle magánhangzót szabad használni az eszperente nyelvi játékban?",a:1,unit:"db",note:"Csak az „e” magánhangzó megengedett."},
{cat:5,type:'tip',d:3,q:"Melyik évben kelt a tihanyi apátság alapítólevele, a legkorábbi eredetiben fennmaradt magyar szórványemlékünk?",a:1055,unit:"",note:"I. András adta ki; magyar szavakat is őriz, pl. „feheruuaru rea meneh hodu utu rea”."},
{cat:5,type:'tip',d:3,q:"Melyik évben jelent meg a magyar helyesírási szabályzat jelenleg érvényes, 12. kiadása?",a:2015,unit:"",note:"Ekkor lett például az „ésszerű” helyett „észszerű” a helyes alak."},
{cat:5,type:'tip',d:3,q:"Hány többjegyű betű van a magyar ábécében?",a:9,unit:"db",note:"cs, dz, dzs, gy, ly, ny, sz, ty, zs — közülük a dzs háromjegyű."},
{cat:5,type:'tip',d:3,q:"Hány betűhelyből (karakterből) áll a leghosszabb közismert magyar szó: „megszentségteleníthetetlenségeskedéseitekért”?",a:44,unit:"db",note:"Gyakran emlegetett példa a magyar szóképzés lehetőségeire."},
{cat:5,type:'tip',d:3,q:"November hányadikán ünnepeljük a magyar nyelv napját?",a:13,unit:"",note:"1844. november 13-án fogadták el a magyart államnyelvvé tevő törvényt."},
{cat:5,type:'tip',d:3,q:"Melyik évtől hivatalos nyelve a magyar az Európai Uniónak?",a:2004,unit:"",note:"Magyarország uniós csatlakozásával vált hivatalos EU-nyelvvé."},
{cat:5,type:'tip',d:3,q:"Melyik évben ajánlotta fel Széchenyi István birtokainak egyévi jövedelmét a magyar nyelvet művelő tudós társaság megalapítására?",a:1825,unit:"",note:"Ebből született meg a Magyar Tudományos Akadémia elődje."},
{cat:5,type:'tip',d:3,q:"Február hányadikán van az anyanyelv nemzetközi napja?",a:21,unit:"",note:"Az UNESCO 1999-ben nyilvánította február 21-ét az anyanyelv nemzetközi napjává."},
{cat:5,type:'tip',d:4,q:"Melyik évben jelent meg az első teljes egészében magyar nyelvű nyomtatott könyv (Sylvester János Újtestamentuma)?",a:1541,unit:"",note:"Sárvár-Újszigeten nyomtatták"},
{cat:5,type:'tip',d:4,q:"Melyik évben adta ki a Magyar Tudós Társaság az első akadémiai helyesírási szabályzatot?",a:1832,unit:"",note:"Címe: A magyar helyesírás és szóragasztás főbb szabályai."},
{cat:5,type:'tip',d:4,q:"Melyik évben fedezték fel a Leuveni kódexben az Ómagyar Mária-siralmat, az első ismert magyar nyelvű verset?",a:1922,unit:"",note:"Gragger Róbert azonosította; a kódex 1982-ben került Magyarországra."},
{cat:5,type:'tip',d:4,q:"Melyik évben indult a Magyar Nyelvőr című nyelvművelő folyóirat?",a:1872,unit:"",note:"Szarvas Gábor alapította, és máig megjelenik."},
{cat:5,type:'tip',d:5,q:"Melyik évben született Kazinczy Ferenc, a nyelvújítás vezéralakja?",a:1759,unit:"",note:"Születésnapja, október 27. előtt tisztelegve Széphalmon áll a Magyar Nyelv Múzeuma."},
{cat:5,type:'tip',d:5,q:"Hány kötetben jelent meg a 19. században a Czuczor–Fogarasi-féle „A magyar nyelv szótára”?",a:6,unit:"db",note:"1862 és 1874 között adták ki; máig a legnagyobb ilyen vállalkozások egyike."},

