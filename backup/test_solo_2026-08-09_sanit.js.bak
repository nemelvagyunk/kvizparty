/* KvízParty – szóló mód e2e teszt (gyors mód: #fast) */
const { chromium } = require('playwright');
const path = require('path');

const URL = 'file://' + path.join(__dirname, '..', 'index.html') + '#fast';

(async () => {
  const browser = await chromium.launch({ executablePath: '/opt/pw-browsers/chromium' }).catch(() => chromium.launch());
  const page = await browser.newPage({ viewport: { width: 480, height: 900 } });
  const errors = [];
  page.on('pageerror', e => errors.push('PAGEERROR: ' + e.message));
  page.on('console', m => { if (m.type() === 'error') errors.push('CONSOLE: ' + m.text()); });

  await page.goto(URL);
  await page.screenshot({ path: 'shots/01_menu.png' });

  // --- játékszabályok (FAQ) képernyő ---
  const rules = {};
  rules.btnOnMenu = await page.evaluate(() =>
    !!document.querySelector('#s-menu #btn-rules') && document.getElementById('s-menu').classList.contains('on'));
  await page.click('#btn-rules');
  rules.screenOn = await page.evaluate(() =>
    document.getElementById('s-rules').classList.contains('on') && !document.getElementById('s-menu').classList.contains('on'));
  rules.faqCount = await page.evaluate(() => document.querySelectorAll('#s-rules details').length);
  rules.hasJokers = await page.evaluate(() => {
    const t = document.getElementById('s-rules').textContent;
    return t.indexOf('Felezés') >= 0 && t.indexOf('Dupla vagy semmi') >= 0 &&
           t.indexOf('Első számjegy') >= 0 && t.indexOf('1,9×') >= 0;
  });
  await page.click('#s-rules details:nth-of-type(1) summary');
  rules.opens = await page.evaluate(() => document.querySelector('#s-rules details').open);
  await page.screenshot({ path: 'shots/00_rules.png' });
  await page.click('#btn-rules-back');
  rules.backToMenu = await page.evaluate(() =>
    document.getElementById('s-menu').classList.contains('on') && !document.getElementById('s-rules').classList.contains('on'));

  // --- egységteszt jellegű ellenőrzés: tippelős pontozás + döntetlen-szabály ---
  const logic = await page.evaluate(() => {
    const out = {};
    window.__kv.me = { pid: 'H', isHost: true, name: 'T', avatar: '🦊' };
    window.__kv.host = makeHost(true);
    const mk = (pid) => ({ pid, name: pid, avatar: '🐼', connected: true, score: 0 });
    __kv.host.players = [mk('A'), mk('B'), mk('C')];
    const origBc = window.hostBroadcast;
    let captured = [];
    window.hostBroadcast = m => captured.push(m);

    // 1) tipp (d3=100p): egyenlő távolság -> a leggyorsabb (C) nyer 100 pontot, tie=true
    __kv.host.phase = 'q'; __kv.host.qDur = 25000;
    __kv.host.qData = { type: 'tip', a: 100, unit: '', note: '' };
    __kv.host.deck = [__kv.host.qData]; __kv.host.qi = 0;
    __kv.host.answers = { A: { value: 90, ms: 5000 }, B: { value: 110, ms: 3000 }, C: { value: 110, ms: 2000 } };
    finishQuestion();
    clearTimeout(__kv.host.autoNextT);
    const rev1 = captured.find(m => m.t === 'reveal');
    out.tieWinner = rev1.results.find(r => r.win).pid;      // várt: C
    out.tieFlag = rev1.tie;                                  // várt: true
    out.tieWinnerPts = rev1.results.find(r => r.win).pts;    // várt: 100
    out.loserPts = rev1.results.find(r => r.pid === 'A').pts; // várt: 0

    // 2) tipp (d3=100p): telitalálat -> +25% bónusz (125 pont)
    captured = []; __kv.host.phase = 'q'; __kv.host.answers = { A: { value: 100, ms: 8000 }, B: { value: 90, ms: 1000 } };
    __kv.host.players.forEach(p => p.score = 0);
    finishQuestion(); clearTimeout(__kv.host.autoNextT);
    const rev2 = captured.find(m => m.t === 'reveal');
    out.exactPts = rev2.results.find(r => r.pid === 'A').pts; // várt: 125

    // 3) MC: helyes gyors válasz több pontot ér, rossz válasz 0
    captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 20000;
    __kv.host.qData = { type: 'mc', q: 'x', o: ['jó', 'r1', 'r2', 'r3'], c: 0, note: '' };
    __kv.host.qCorrectIndex = 2;
    __kv.host.players.forEach(p => { p.score = 0; p.streak = 0; p.best = 0; });
    __kv.host.answers = { A: { value: 2, ms: 2000 }, B: { value: 2, ms: 18000 }, C: { value: 0, ms: 1000 } };
    finishQuestion(); clearTimeout(__kv.host.autoNextT);
    const rev3 = captured.find(m => m.t === 'reveal');
    out.mcFast = rev3.results.find(r => r.pid === 'A').pts;  // várt: 118 (100+20%*0.9)
    out.mcSlow = rev3.results.find(r => r.pid === 'B').pts;  // várt: 102
    out.mcWrong = rev3.results.find(r => r.pid === 'C').pts; // várt: 0

    // 4) SOROZAT-BÓNUSZ – csak MC-n épül, a tippelős semleges, 2,50×-nél megáll
    const mcRound = (ansA) => {
      captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 20000;
      __kv.host.qData = { type: 'mc', q: 'x', o: ['jó', 'r1', 'r2', 'r3'], c: 0, note: '' };
      __kv.host.qCorrectIndex = 2;
      // A a paraméter szerint, B mindig hibázik
      __kv.host.answers = { A: { value: ansA, ms: 20000 }, B: { value: 0, ms: 20000 } };
      finishQuestion(); clearTimeout(__kv.host.autoNextT);
      return captured.find(m => m.t === 'reveal').results.find(r => r.pid === 'A');
    };
    const tipRound = () => {
      captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 25000;
      __kv.host.qData = { type: 'tip', a: 100, unit: '', note: '' };
      __kv.host.answers = { A: { value: 900, ms: 5000 }, B: { value: 100, ms: 5000 } }; // A veszít
      finishQuestion(); clearTimeout(__kv.host.autoNextT);
      return captured.find(m => m.t === 'reveal').results.find(r => r.pid === 'A');
    };
    __kv.host.qFinal = false;
    __kv.host.players.forEach(p => { p.score = 0; p.streak = 0; p.best = 0; });
    out.multSeq = [];      // az első 12 egymás utáni helyes válasz szorzója
    out.ptsSeq = [];
    for (let i = 0; i < 12; i++) { const r = mcRound(2); out.multSeq.push(r.mult); out.ptsSeq.push(r.pts); }
    // lassú helyes válasz (ms=qDur) -> nincs gyorsasági bónusz, tehát pts = 100 * szorzó
    out.streakScore = __kv.host.players.find(p => p.pid === 'A').score;

    // tippelős: se nem folytat, se nem tör, és nem kap szorzót
    const t1 = tipRound();
    out.tipKeepsStreak = t1.streak;         // várt: 12 (változatlan)
    out.tipMult = t1.mult;                  // várt: 1 (nincs szorzó a tippelősön)
    const afterTip = mcRound(2);
    out.afterTipStreak = afterTip.streak;   // várt: 13 – a tippelős nem törte meg
    out.afterTipMult = afterTip.mult;       // várt: 1.9 (plafon)

    // hibás válasz nullázza, és jelzi a megszakadást
    const brk = mcRound(0);
    out.brokeFlag = brk.broke;              // várt: 13
    out.brokeStreak = brk.streak;           // várt: 0
    const restart = mcRound(2);
    out.restartMult = restart.mult;         // várt: 1 (elölről)
    out.bestKept = __kv.host.players.find(p => p.pid === 'A').best;  // várt: 13

    // 5) DUPLA PONTOS FINÁLÉ – a pakli utolsó 20%-a
    out.decks = {};
    for (const c of Q_COUNTS) {
      __kv.host.settings.count = c;
      __kv.host.usedIds = new Set();
      buildDeck();
      const d = __kv.host.deck, ff = __kv.host.finalFrom;
      // a pakli szerkezete: [sima MC-k][sima tippek][dupla MC-k][dupla tippek]
      const simple = d.slice(0, ff), fin = d.slice(ff);
      const firstTip = simple.findIndex(q => q.type === 'tip');
      out.decks[c] = {
        len: d.length,
        mc: simple.filter(q => q.type === 'mc').length,
        tip: simple.filter(q => q.type === 'tip').length,
        fmc: fin.filter(q => q.type === 'mc').length,
        ftip: fin.filter(q => q.type === 'tip').length,
        // sorrend: a sima blokkban minden MC megelőz minden tippet …
        mcBlockFirst: firstTip < 0 || simple.slice(firstTip).every(q => q.type === 'tip'),
        // … a dupla blokkban is előbb az MC-k jönnek
        finMcFirst: (() => { const i = fin.findIndex(q => q.type === 'tip'); return i < 0 || fin.slice(i).every(q => q.type === 'tip'); })(),
        uniq: new Set(d.map(q => q.id)).size === d.length,
      };
    }
    out.qCounts = Q_COUNTS.slice();

    // a sorozat átível a tipp-blokkon és a dupla MC-ken is folytatódik (20-as pakli szerkezete)
    __kv.host.qFinal = false;
    __kv.host.players.forEach(p => { p.score = 0; p.streak = 0; p.best = 0; });
    const play = (type, isFinal, correct) => {
      __kv.host.qFinal = isFinal;
      captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 20000;
      __kv.host.qData = type === 'mc'
        ? { type: 'mc', d: 3, q: 'x', o: ['jó', 'r1', 'r2', 'r3'], c: 0, note: '' }
        : { type: 'tip', d: 3, a: 100, unit: '', note: '' };
      __kv.host.qCorrectIndex = 2;
      __kv.host.answers = type === 'mc'
        ? { A: { value: correct ? 2 : 0, ms: 20000 }, B: { value: 0, ms: 20000 } }
        : { A: { value: 900, ms: 5000 }, B: { value: 100, ms: 5000 } };   // a tippet A veszíti
      finishQuestion(); clearTimeout(__kv.host.autoNextT);
      return captured.find(m => m.t === 'reveal').results.find(r => r.pid === 'A');
    };
    for (let i = 0; i < 10; i++) play('mc', false, true);       // 10 sima MC hibátlanul
    for (let i = 0; i < 6; i++) play('tip', false, false);      // 6 tippelős, mind vesztes
    const fm1 = play('mc', true, true);                          // 1. dupla MC
    out.acrossTips = [fm1.streak, fm1.mult, fm1.pts];            // várt: [10, 1, 200] – a finálé sorozat-semleges
    __kv.host.qFinal = false;

    // értékelés: ugyanaz a kérdés normál és finálé alatt
    __kv.host.players.forEach(p => { p.score = 0; p.streak = 0; p.best = 0; });
    const one = (isFinal) => {
      __kv.host.qFinal = isFinal;
      captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 20000;
      __kv.host.qData = { type: 'mc', d: 3, q: 'x', o: ['jó', 'r1', 'r2', 'r3'], c: 0, note: '' };
      __kv.host.qCorrectIndex = 2;
      __kv.host.players.forEach(p => { p.streak = 0; });          // szorzó nélkül mérjünk
      __kv.host.answers = { A: { value: 2, ms: 20000 }, B: { value: 0, ms: 20000 } };
      finishQuestion(); clearTimeout(__kv.host.autoNextT);
      return captured.find(m => m.t === 'reveal').results.find(r => r.pid === 'A').pts;
    };
    out.normalPts = one(false);   // várt: 100
    out.finalPts  = one(true);    // várt: 200
    // finálé + sorozat: a szorzó a fináléban már NEM érvényesül
    __kv.host.players.find(p => p.pid === 'A').streak = 4;   // a következő az 5. -> 1,7×
    out.finalStreakPts = one2();
    function one2() {
      __kv.host.qFinal = true;
      captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 20000;
      __kv.host.qData = { type: 'mc', d: 3, q: 'x', o: ['jó', 'r1', 'r2', 'r3'], c: 0, note: '' };
      __kv.host.qCorrectIndex = 2;
      __kv.host.answers = { A: { value: 2, ms: 20000 }, B: { value: 0, ms: 20000 } };
      finishQuestion(); clearTimeout(__kv.host.autoNextT);
      return captured.find(m => m.t === 'reveal').results.find(r => r.pid === 'A').pts;
    }
    __kv.host.qFinal = false;

    // 5b) KATEGÓRIA-SORSOLÁS: minden kategória egyenlő eséllyel, a méretétől függetlenül
    __kv.host.settings.count = 30; __kv.host.usedIds = new Set();
    const seenMc = {}, seenTip = {}; const nCat = CATEGORIES.length;
    for (let r = 0; r < 400; r++) { __kv.host.usedIds = new Set(); buildDeck();
      for (const q of __kv.host.deck) {
        if (q.type === 'mc') seenMc[q.cat] = (seenMc[q.cat] || 0) + 1;
        else seenTip[tipKey(q.cat)] = (seenTip[tipKey(q.cat)] || 0) + 1;
      } }
    // csak azok a kategóriák számítanak, amelyekben VAN 4 válaszos kérdés
    // (az új 23-as listán a Néphagyomány és a Filozófia még üres – ők nem jöhetnek)
    const hasMc = {}; QUESTIONS.forEach(q => { if (q.type === 'mc') hasMc[q.cat] = 1; });
    const mcC = []; for (let c = 1; c <= nCat; c++) if (hasMc[c]) mcC.push(seenMc[c] || 0);
    out.emptyNever = []; for (let c = 1; c <= nCat; c++) if (!hasMc[c] && seenMc[c]) out.emptyNever.push(c);
    const mcAvg = mcC.reduce((a, b) => a + b, 0) / mcC.length;
    out.catFair = { cats: mcC.length, min: Math.min.apply(null, mcC), max: Math.max.apply(null, mcC),
      avg: Math.round(mcAvg),
      spread: Math.round(100 * (Math.max.apply(null, mcC) - Math.min.apply(null, mcC)) / mcAvg) };
    // a tippelős saját, rövidebb listája – ott is egyenletesen
    const tipK = Object.keys(seenTip), tipC = tipK.map(k => seenTip[k]);
    const tipAvg = tipC.reduce((a, b) => a + b, 0) / tipC.length;
    out.tipFair = { items: tipK.length, keys: tipK.slice().sort(),
      spread: Math.round(100 * (Math.max.apply(null, tipC) - Math.min.apply(null, tipC)) / tipAvg) };
    // a NÉGY VÁLASZOS blokkon belül ne ismétlődjön kategória, amíg mind sorra nem került
    __kv.host.usedIds = new Set(); buildDeck();
    const mcSeq = __kv.host.deck.filter(q => q.type === 'mc').map(q => q.cat);
    const k = Math.min(nCat, mcSeq.length);
    out.noRepeat = new Set(mcSeq.slice(0, k)).size === k;
    __kv.host.settings.count = 15;

    // 6) TIPPELŐS ÉRTÉK A MEZŐNY MÉRETE SZERINT
    out.tipScale = {}; out.tipSecond = {};
    const mkP = n => { const a=[]; for(let i=0;i<n;i++) a.push({pid:'P'+i,name:'P'+i,avatar:'🦊',connected:true,score:0,streak:0,best:0}); return a; };
    for (let n = 2; n <= 6; n++) {
      __kv.host.players = mkP(n);
      __kv.host.qFinal = false;
      __kv.host.qTipMult = tipMultNow();
      __kv.host.qSecond  = tipSecondNow();
      captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 25000;
      __kv.host.qData = { type: 'tip', d: 3, a: 100, unit: '', note: '' };   // 3★ = 100 pont
      // P0 a legközelebbi (101), P1 a második (103), a többiek távolabb
      const ans = {}; for (let i = 0; i < n; i++) ans['P' + i] = { value: 101 + i * 2, ms: 1000 + i * 100 };
      __kv.host.answers = ans;
      finishQuestion(); clearTimeout(__kv.host.autoNextT);
      const rr = captured.find(m => m.t === 'reveal').results;
      out.tipScale[n]  = rr.find(r => r.win).pts;
      out.tipSecond[n] = (rr.find(r => r.second) || { pts: 0 }).pts;
    }
    // telitalálat a skálázott értékre jön (+25%), 6 játékosnál: 200 * 1,25 = 250
    __kv.host.players = mkP(6);
    __kv.host.qFinal = false; __kv.host.qTipMult = tipMultNow(); __kv.host.qSecond = tipSecondNow();
    captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 25000;
    __kv.host.qData = { type: 'tip', d: 3, a: 100, unit: '', note: '' };
    { const ans = { P0: { value: 100, ms: 900 } }; for (let i = 1; i < 6; i++) ans['P' + i] = { value: 100 + i * 5, ms: 1000 + i * 50 }; __kv.host.answers = ans; }
    finishQuestion(); clearTimeout(__kv.host.autoNextT);
    out.tipExact6 = captured.find(m => m.t === 'reveal').results.find(r => r.win).pts;
    // dupla pontos finálé: minden érték kétszerese (4 játékos: 150 -> 300, második 100 -> 200)
    __kv.host.players = mkP(4);
    __kv.host.qFinal = true; __kv.host.qTipMult = tipMultNow(); __kv.host.qSecond = tipSecondNow();
    captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 25000;
    __kv.host.qData = { type: 'tip', d: 3, a: 100, unit: '', note: '' };
    { const ans = {}; for (let i = 0; i < 4; i++) ans['P' + i] = { value: 101 + i * 2, ms: 1000 + i * 100 }; __kv.host.answers = ans; }
    finishQuestion(); clearTimeout(__kv.host.autoNextT);
    { const rr = captured.find(m => m.t === 'reveal').results;
      out.tipFinal4 = [rr.find(r => r.win).pts, rr.find(r => r.second).pts]; }
    // 3 fős finálé: a második a duplázott érték 40%-át kapja = a normál érték 0,8-szerese (100 -> 80)
    __kv.host.players = mkP(3);
    __kv.host.qFinal = true; __kv.host.qTipMult = tipMultNow(); __kv.host.qSecond = tipSecondNow();
    captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 25000;
    __kv.host.qData = { type: 'tip', d: 3, a: 100, unit: '', note: '' };
    { const ans = {}; for (let i = 0; i < 3; i++) ans['P' + i] = { value: 101 + i * 2, ms: 1000 + i * 100 }; __kv.host.answers = ans; }
    finishQuestion(); clearTimeout(__kv.host.autoNextT);
    { const rr = captured.find(m => m.t === 'reveal').results;
      out.tipFinal3 = [rr.find(r => r.win).pts, rr.find(r => r.second).pts]; }
    __kv.host.qFinal = false; __kv.host.qTipMult = 1; __kv.host.qSecond = 0;

    // 7) VÉGI STATISZTIKÁK – díjak
    __kv.host.qFinal = false; __kv.host.stats = {}; __kv.host.qTipMult = 1; __kv.host.qSecond = false;
    __kv.host.players = [
      { pid: 'A', name: 'Anna', avatar: '🦊', connected: true, score: 0, streak: 0, best: 0 },
      { pid: 'B', name: 'Bea',  avatar: '🐼', connected: true, score: 0, streak: 0, best: 0 },
      { pid: 'C', name: 'Cili', avatar: '🦁', connected: true, score: 0, streak: 0, best: 0 },
    ];
    const mcQ = (ans) => {
      captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 20000;
      __kv.host.qData = { type: 'mc', d: 3, q: 'x', o: ['jó', 'r1', 'r2', 'r3'], c: 0, note: '' };
      __kv.host.qCorrectIndex = 2; __kv.host.qOptions = ['r1', 'r2', 'jó', 'r3']; __kv.host.answers = ans;
      finishQuestion(); clearTimeout(__kv.host.autoNextT);
    };
    const tipQ = (a, ans) => {
      captured = []; __kv.host.phase = 'q'; __kv.host.qDur = 25000;
      __kv.host.qData = { type: 'tip', d: 3, q: 'Tipp-' + a + '?', a, unit: '', note: '' };
      __kv.host.answers = ans;
      finishQuestion(); clearTimeout(__kv.host.autoNextT);
    };
    // MC: Anna gyors+jó (1,2s), Bea lassabb+jó, Cili villámgyorsan rossz (0,4s)
    mcQ({ A: { value: 2, ms: 1200 }, B: { value: 2, ms: 8000 }, C: { value: 0, ms: 400 } });
    mcQ({ A: { value: 2, ms: 3000 }, B: { value: 0, ms: 9000 }, C: { value: 2, ms: 7000 } });
    // Anna 2 sorozatot épített; Bea megszakadt
    // TIP: Bea nyer gyorsan (2,0s), Anna telitalálat de lassabb, Cili gyorsan mellé (0,9s)
    tipQ(100, { A: { value: 100, ms: 6000 }, B: { value: 100, ms: 2000 }, C: { value: 5, ms: 900 } });
    tipQ(50,  { A: { value: 55, ms: 4000 },  B: { value: 51, ms: 3000 }, C: { value: 900, ms: 1500 } });
    // nagy számú kérdés: abszolút hibában ez lenne a legnagyobb, de relatívban NEM (2%)
    tipQ(9600000, { A: { value: 9400000, ms: 5000 }, B: { value: 9600000, ms: 4000 }, C: { value: 9000000, ms: 3000 } });
    out.awards = buildAwards().map(a => ({ t: a.title, who: a.names.join(','), v: a.value, sub: a.sub || null }));
    out.statA = __kv.host.stats['A'];

    window.hostBroadcast = origBc;
    window.__kv.host = null;
    return out;
  });
  console.log('LOGIKA:', JSON.stringify({ tieWinner: logic.tieWinner, tieFlag: logic.tieFlag, tieWinnerPts: logic.tieWinnerPts,
    loserPts: logic.loserPts, exactPts: logic.exactPts, mcFast: logic.mcFast, mcSlow: logic.mcSlow, mcWrong: logic.mcWrong }));

  let sf = 0;
  const ck = (n, got, want) => { const ok = JSON.stringify(got) === JSON.stringify(want); if (!ok) sf++;
    console.log((ok ? '  ✔ ' : '  ✘ ') + n + '  → ' + JSON.stringify(got) + (ok ? '' : ' (várt: ' + JSON.stringify(want) + ')')); };
  console.log('JÁTÉKSZABÁLYOK (FAQ):');
  ck('a 📖 gomb a főmenüben van', rules.btnOnMenu, true);
  ck('kattintásra a szabály-képernyő nyílik meg', rules.screenOn, true);
  ck('legalább 12 FAQ-tétel van', rules.faqCount >= 12, true);
  ck('a jokerek és az 1,9× streak-plafon is szerepel benne', rules.hasJokers, true);
  ck('a tételek lenyithatók', rules.opens, true);
  ck('a vissza gomb a főmenübe visz', rules.backToMenu, true);
  console.log('SOROZAT-BÓNUSZ:');
  ck('szorzók az 1–12. helyes válaszra (az 1–2. bónusz nélkül, 1,90-es plafon)', logic.multSeq,
     [1, 1, 1.3, 1.5, 1.7, 1.9, 1.9, 1.9, 1.9, 1.9, 1.9, 1.9]);
  ck('pontok ugyanezekre (100 alapérték, gyorsbónusz nélkül)', logic.ptsSeq,
     [100, 100, 130, 150, 170, 190, 190, 190, 190, 190, 190, 190]);
  ck('összpont = a szorzók összege × 100 (19,80 × 100)', logic.streakScore, 1980);
  ck('tippelős nem töri meg a sorozatot', logic.tipKeepsStreak, 12);
  ck('tippelős pontja nem kap szorzót', logic.tipMult, 1);
  ck('a tippelős után a sorozat folytatódik', [logic.afterTipStreak, logic.afterTipMult], [13, 1.9]);
  ck('hibás válasz nullázza és jelzi a megszakadást', [logic.brokeFlag, logic.brokeStreak], [13, 0]);
  ck('utána elölről indul', logic.restartMult, 1);
  ck('a leghosszabb sorozat megmarad a végeredményhez', logic.bestKept, 13);
  // a sorozat-skála kiemelése: 7+ szériánál az utolsó (1,9×) chip marad "now"
  const scl = await page.evaluate(() => {
    __kv.me = { pid: 'H', isHost: true, name: 'T', avatar: '🦊' };
    const chips = h => (h.match(/<span class="(now|on|)">/g) || []).map(x => x.slice(13, -2));
    return {
      s3: chips(streakBlock({ type: 'mc', final: false, results: [{ pid: 'H', streak: 3, mult: 1.3, broke: 0 }] })),
      s7: chips(streakBlock({ type: 'mc', final: false, results: [{ pid: 'H', streak: 7, mult: 1.9, broke: 0 }] })),
      s7max: /a szorzód a csúcson/.test(streakBlock({ type: 'mc', final: false, results: [{ pid: 'H', streak: 7, mult: 1.9, broke: 0 }] })),
    };
  });
  ck('a skálán 3-as sorozatnál a 3. chip a "now"', scl.s3, ['on', 'on', 'now', '', '', '']);
  ck('7+ sorozatnál az utolsó (1,9×) chip marad kiemelve', [scl.s7, scl.s7max], [['on', 'on', 'on', 'on', 'on', 'now'], true]);
  console.log('DUPLA PONTOS FINÁLÉ:');
  ck('választható kérdésszámok (50 nincs)', logic.qCounts, [10, 15, 20, 30]);
  const plan = { 10: [5, 3, 1, 1], 15: [7, 5, 2, 1], 20: [10, 6, 2, 2], 30: [14, 10, 4, 2] };
  for (const c of [10, 15, 20, 30]) {
    const d = logic.decks[c], w = plan[c];
    ck(c + ' kérdés = ' + w[0] + ' MC + ' + w[1] + ' tipp + ' + w[2] + ' dupla MC + ' + w[3] + ' dupla tipp',
       [d.len, d.mc, d.tip, d.fmc, d.ftip], [c, w[0], w[1], w[2], w[3]]);
    ck(c + ': előbb az összes sima MC, utána a tippek', d.mcBlockFirst, true);
    ck(c + ': a dupla blokkban is előbb az MC-k', d.finMcFirst, true);
    ck(c + ': nincs ismétlődő kérdés a pakliban', d.uniq, true);
  }
  ck('3★ kérdés normál körben 100 pont', logic.normalPts, 100);
  ck('ugyanaz a fináléban 200 pont', logic.finalPts, 200);
  ck('a fináléban a sorozat-szorzó NEM él: 5-ös sorozattal is 200 pont', logic.finalStreakPts, 200);
  ck('a sorozat átível a tipp-blokkon, de a dupla MC már semleges: sorozat marad 10, 1×, 200 pont',
     logic.acrossTips, [10, 1, 200]);
  console.log('KATEGÓRIA-SORSOLÁS:');
  console.log('    ' + logic.catFair.cats + ' kategória · 400 pakli × 30 kérdés · kategóriánként átlag '
    + logic.catFair.avg + ' (min ' + logic.catFair.min + ' / max ' + logic.catFair.max + ')');
  ck('minden kategória egyenlő eséllyel jön a 4 válaszosnál (szórás < 20%)', logic.catFair.spread < 20, true);
  ck('a 4 válaszos blokkban nem ismétlődik kategória, amíg mind sorra nem került', logic.noRepeat, true);
  ck('üres (kérdés nélküli) kategória sosem kerül a pakliba', logic.emptyNever, []);
  console.log('    tippelős tételek (' + logic.tipFair.items + '): ' + logic.tipFair.keys.join(' · '));
  ck('a tippelős saját, rövidebb listája is egyenletes (szórás < 20%)', logic.tipFair.spread < 20, true);
  console.log('TIPPELŐS ÉRTÉK A MEZŐNY MÉRETE SZERINT (3★ = 100 pont):');
  ck('nyertes értéke 2–6 játékosnál', logic.tipScale, { 2: 100, 3: 125, 4: 150, 5: 175, 6: 200 });
  ck('második legjobb tipp (3 főnél 40%, 4 játékostól a teljes kérdésérték)', logic.tipSecond, { 2: 0, 3: 40, 4: 100, 5: 100, 6: 100 });
  ck('telitalálat a skálázott értékre jön (6 fő: 200 + 25% = 250)', logic.tipExact6, 250);
  ck('dupla pontos fináléban minden érték kétszeres (4 fő: 300 / 200)', logic.tipFinal4, [300, 200]);
  ck('3 fős finálé: a második a normál érték 0,8-szeresét kapja (250 / 80)', logic.tipFinal3, [250, 80]);
  console.log('VÉGI DÍJAK:');
  const aw = Object.fromEntries(logic.awards.map(a => [a.t, a.who + ' / ' + a.v]));
  logic.awards.forEach(a => console.log('    ' + a.t + ' → ' + a.who + ' (' + a.v + ')'));
  ck('leggyorsabb helyes Kérdés-válasz', aw['Leggyorsabb helyes válasz · Kérdés-válasz'], 'Anna / 1,2 mp');
  ck('leggyorsabb rossz Kérdés-válasz', aw['Leggyorsabb rossz válasz · Kérdés-válasz'], 'Cili / 0,4 mp');
  ck('a leggyorsabb rossz válasznál a kérdés és az elrontott válasz is látszik',
     logic.awards.find(a => a.t.indexOf('rossz válasz') >= 0).sub, '„x” — válasza: r1 (a jó: jó)');
  ck('leggyorsabb nyerő tipp', aw['Leggyorsabb nyerő tipp'], 'Bea / 2,0 mp');
  ck('legnagyobb melléfogás relatív hibában (Cili: 50 helyett 900 = 17×)',
     aw['Legnagyobb melléfogás · tippelős'], 'Cili / 17× mellé');
  ck('a nagy számú kérdés 200 000-es abszolút hibája NEM viszi el a díjat, és a kérdés is látszik',
     logic.awards.find(a => a.t.indexOf('melléfogás') >= 0).sub, '„Tipp-50?” — tippje 900, a jó válasz 50 volt');
  ck('leghosszabb sorozat', aw['Leghosszabb sorozat'], 'Anna / 2 egymás után');
  ck('legtöbb telitalálat (Bea kétszer is pontosan eltalálta)',
     aw['Legtöbb telitalálat'], 'Bea / 2 db');

  // --- teljes szóló játék végigjátszása ---
  await page.reload();
  await page.fill('#inp-name', 'Attila');
  await page.click('#avatars button:nth-child(3)');
  await page.click('#btn-solo');
  await page.waitForSelector('#s-lobby.on');
  await page.click('#seg-ai button[data-ai="0"]'); // +1 AI (Robo Róbert) -> 3 játékos
  await page.click('#seg-count button[data-c="10"]');
  await page.screenshot({ path: 'shots/02_lobby.png' });
  await page.click('#btn-start');
  await page.waitForSelector('#s-game.on');

  let mcShot = false, tipShot = false, revealShot = false, guesses = 0, mcs = 0;
  for (let i = 0; i < 40; i++) {
    const state = await Promise.race([
      page.waitForSelector('.mcbtn:not(.dis)', { timeout: 8000 }).then(() => 'mc').catch(() => null),
      page.waitForSelector('#tip-inp:not([disabled])', { timeout: 8000 }).then(() => 'tip').catch(() => null),
      page.waitForSelector('#s-end.on', { timeout: 8000 }).then(() => 'end').catch(() => null),
    ]);
    if (state === 'end') break;
    if (state === 'mc') {
      mcs++;
      if (!mcShot) { await page.screenshot({ path: 'shots/03_mc.png' }); mcShot = true; }
      // az esetek felében hagyjuk lejárni az időt (timeout ág tesztje)
      if (mcs !== 2) await page.click('.mcbtn:nth-child(2)').catch(() => {});
    } else if (state === 'tip') {
      guesses++;
      if (!tipShot) { await page.screenshot({ path: 'shots/04_tip.png' }); tipShot = true; }
      await page.fill('#tip-inp', String(1500 + guesses)).catch(() => {});
      await page.click('#tip-btn').catch(() => {});
    } else {
      // reveal vagy átmenet — várjunk egy kicsit
      await page.waitForTimeout(400);
    }
    // reveal képernyőkép egyszer
    if (!revealShot) {
      const rc = await page.waitForSelector('.revcard', { timeout: 6000 }).catch(() => null);
      if (rc) { await page.screenshot({ path: 'shots/05_reveal.png' }); revealShot = true; }
    }
    // várjuk meg, míg eltűnik a revcard (következő kérdés) vagy vége
    await Promise.race([
      page.waitForSelector('.revcard', { state: 'detached', timeout: 8000 }).catch(() => {}),
      page.waitForSelector('#s-end.on', { timeout: 8000 }).catch(() => {}),
    ]);
    if (await page.$('#s-end.on')) break;
  }

  await page.waitForSelector('#s-end.on', { timeout: 20000 });
  await page.screenshot({ path: 'shots/06_end.png' });
  const endText = await page.$eval('#end-list', el => el.innerText.replace(/\n/g, ' | '));
  console.log('VÉGEREDMÉNY:', endText);
  console.log('MC kérdések:', mcs, '| tippelős:', guesses);

  // új meccs gomb -> lobby
  await page.click('#btn-rematch');
  await page.waitForSelector('#s-lobby.on', { timeout: 5000 });
  console.log('REMATCH: OK (vissza a lobbyba)');

  // --- nincs kategória-szűrő: a lobby nem mutat téma-kapcsolókat ---
  console.log('KATEGÓRIA-SZŰRŐ NÉLKÜL:');
  const chips = await page.$$eval('#seg-opt button', els => els.length).catch(() => 0);
  ck('a lobbyban nincs téma-kapcsoló', chips, 0);
  ck('a settings nem tartalmaz cats mezőt', await page.evaluate(() => 'cats' in __kv.host.settings), false);

  // --- TEMPÓ-KAPCSOLÓ: Nyugodt (10 mp) / Pörgős (4 mp) visszaszámlálás ---
  console.log('TEMPÓ:');
  const tmp0 = await page.evaluate(() => ({
    btns: document.querySelectorAll('#seg-tempo button').length,
    calmSel: document.querySelector('#seg-tempo button[data-t="calm"]').classList.contains('sel'),
    def: __kv.host.settings.tempo,
  }));
  ck('a lobbyban van tempó-kapcsoló, alapból 🐢 Nyugodt', [tmp0.btns, tmp0.calmSel, tmp0.def], [2, true, 'calm']);
  await page.click('#seg-tempo button[data-t="fast"]');
  const tmp1 = await page.evaluate(() => ({
    t: __kv.host.settings.tempo,
    sel: document.querySelector('#seg-tempo button[data-t="fast"]').classList.contains('sel'),
  }));
  ck('a ⚡ Pörgős gomb átállítja a beállítást', [tmp1.t, tmp1.sel], ['fast', true]);
  const tmp2 = await page.evaluate(() => {
    const out = {};
    __kv.me = { pid: 'H', isHost: true, name: 'T', avatar: '🦊' };
    __kv.host = makeHost(true);
    const deck = [{ id: 3, cat: 1, type: 'mc', d: 3, q: 'x', o: ['a', 'b', 'c', 'd'], c: 0 }];
    const orig = window.hostBroadcast; let cap = [];
    window.hostBroadcast = m => cap.push(m);
    __kv.host.deck = deck; __kv.host.qi = -1; __kv.host.finalFrom = 99; __kv.host.sMcLen = 1;
    hostNext(); clearTimeout(__kv.host.catT);
    out.calm = cap.find(m => m.t === 'catdraw').count === CAT_COUNT_MS;
    __kv.host.settings.tempo = 'fast';
    __kv.host.qi = -1; cap = [];
    hostNext(); clearTimeout(__kv.host.catT);
    out.fast = cap.find(m => m.t === 'catdraw').count === CAT_COUNT_FAST_MS;
    window.hostBroadcast = orig;
    return out;
  });
  ck('a catdraw üzenet a tempó szerinti visszaszámlálást viszi', [tmp2.calm, tmp2.fast], [true, true]);

  // --- JOKEREK: felezés + dupla vagy semmi (host-oldali logika) ---
  console.log('JOKEREK:');
  const jok = await page.evaluate(() => {
    const out = {};
    __kv.me = { pid: 'H', isHost: true, name: 'T', avatar: '🦊' };
    __kv.host = makeHost(true);
    const mk = pid => ({ pid, name: pid, avatar: '🐼', connected: true, score: 0, streak: 0, best: 0 });
    __kv.host.players = [mk('A'), mk('B')];
    const orig = window.hostBroadcast;
    let captured = []; window.hostBroadcast = m => captured.push(m);
    __kv.host.sMcLen = 5; __kv.host.finalFrom = 8;
    const mcQ = () => { __kv.host.phase = 'q'; __kv.host.qDur = 20000; __kv.host.qFinal = false; __kv.host.qi = 0;
      __kv.host.qData = { type: 'mc', d: 3, q: 'x', o: ['jó', 'r1', 'r2', 'r3'], c: 0, note: '' };
      __kv.host.qCorrectIndex = 2; __kv.host.qJok = {}; __kv.host.answers = {}; };
    // 1) dupla + helyes: fixen 2×V, a sorozat-szorzót nem nézi (de a sorozat épül)
    __kv.host.jokers = { A: { fifty: true, double: true }, B: { fifty: true, double: true } };
    mcQ(); hostJoker('A', 'double');
    out.spent = [__kv.host.qJok.A, __kv.host.jokers.A.double];               // ['double', false]
    __kv.host.players.find(p => p.pid === 'A').streak = 4;                   // 1,7× lenne, de nem számít
    __kv.host.answers = { A: { value: 2, ms: 1000 }, B: { value: 2, ms: 20000 } };
    captured = []; finishQuestion(); clearTimeout(__kv.host.autoNextT);
    let rv = captured.find(m => m.t === 'reveal');
    out.dblWin = [rv.results.find(r => r.pid === 'A').pts, rv.results.find(r => r.pid === 'A').jok,
                  rv.results.find(r => r.pid === 'A').streak];               // [200,'double',5]
    // 2) dupla + rossz: −V, a pontszám negatívba fordulhat
    const A = __kv.host.players.find(p => p.pid === 'A'); A.score = 0; A.streak = 0;
    __kv.host.jokers.A.double = true;
    mcQ(); hostJoker('A', 'double');
    __kv.host.answers = { A: { value: 0, ms: 5000 }, B: { value: 2, ms: 20000 } };
    captured = []; finishQuestion(); clearTimeout(__kv.host.autoNextT);
    rv = captured.find(m => m.t === 'reveal');
    out.dblLose = [rv.results.find(r => r.pid === 'A').pts, A.score];        // [-100, -100]
    // 3) elmaradt válasz aktív duplával szintén −V
    A.score = 0; __kv.host.jokers.A.double = true;
    mcQ(); hostJoker('A', 'double');
    __kv.host.answers = { B: { value: 2, ms: 20000 } };
    captured = []; finishQuestion(); clearTimeout(__kv.host.autoNextT);
    out.dblTimeout = A.score;                                                // -100
    // 4) felezés után ugyanabban a körben nincs dupla; a felezés 2 külön rossz opciót ad
    __kv.host.jokers.A = { fifty: true, double: true };
    mcQ(); hostJoker('A', 'fifty'); hostJoker('A', 'double');
    const rm = jokerRemovePair();
    out.fifty = [__kv.host.qJok.A, __kv.host.jokers.A.double,
                 rm.length, rm.indexOf(__kv.host.qCorrectIndex) < 0, rm[0] !== rm[1]];  // ['fifty',true,2,true,true]
    // 5) fináléban és a tipp-blokk után nem aktiválható
    __kv.host.jokers.A = { fifty: true, double: true };
    mcQ(); __kv.host.qFinal = true; hostJoker('A', 'double');
    out.finalBlocked = !__kv.host.qJok.A;
    mcQ(); __kv.host.qi = 6; hostJoker('A', 'double');                       // sMcLen=5 → a 7. kérdés már nem sima MC
    out.pastBlocked = !__kv.host.qJok.A;
    // 6) auto-felezés az utolsó sima MC-n (csak akinek megvan; AI kimarad)
    __kv.host.players.push({ pid: 'AI1', name: 'R', avatar: '🤖', isAI: true, ai: 0, connected: true, score: 0 });
    __kv.host.deck = [{ id: 1, cat: 1, type: 'mc', d: 3, q: 'x', o: ['jó', 'r1', 'r2', 'r3'], c: 0 }];
    __kv.host.qi = 0; __kv.host.sMcLen = 1; __kv.host.finalFrom = 99; __kv.host.qFinal = false; __kv.host.phase = 'catdraw';
    __kv.host.jokers = { A: { fifty: true, double: true }, B: { fifty: false, double: true } };
    captured = []; hostAsk(); clearTimeout(__kv.host.qDeadlineT);
    (__kv.host.aiTimers || []).forEach(clearTimeout);
    out.auto = [__kv.host.jokers.A.fifty, __kv.host.qJok.A || 0, __kv.host.qJok.B || 0, __kv.host.qJok.AI1 || 0,
                captured.find(m => m.t === 'question').jok];                 // [false,'fifty',0,0,true]
    window.hostBroadcast = orig;
    return out;
  });
  ck('a joker elhasználódik és bejegyződik a körre', jok.spent, ['double', false]);
  ck('dupla + helyes: fixen 2×érték, sorozat-szorzó nélkül (a sorozat attól épül)', jok.dblWin, [200, 'double', 5]);
  ck('dupla + rossz: −érték, a pontszám negatívba mehet', jok.dblLose, [-100, -100]);
  ck('dupla + elmaradt válasz: szintén −érték', jok.dblTimeout, -100);
  ck('felezés után nincs dupla a körben; a felezés 2 külön rossz opciót jelöl', jok.fifty, ['fifty', true, 2, true, true]);
  ck('fináléban nem aktiválható joker', jok.finalBlocked, true);
  ck('a sima MC-blokk után nem aktiválható joker', jok.pastBlocked, true);
  ck('az utolsó sima MC-n automatikusan élesedik a megmaradt Felezés (AI-nak nincs)', jok.auto, [false, 'fifty', 0, 0, true]);

  // --- TIPP-JOKEREK: első/utolsó számjegy ---
  console.log('TIPP-JOKEREK:');
  const tj = await page.evaluate(() => {
    const out = {};
    out.digits = [tipDigit(1956, 'first'), tipDigit(1956, 'last'),
                  tipDigit(7, 'first'), tipDigit(7, 'last'), tipDigit(-273, 'last')];
    __kv.me = { pid: 'H', isHost: true, name: 'T', avatar: '🦊' };
    __kv.host = makeHost(true);
    const mk = pid => ({ pid, name: pid, avatar: '🐼', connected: true, score: 0, streak: 0, best: 0 });
    __kv.host.players = [mk('A'), mk('B')];
    __kv.host.sMcLen = 5; __kv.host.finalFrom = 8;
    const tipQ = () => { __kv.host.phase = 'q'; __kv.host.qDur = 25000; __kv.host.qFinal = false; __kv.host.qi = 5;
      __kv.host.qData = { type: 'tip', d: 3, q: 'x', a: 1956, unit: '', note: '' };
      __kv.host.qJok = {}; __kv.host.answers = {}; };
    __kv.host.jokers = { A: { fifty: true, double: true, tip: true } };
    // 1) aktiválás: a kör bejegyzi, MINDKÉT számjegy-kártya elfogy
    tipQ(); hostJoker('A', 'first');
    out.used = [__kv.host.qJok.A, __kv.host.jokers.A.tip];        // ['first', false]
    // 2) a másik kártya már nem váltható be egy későbbi tippen sem
    tipQ(); hostJoker('A', 'last');
    out.second = __kv.host.qJok.A || 0;                            // 0
    // 3) MC-kérdésen és finálé-tippen nem megy
    __kv.host.jokers.A.tip = true;
    tipQ(); __kv.host.qData.type = 'mc'; __kv.host.qCorrectIndex = 0; hostJoker('A', 'first');
    out.onMc = __kv.host.qJok.A || 0;                              // 0
    tipQ(); __kv.host.qFinal = true; hostJoker('A', 'last');
    out.onFinal = __kv.host.qJok.A || 0;                           // 0
    // 4) az MC-jokerek viszont tippen nem aktiválhatók
    tipQ(); hostJoker('A', 'double');
    out.mcJokOnTip = __kv.host.qJok.A || 0;                        // 0
    return out;
  });
  ck('számjegyek: 1956→1/6, egyjegyű 7→7/7, −273 utolsó→3', tj.digits, ['1', '6', '7', '7', '3']);
  ck('a számjegy-kártya beváltása MINDKÉT tipp-jokert elhasználja', tj.used, ['first', false]);
  ck('a másik számjegy-kártya már nem váltható be', tj.second, 0);
  ck('MC-n, finálé-tippen és tippre húzott MC-jokerrel nem megy', [tj.onMc, tj.onFinal, tj.mcJokOnTip], [0, 0, 0]);

  // --- KÉRDÉS-MEMÓRIA: a feltett kérdések a munkameneten át nem térnek vissza ---
  console.log('KÉRDÉS-MEMÓRIA:');
  const rep = await page.evaluate(() => {
    __kv.me = { pid: 'H', isHost: true, name: 'T', avatar: '🦊' };
    __kv.host = makeHost(true);                       // usedIds = munkamenet-szintű készlet
    __kv.host.settings.count = 30; buildDeck();
    const first = __kv.host.deck.map(q => q.id);
    first.forEach(id => __kv.host.usedIds.add(id));   // mintha végigjátszottuk volna
    __kv.host = makeHost(true);                       // ÚJ játék a főmenüből – a memória megmarad
    __kv.host.settings.count = 30; buildDeck();
    const second = __kv.host.deck.map(q => q.id);
    // hódítás-pool is kerüli a használtakat
    const pools = cqBuildPools();
    const cqHit = pools.mc.filter(q => first.includes(q.id)).length +
                  pools.tip.filter(q => first.includes(q.id)).length;
    return { overlap: second.filter(id => first.includes(id)).length,
             shared: __kv.host.usedIds.size >= first.length, cqHit };
  });
  ck('új játékban nem térnek vissza a már feltett kérdések', rep.overlap, 0);
  ck('a memória a főmenübe kilépést is túléli (közös készlet)', rep.shared, true);
  ck('a hódítás kérdés-poolja is kerüli a használtakat', rep.cqHit, 0);

  // --- TIPP-TÉTELEK KIJELZÉSE: mindig a 9 sorsolási tétel neve látszik ---
  console.log('TIPP-TÉTELEK KIJELZÉSE:');
  const ti = await page.evaluate(() => {
    const out = { n: tipItems().length, names: tipItems().map(x => x.name).sort() };
    out.urk  = tipItemInfo(16).name;   // űrkutatási tipp → Feltalálók és találmányok
    out.vf   = tipItemInfo(8).name;    // világföldrajzi tipp → Földrajz
    out.film = tipItemInfo(20).name;   // nemzetközi filmes tipp → Filmek
    out.mt   = tipItemInfo(1).name;    // saját tétel marad
    // a catdraw üzenet tényleg a tétel nevét viszi
    __kv.me = { pid: 'H', isHost: true, name: 'T', avatar: '🦊' };
    __kv.host = makeHost(true);
    __kv.host.deck = [{ id: 2, cat: 16, type: 'tip', d: 3, q: 'x', a: 1, unit: '', note: '' }];
    __kv.host.qi = -1; __kv.host.finalFrom = 99; __kv.host.sMcLen = 0;
    let captured = []; const orig = window.hostBroadcast; window.hostBroadcast = m => captured.push(m);
    hostNext(); clearTimeout(__kv.host.catT);
    window.hostBroadcast = orig;
    out.drawCat = captured.find(m => m.t === 'catdraw').cat.name;
    return out;
  });
  ck('pontosan 9 tippelős sorsolási tétel van', ti.n, 9);
  ck('űrkutatási tipp tétele: Feltalálók és találmányok', [ti.urk, ti.drawCat], ['Feltalálók és találmányok', 'Feltalálók és találmányok']);
  ck('földrajz és film tételek összevonva, a saját tétel marad', [ti.vf, ti.film, ti.mt], ['Földrajz', 'Filmek', 'Magyar történelem']);

  // --- HANGOK: WebAudio motor + némítás gomb ---
  console.log('HANGOK:');
  const snd0 = await page.evaluate(() => ({
    btn: !!document.getElementById('snd-btn'),
    icon: document.getElementById('snd-btn').textContent,
    engine: typeof SND === 'object' && typeof play === 'function' && typeof sndInit === 'function',
    ctx: !!SND.ctx,          // a korábbi kattintások (gesztusok) már létrehozták
    on: SND.on,
  }));
  ck('van hang-motor, és a némítás gomb 🔊-val indul', [snd0.btn, snd0.engine, snd0.icon, snd0.on], [true, true, '🔊', true]);
  ck('az AudioContext felhasználói gesztusra létrejött', snd0.ctx, true);
  await page.click('#snd-btn');
  const snd1 = await page.evaluate(() => ({ icon: document.getElementById('snd-btn').textContent, on: SND.on,
    off: document.getElementById('snd-btn').classList.contains('off') }));
  ck('némítás: 🔇 ikon, SND.on=false, halvány gomb', [snd1.icon, snd1.on, snd1.off], ['🔇', false, true]);
  await page.click('#snd-btn');
  const snd2 = await page.evaluate(() => ({ icon: document.getElementById('snd-btn').textContent, on: SND.on }));
  ck('visszakapcsolás: 🔊 ikon, SND.on=true', [snd2.icon, snd2.on], ['🔊', true]);
  const sndPlay = await page.evaluate(() => {
    try {
      ['tick','spin','land','q','send','good','small','bad','meh','joker','turn','fanfare','win','nincsilyen']
        .forEach(n => play(n));
      return true;
    } catch (e) { return String(e); }
  });
  ck('minden hang (és ismeretlen név is) hiba nélkül lejátszható', sndPlay, true);

  // --- protokoll-verzió (néma inkompatibilitás elleni védelem) ---
  console.log('PROTOKOLL-VERZIÓ:');
  const pv = await page.evaluate(() => {
    window.__kv.host = makeHost(true); __kv.host.players = [];
    return { proto: window.__kv.proto, note: document.getElementById('ver-note').textContent || '',
             lobbyV: hostLobbyMsg().v };
  });
  ck('van protokoll-verzió, és a főmenü ki is írja', [typeof pv.proto === 'number' && pv.proto >= 2,
      pv.note.indexOf('v' + pv.proto) >= 0], [true, true]);
  ck('a lobby üzenet viszi a verziót', pv.lobbyV, pv.proto);

  const wOk = await page.evaluate(() => {
    window.__kv.me.pid = null;
    handleMsg({ t: 'welcome', v: window.__kv.proto, you: 'GUEST-1' });
    return window.__kv.me.pid;
  });
  ck('egyező verziójú welcome: a vendég megkapja a pid-jét', wOk, 'GUEST-1');

  const wBad = await page.evaluate(() => {
    showScreen('lobby');                                   // legyen honnan visszaesni
    handleMsg({ t: 'welcome', v: 1, you: 'GUEST-2' });      // RÉGI host szimulálása
    return { pid: window.__kv.me.pid, menu: document.getElementById('s-menu').classList.contains('on'),
             toast: document.getElementById('toast').textContent };
  });
  ck('régebbi verziójú host: nem lépünk be, vissza a főmenübe', [wBad.pid, wBad.menu], [null, true]);
  ck('a vendég konkrét frissítési utasítást kap',
     /régebbi verziójú/.test(wBad.toast) && /Ctrl\+F5/.test(wBad.toast), true);

  const wNew = await page.evaluate(() => {
    handleMsg({ t: 'welcome', v: 99, you: 'GUEST-3' });     // ÚJABB host
    return document.getElementById('toast').textContent;
  });
  ck('újabb verziójú host: a vendégnek kell frissítenie', /újabb verziójú/.test(wNew) && /Frissítsd/.test(wNew), true);

  if (sf) { console.error('❌ ' + sf + ' hibás ellenőrzés'); process.exitCode = 1; }

  console.log(errors.length ? 'HIBÁK:\n' + errors.join('\n') : 'KONZOL: tiszta ✔');
  await browser.close();
})().catch(e => { console.error('TESZT HIBA:', e.message); process.exit(1); });
