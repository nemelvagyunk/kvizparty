<!DOCTYPE html>
<html lang="hu">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>KvízParty – többjátékos kvíz</title>
<style>
:root{
  --bg1:#170b34; --bg2:#0e1a3a; --card:rgba(255,255,255,.07); --card2:rgba(255,255,255,.12);
  --txt:#f1f0ff; --dim:#a9a6c9; --acc:#8b5cf6; --acc2:#f472b6; --good:#22c55e; --bad:#ef4444;
  --r1:#e21b3c; --r2:#1368ce; --r3:#d89e00; --r4:#26890c;
}
*{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
html,body{margin:0;padding:0;min-height:100%;}
body{
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
  background:radial-gradient(1200px 800px at 20% -10%, #3b1d6e 0%, transparent 55%),
             radial-gradient(1000px 700px at 110% 110%, #14406b 0%, transparent 55%),
             linear-gradient(160deg,var(--bg1),var(--bg2));
  background-attachment:fixed; color:var(--txt);
  display:flex; flex-direction:column; align-items:center; padding:16px; min-height:100vh;
}
.screen{display:none; width:100%; max-width:680px; animation:fadein .25s ease;}
.screen.on{display:block;}
@keyframes fadein{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.logo{font-size:2.4rem; font-weight:800; text-align:center; margin:18px 0 4px;
  background:linear-gradient(90deg,#a78bfa,#f472b6,#fbbf24); -webkit-background-clip:text; background-clip:text; color:transparent;}
.tagline{text-align:center;color:var(--dim);margin-bottom:18px;font-size:.95rem}
.card{background:var(--card); border:1px solid rgba(255,255,255,.09); border-radius:18px; padding:20px; backdrop-filter:blur(8px);}
label{display:block; font-size:.85rem; color:var(--dim); margin:10px 0 6px;}
input[type=text],input[type=number]{
  width:100%; padding:12px 14px; font-size:1.05rem; border-radius:12px; border:1px solid rgba(255,255,255,.15);
  background:rgba(0,0,0,.25); color:var(--txt); outline:none;
}
input:focus{border-color:var(--acc);}
input[type=number]::-webkit-inner-spin-button,input[type=number]::-webkit-outer-spin-button{-webkit-appearance:none; margin:0;}
input[type=number]{-moz-appearance:textfield;}
.avatars{display:flex; flex-wrap:wrap; gap:8px; margin:8px 0 4px;}
.avatars button{font-size:1.5rem; padding:6px 9px; border-radius:12px; border:2px solid transparent; background:rgba(0,0,0,.22); cursor:pointer;}
.avatars button.sel{border-color:var(--acc); background:rgba(139,92,246,.25);}
.btn{
  display:inline-flex; align-items:center; justify-content:center; gap:8px;
  padding:13px 18px; font-size:1.05rem; font-weight:700; border-radius:14px; border:none; cursor:pointer;
  background:var(--card2); color:var(--txt); transition:transform .06s ease, filter .15s;
  width:100%;
}
.btn:active{transform:scale(.97);}
.btn:hover{filter:brightness(1.15);}
.btn.primary{background:linear-gradient(90deg,#7c3aed,#db2777);}
.btn.ghost{background:rgba(255,255,255,.06); border:1px dashed rgba(255,255,255,.25);}
.btn.small{width:auto; padding:8px 14px; font-size:.9rem;}
.btn:disabled{opacity:.45; cursor:not-allowed;}
.menu-buttons{display:flex; flex-direction:column; gap:12px; margin-top:16px;}
.join-row{display:flex; gap:10px;}
.join-row input{flex:1; text-transform:uppercase; letter-spacing:.35em; font-weight:800; text-align:center;}
.join-row .btn{width:auto; flex:1.2;}
.hint{color:var(--dim); font-size:.85rem; margin-top:12px; text-align:center; line-height:1.5;}
.room-code{ text-align:center; margin-bottom:14px;}
.room-code .code{font-size:2.6rem; font-weight:900; letter-spacing:.45em; padding-left:.45em;
  background:linear-gradient(90deg,#fbbf24,#f472b6); -webkit-background-clip:text; background-clip:text; color:transparent;}
.room-code .lbl{color:var(--dim); font-size:.85rem;}
.players{display:flex; flex-wrap:wrap; gap:10px; margin:14px 0;}
.pchip{display:flex; align-items:center; gap:8px; background:rgba(0,0,0,.28); padding:8px 12px; border-radius:999px; font-weight:600; border:1px solid rgba(255,255,255,.1);}
.pchip .av{font-size:1.3rem;}
.pchip.off{opacity:.4; text-decoration:line-through;}
.pchip .x{cursor:pointer; color:var(--dim); font-weight:900; margin-left:2px;}
.pchip .x:hover{color:var(--bad);}
.settings{display:flex; flex-direction:column; gap:10px; margin:8px 0 14px;}
.setrow{display:flex; align-items:center; gap:10px; flex-wrap:wrap;}
.setrow .lab{color:var(--dim); font-size:.9rem; min-width:120px;}
.seg{display:flex; gap:6px; flex-wrap:wrap;}
.seg button{padding:7px 13px; border-radius:10px; border:1px solid rgba(255,255,255,.14); background:rgba(0,0,0,.22); color:var(--txt); cursor:pointer; font-weight:700;}
.seg button.sel{background:var(--acc); border-color:var(--acc);}
.gtoggle{padding:7px 12px; border-radius:10px; border:1px solid rgba(255,255,255,.14); background:rgba(0,0,0,.22); color:var(--dim); cursor:pointer; font-size:.85rem;}
.gtoggle.sel{background:rgba(139,92,246,.3); color:var(--txt); border-color:var(--acc);}
.diffchip{font-size:.8rem; letter-spacing:.05em;}
.diff1{color:#4ade80;} .diff2{color:#a3e635;} .diff3{color:#fbbf24;} .diff4{color:#fb923c;} .diff5{color:#f87171;}
.lobby-actions{display:flex; flex-direction:column; gap:10px; margin-top:6px;}
/* ---- játékszabályok (FAQ) ---- */
.rules-list{display:flex; flex-direction:column; gap:10px;}
.rules-list details{background:rgba(0,0,0,.25); border:1px solid rgba(255,255,255,.1); border-radius:14px; overflow:hidden;}
.rules-list summary{cursor:pointer; list-style:none; padding:13px 16px; font-weight:800; font-size:1rem; display:flex; align-items:center; gap:10px; line-height:1.3;}
.rules-list summary::-webkit-details-marker{display:none;}
.rules-list summary::after{content:'▾'; margin-left:auto; color:var(--dim); transition:transform .2s; flex-shrink:0;}
.rules-list details[open] summary::after{transform:rotate(180deg);}
.rules-list details[open] summary{color:#fbbf24;}
.rules-body{padding:0 16px 14px; font-size:.92rem; line-height:1.55;}
.rules-body p{margin:8px 0;}
.rules-body b{color:#fbbf24;}
.rules-body .dim{color:var(--dim);}
.rtable{width:100%; border-collapse:collapse; margin:8px 0; font-size:.88rem;}
.rtable th,.rtable td{padding:5px 8px; text-align:center; border-bottom:1px solid rgba(255,255,255,.08);}
.rtable th{color:var(--dim); font-weight:700; font-size:.8rem;}
.rtable td:first-child,.rtable th:first-child{text-align:left;}
/* ---- game ---- */
#g-top{display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:10px;}
#g-count{font-weight:800; color:var(--dim);}
.chip{background:rgba(0,0,0,.3); border:1px solid rgba(255,255,255,.12); padding:6px 12px; border-radius:999px; font-size:.9rem; font-weight:700;}
#g-timer-num{font-weight:900; font-size:1.25rem; min-width:44px; text-align:right;}
#g-timer-num.urgent{color:#f87171; animation:urgNum .9s ease-in-out infinite;}
@keyframes urgNum{0%,100%{transform:scale(1)}50%{transform:scale(1.25); color:#ef4444;}}
#g-timerbar{height:10px; border-radius:99px; background:rgba(0,0,0,.35); overflow:hidden; margin-bottom:16px;}
#g-timerbar.urgent{animation:urgBar .9s ease-in-out infinite;}
@keyframes urgBar{0%,100%{box-shadow:0 0 4px rgba(239,68,68,.2)}50%{box-shadow:0 0 16px rgba(239,68,68,.6)}}
#g-timerfill{height:100%; width:100%; border-radius:99px; background:linear-gradient(90deg,#22c55e,#fbbf24,#ef4444); transition:none;}
#g-final{display:none; text-align:center; font-weight:900; letter-spacing:.1em; font-size:.82rem;
  padding:8px 12px; border-radius:12px; margin:0 0 12px;
  background:linear-gradient(90deg,rgba(251,191,36,.2),rgba(244,114,182,.2));
  border:1px solid rgba(251,191,36,.55); color:#fde68a;}
#g-final.on{display:block; animation:finalGlow 2.4s ease-in-out infinite;}
@keyframes finalGlow{0%,100%{box-shadow:0 0 0 rgba(251,191,36,0)}50%{box-shadow:0 0 18px rgba(251,191,36,.4)}}
.draw{display:flex; flex-direction:column; align-items:center; gap:14px; padding:6px 0 4px;}
.draw-lbl{color:var(--dim); font-size:.9rem; font-weight:700; letter-spacing:.06em;}
.draw-prog{font-size:.98rem; font-weight:700; text-align:center;}
.draw-prog b{color:#fbbf24; font-weight:900;}
.draw-note{color:var(--dim); font-size:.85rem; font-weight:600; text-align:center;}
.draw-note.fin{color:#fde68a; font-weight:800; letter-spacing:.04em;}
.draw-cat{display:flex; flex-direction:column; align-items:center; gap:8px; width:100%;
  padding:20px 16px; border-radius:20px; background:rgba(0,0,0,.3);
  border:2px solid rgba(255,255,255,.12); transition:border-color .2s, box-shadow .3s;}
.draw-cat .ic{font-size:3rem; line-height:1;}
.draw-cat .nm{font-size:1.3rem; font-weight:900; text-align:center; line-height:1.25;}
.draw-cat.spin .ic{animation:drawflip .12s linear infinite;}
.draw-cat.hit{border-color:#fbbf24; box-shadow:0 0 34px rgba(251,191,36,.45); animation:drawpop .45s ease;}
@keyframes drawflip{0%,100%{transform:translateY(0)}50%{transform:translateY(-5px)}}
@keyframes drawpop{0%{transform:scale(.9)}55%{transform:scale(1.05)}100%{transform:scale(1)}}
.draw-type{font-weight:800; font-size:.95rem; color:var(--dim); text-align:center; line-height:1.5;}
.draw-type b{color:#fbbf24;}
.draw-cd{font-size:3.4rem; font-weight:900; line-height:1;
  background:linear-gradient(90deg,#a78bfa,#f472b6,#fbbf24);
  -webkit-background-clip:text; background-clip:text; color:transparent;}
.draw-cd.go{font-size:2rem; letter-spacing:.15em;}
#g-question{font-size:1.35rem; font-weight:800; line-height:1.35; margin:6px 0 18px; min-height:60px;}
.mcgrid{display:grid; grid-template-columns:1fr 1fr; gap:12px;}
@media (max-width:480px){ .mcgrid{grid-template-columns:1fr;} }
.mcbtn{position:relative; border:none; border-radius:14px; padding:18px 14px; font-size:1.05rem; font-weight:700; color:#fff; cursor:pointer; text-align:left; line-height:1.3; min-height:clamp(64px,13vh,120px); transition:transform .06s, filter .2s, opacity .3s;}
.mcbtn:active{transform:scale(.97);}
.mcbtn .shape{margin-right:8px;}
.mcbtn.c0{background:var(--r1);} .mcbtn.c1{background:var(--r2);} .mcbtn.c3{background:var(--r4);}
/* a sárga gombon sötét szöveg – fehérrel ~2:1 kontraszt volt, ez így olvasható */
.mcbtn.c2{background:#eab308; color:#2d2308;}
.mcbtn.dis{pointer-events:none;}
.mcbtn.faded{opacity:.25;}
.mcbtn.sel{outline:3px solid #fff; outline-offset:2px;}
.mcbtn.correct{outline:4px solid #a7f3d0; outline-offset:2px; box-shadow:0 0 22px rgba(34,197,94,.7);}
.mcbtn.wrongsel{outline:4px solid #fecaca; outline-offset:2px; filter:grayscale(.4);}
.mcbtn .picks{position:absolute; right:8px; bottom:6px; font-size:.95rem;}
.tipbox{display:flex; flex-direction:column; gap:12px; align-items:stretch;}
.tiprow{display:flex; gap:10px; align-items:center;}
.tiprow input{flex:1; font-size:1.4rem; font-weight:800; text-align:center;}
.tiprow .unit{color:var(--dim); font-weight:700; min-width:40px;}
.tiprow .btn{width:auto; padding:13px 22px;}
.tipprize{text-align:center; font-size:.88rem; color:var(--dim); font-weight:600; margin-bottom:2px;}
.tipprize b{color:#fbbf24; font-weight:900;}
/* a válaszgombok magassága a képernyőhöz igazodik; mobil 1 oszlopban kisebb lépték */
@media (max-width:480px){ .mcbtn{min-height:clamp(56px,8.5vh,96px);} }
/* nagy képernyőn a játéktér kitölti a helyet: szélesebb konténer, nagyobb betű */
@media (min-width:900px){
  #s-game{max-width:900px;}
  #g-question{font-size:1.8rem; min-height:76px;}
  .mcbtn{font-size:1.18rem;}
  .tiprow input{font-size:1.7rem;}
}
.rrow.second{background:rgba(148,163,184,.16); border:1px solid rgba(203,213,225,.3);}
.sentmsg{text-align:center; font-weight:800; color:#a7f3d0; font-size:1.1rem; margin-top:8px;}
#g-status{display:flex; gap:8px; flex-wrap:wrap; margin-top:18px; justify-content:center;}
.stav{display:flex; flex-direction:column; align-items:center; font-size:.7rem; color:var(--dim); gap:2px; opacity:.45; transition:opacity .2s;}
.stav .em{font-size:1.5rem; filter:grayscale(1);}
.stav.done{opacity:1;} .stav.done .em{filter:none;}
.stav.done .nm::after{content:" ✓"; color:var(--good);}
/* reveal */
#g-reveal{margin-top:18px;}
.revcard{background:rgba(0,0,0,.3); border:1px solid rgba(255,255,255,.12); border-radius:16px; padding:16px;}
.rev-correct{font-size:1.15rem; font-weight:800; margin-bottom:4px;}
.rev-correct b{color:#fbbf24;}
.rev-note{color:var(--dim); font-size:.85rem; margin-bottom:12px;}
.rev-tie{color:#f472b6; font-weight:700; font-size:.9rem; margin:4px 0 8px;}
.rrow{display:flex; align-items:center; gap:8px; padding:7px 10px; border-radius:12px; margin:4px 0; background:rgba(255,255,255,.05); font-size:.98rem;}
.rrow.win{background:rgba(34,197,94,.16); border:1px solid rgba(34,197,94,.4);}
.rrow.me{outline:1px dashed rgba(255,255,255,.35);}
.rrow .av{font-size:1.25rem;}
.rrow .nm{font-weight:700; flex:1 1 auto; min-width:62px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.rrow .val{font-weight:800; white-space:nowrap; flex:0 0 auto;}
.rrow .rk{flex:0 0 auto; font-size:1rem;}
.rrow .tm{color:var(--dim); font-size:.76rem; min-width:38px; text-align:right; flex:0 0 auto;}
.rrow .pts{font-weight:900; color:var(--good); min-width:44px; text-align:right; flex:0 0 auto;}
@media (max-width:405px){
  .rrow{font-size:.88rem; gap:6px; padding:6px 8px;}
  .rrow .av{font-size:1.1rem;}
  .rrow .nm{min-width:46px;}
  .rrow .tm{min-width:30px; font-size:.68rem;}
  .rrow .pts{min-width:38px;}
  .rrow .rk{font-size:.9rem;}
}
.rrow .pts.zero{color:var(--dim); font-weight:600;}
.rrow .pts.neg{color:var(--bad); font-weight:900;}
.rrow .jk{flex:0 0 auto; font-size:.95rem;}
/* joker-sáv */
.jokbar{display:flex; gap:10px; justify-content:center; margin-top:12px;}
.jokbtn{padding:8px 16px; border-radius:999px; border:1px solid rgba(251,191,36,.4); background:rgba(251,191,36,.08);
  color:var(--txt); font-weight:700; font-size:.88rem; cursor:pointer; transition:filter .15s, opacity .2s;}
.jokbtn:hover{filter:brightness(1.25);}
.jokbtn:disabled{opacity:.32; cursor:not-allowed; filter:none;}
.jokmsg{text-align:center; font-weight:800; color:#fde68a; font-size:.9rem; margin-top:8px;}
/* egyszeri figyelemfelhívó pulzálás, amikor a joker-sáv először jelenik meg a meccsben */
.jokbar.intro .jokbtn{animation:jokIntro 1.3s ease .35s 2;}
@keyframes jokIntro{0%,100%{transform:none; box-shadow:none}50%{transform:scale(1.07); box-shadow:0 0 14px rgba(251,191,36,.5)}}
.rrow .strk{font-size:.78rem; font-weight:800; color:#fbbf24; white-space:nowrap;}
.sc .fl{color:#fb923c; font-weight:800; font-size:.8em; margin-left:2px;}
.strk-line{text-align:center; font-weight:800; font-size:.92rem; margin-top:10px; color:#fbbf24;}
.strk-line.broke{color:#fca5a5;}
.strk-scale{display:flex; gap:3px; justify-content:center; flex-wrap:wrap; margin-top:7px;}
.strk-scale span{font-size:.63rem; font-weight:800; padding:2px 5px; border-radius:7px;
  background:rgba(255,255,255,.06); color:var(--dim); letter-spacing:-.02em;}
.strk-scale span.on{background:rgba(251,191,36,.22); color:#fde68a;}
.strk-scale span.now{background:#fbbf24; color:#3b2a05;}
.standings{display:flex; gap:8px; flex-wrap:wrap; margin-top:14px; justify-content:center;}
.sc{display:flex; align-items:center; gap:6px; background:rgba(0,0,0,.35); padding:6px 11px; border-radius:999px; font-weight:800; font-size:.9rem; border:1px solid rgba(255,255,255,.1);}
.sc .s{color:#fbbf24; font-size:1.12em; font-weight:900;}
.nextzone{display:flex; align-items:center; justify-content:center; gap:14px; margin-top:16px; flex-wrap:wrap;}
.countdown{color:var(--dim); font-weight:700;}
/* end */
.podium{display:flex; align-items:flex-end; justify-content:center; gap:14px; margin:24px 0 20px;}
.pod{display:flex; flex-direction:column; align-items:center; gap:6px;}
.pod .em{font-size:2.6rem;}
.pod .nm{font-weight:800; max-width:140px; text-align:center; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.pod .scr{color:#fbbf24; font-weight:900;}
.pod .base{width:86px; border-radius:12px 12px 0 0; background:linear-gradient(180deg,rgba(255,255,255,.25),rgba(255,255,255,.06)); display:flex; align-items:flex-start; justify-content:center; font-size:1.6rem; font-weight:900; padding-top:6px;}
.pod.p1 .base{height:110px; background:linear-gradient(180deg,#fbbf24aa,rgba(255,255,255,.06));}
.pod.p2 .base{height:80px;} .pod.p3 .base{height:58px;}
/* a dobogó oszlopai sorban nőnek fel: 3. → 2. → 1. */
.pod .base{animation:podRise .55s ease backwards; transform-origin:bottom;}
.pod.p3 .base{animation-delay:0s;} .pod.p2 .base{animation-delay:.22s;} .pod.p1 .base{animation-delay:.44s;}
@keyframes podRise{from{transform:scaleY(0)}to{transform:scaleY(1)}}
.endlist{margin-top:8px;}
.end-actions{display:flex; flex-direction:column; gap:10px; margin-top:20px;}
.awards{margin-top:18px; display:flex; flex-direction:column; gap:7px;}
.awards .hd{text-align:center; font-weight:800; font-size:.85rem; color:var(--dim);
  letter-spacing:.1em; text-transform:uppercase; margin-bottom:2px;}
.aw{display:grid; grid-template-columns:auto minmax(0,1fr) auto; gap:1px 11px; align-items:center;
  background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.07);
  border-radius:13px; padding:9px 13px;}
.aw .ic{grid-row:1 / span 2; font-size:1.5rem; line-height:1;}
.aw.wsub .ic{grid-row:1 / span 3;}
.aw .sb{grid-column:2 / span 2; font-size:.75rem; color:var(--dim); margin-top:2px; line-height:1.4;}
.aw .ti{grid-column:2 / span 2; font-size:.75rem; font-weight:700; color:var(--dim); line-height:1.3;}
.aw .wh{font-weight:800; font-size:.96rem; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;}
.aw .vl{font-weight:900; color:#fbbf24; white-space:nowrap; font-size:.95rem;}
#toast{position:fixed; top:14px; left:50%; transform:translateX(-50%); background:#1f2937; color:#fff; border:1px solid rgba(255,255,255,.2);
  padding:12px 20px; border-radius:14px; font-weight:700; opacity:0; pointer-events:none; transition:opacity .25s; z-index:99; max-width:90vw; text-align:center;}
#toast.on{opacity:1;}
/* némítás gomb – minden képernyőn elérhető, diszkrét sarok-gomb */
#snd-btn{position:fixed; right:12px; bottom:12px; z-index:90; width:42px; height:42px; border-radius:50%;
  border:1px solid rgba(255,255,255,.18); background:rgba(12,9,32,.6); backdrop-filter:blur(6px);
  font-size:1.1rem; line-height:1; cursor:pointer; opacity:.7; transition:opacity .15s, filter .15s; padding:0;}
#snd-btn:hover{opacity:1;}
#snd-btn.off{opacity:.4; filter:grayscale(1);}
.conn-note{color:var(--dim); text-align:center; font-size:.8rem; margin-top:22px; line-height:1.5;}
/* verziójelző: együtt kell játszani tudni – ha két eszközön más szám van, frissíteni kell */
.ver{display:inline-block; margin-top:6px; opacity:.55; font-size:.72rem; letter-spacing:.04em;}
/* ---- HÓDÍTÁS mód – „Frontvonal” téma (neon HUD) ---- */
:root{ --n1:#ff2e63; --n2:#00e5ff; --nAcc:#ffcc33; --nDim:#4a5b7d; --nGrid:#131d33; }
#cq-wrap{display:none; margin-bottom:12px;}
#cq-wrap.on{display:block;}
#cq-banner{display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); align-items:center; gap:7px 8px; margin-bottom:9px;}
#cq-banner>*{min-width:0;}
#cq-banner .cq-phase{grid-column:1 / -1;}
#cq-banner .cq-team:last-child{justify-self:end;}
.cq-team{display:inline-flex; align-items:center; gap:7px; max-width:100%; white-space:nowrap;
  font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-weight:700; font-size:.8rem;
  letter-spacing:.04em; padding:6px 11px; background:rgba(255,255,255,.03); border:1px solid;
  clip-path:polygon(9px 0,100% 0,100% calc(100% - 9px),calc(100% - 9px) 100%,0 100%,0 9px);}
.cq-team .nmx{overflow:hidden; text-overflow:ellipsis; white-space:nowrap; min-width:0; text-transform:uppercase;}
.cq-team .tot{flex:0 0 auto; color:#fff; font-weight:800;}
.cq-team.t1{border-color:var(--n1); color:#ffb3c8; box-shadow:inset 0 0 12px rgba(255,46,99,.26);}
.cq-team.t2{border-color:var(--n2); color:#a8f0ff; box-shadow:inset 0 0 12px rgba(0,229,255,.22);}
.cq-team.act{background:rgba(255,204,51,.09); border-color:var(--nAcc); color:#ffe9a8;}
.cq-team .pips{display:inline-flex; gap:3px; flex:0 0 auto;}
.cq-team .pip{width:9px; height:9px; transform:rotate(45deg); border:1px solid;}
.cq-team.t1 .pip{border-color:var(--n1); background:var(--n1); box-shadow:0 0 6px var(--n1);}
.cq-team.t2 .pip{border-color:var(--n2); background:var(--n2); box-shadow:0 0 6px var(--n2);}
.cq-phase{font-family:ui-monospace,Menlo,Consolas,monospace; font-weight:700; font-size:.72rem;
  color:var(--nDim); letter-spacing:.2em; text-align:center; white-space:nowrap; text-transform:uppercase;}
@media (max-width:430px){ .cq-team{font-size:.72rem; padding:5px 8px; gap:5px;} .cq-phase{font-size:.65rem; letter-spacing:.14em;} }
.cqsvg{width:100%; height:auto; display:block; background:#05070f; border:1px solid #1b2a44; border-radius:14px;}
.cqsvg text{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace; font-weight:700;
  text-anchor:middle; dominant-baseline:central; pointer-events:none;}
.cqsvg .lnk{stroke:#22304d; stroke-width:2;}
.cqsvg .lnk.t1{stroke:var(--n1); stroke-width:2.6; opacity:.85;}
.cqsvg .lnk.t2{stroke:var(--n2); stroke-width:2.6; opacity:.85;}
.cqsvg .nd{fill:#0b0f1c; stroke:var(--nDim); stroke-width:1.6;}
.cqsvg .nd.t1{fill:#0a1120; stroke:var(--n1); stroke-width:2.8;}
.cqsvg .nd.t2{fill:#0a1120; stroke:var(--n2); stroke-width:2.8;}
.cqsvg .cas{fill:#080d1a; stroke-width:3;}
.cqsvg .cas.t1{stroke:var(--n1);} .cqsvg .cas.t2{stroke:var(--n2);}
.cqsvg .casin{fill:none; stroke-width:1; opacity:.45;}
.cqsvg .casin.t1{stroke:var(--n1);} .cqsvg .casin.t2{stroke:var(--n2);}
.cqsvg .pip.t1{fill:var(--n1); stroke:var(--n1);} .cqsvg .pip.t2{fill:var(--n2); stroke:var(--n2);}
.cqsvg .pip{stroke-width:2; stroke-linejoin:round;}
.cqsvg .vv{font-size:19px; fill:#fff;}
.cqsvg .cval{font-size:20px; fill:#fff;}
.cqsvg .idn{font-size:14px; fill:#6d84ad;}
.cqsvg .cap{font-size:11px; fill:#3d5478; letter-spacing:3px; dominant-baseline:auto; text-anchor:start;}
.cqsvg .hit{cursor:pointer;}
.cqsvg .glow{filter:url(#cqGlow);}
.cqsvg .sel-ring{fill:none; stroke:var(--nAcc); stroke-width:2.6; animation:cqpulse 1.25s ease-in-out infinite;}
@keyframes cqpulse{0%,100%{opacity:1}50%{opacity:.22}}
.cqsvg .mark1{fill:none; stroke:var(--n1); stroke-width:2.2; stroke-dasharray:6 6;}
.cqsvg .mark2{fill:none; stroke:var(--n2); stroke-width:2.2; stroke-dasharray:6 6;}
.cqsvg .tgt{fill:none; stroke:var(--nAcc); stroke-width:2.2; stroke-dasharray:12 9;}
.cqsvg .brk{fill:none; stroke:var(--nAcc); stroke-width:2.4;}
.cq-log{text-align:center; color:#7d90b5; font-size:.85rem; margin-top:9px; min-height:20px; line-height:1.45;}
.cq-hint{text-align:center; font-weight:700; margin-top:10px; line-height:1.5;}
.cq-hint.wait{color:var(--dim); font-weight:600;}
.cq-tag{display:inline-block; padding:2px 9px; font-size:.72rem; font-weight:800; margin-left:6px;
  font-family:ui-monospace,Menlo,Consolas,monospace; letter-spacing:.06em; border:1px solid;
  clip-path:polygon(5px 0,100% 0,100% calc(100% - 5px),calc(100% - 5px) 100%,0 100%,0 5px);}
.cq-tag.t1{border-color:var(--n1); color:#ffb3c8; background:rgba(255,46,99,.12);}
.cq-tag.t2{border-color:var(--n2); color:#a8f0ff; background:rgba(0,229,255,.1);}
.cq-deltas{display:flex; flex-direction:column; gap:5px; margin:10px 0 2px;}
.cq-delta{display:flex; align-items:center; gap:8px; padding:8px 12px; font-size:.92rem; font-weight:600;
  background:rgba(255,255,255,.04); border-left:3px solid #2b3a58; border-radius:0 10px 10px 0;}
.cq-delta.good{background:rgba(0,229,255,.09); border-left-color:var(--n2);}
.cq-delta.bad{background:rgba(255,46,99,.09); border-left-color:var(--n1);}
.cq-final{display:flex; gap:12px; justify-content:center; margin:14px 0 6px; flex-wrap:wrap;}
.cq-fcard{flex:1; min-width:150px; text-align:center; padding:16px 10px; background:rgba(255,255,255,.03);
  border:1px solid; clip-path:polygon(14px 0,100% 0,100% calc(100% - 14px),calc(100% - 14px) 100%,0 100%,0 14px);}
.cq-fcard.t1{border-color:var(--n1); box-shadow:inset 0 0 22px rgba(255,46,99,.14);}
.cq-fcard.t2{border-color:var(--n2); box-shadow:inset 0 0 22px rgba(0,229,255,.12);}
.cq-fcard.win{box-shadow:inset 0 0 22px rgba(255,204,51,.18), 0 0 24px rgba(255,204,51,.35);}
.cq-fcard .big{font-size:2rem; font-weight:900; color:#fff;
  font-family:ui-monospace,Menlo,Consolas,monospace; letter-spacing:.03em;}
.cq-fcard .sub{color:var(--nDim); font-size:.78rem; margin-top:5px;
  font-family:ui-monospace,Menlo,Consolas,monospace;}
.spinner{display:inline-block; width:14px; height:14px; border:2px solid rgba(255,255,255,.3); border-top-color:#fff; border-radius:50%; animation:spin .8s linear infinite; vertical-align:-2px; margin-right:6px;}
@keyframes spin{to{transform:rotate(360deg)}}
</style>
</head>
<body>

<div id="toast"></div>
<button id="snd-btn" title="Hangok ki/be">🔊</button>

<!-- ================= FŐMENÜ ================= -->
<div class="screen on" id="s-menu">
  <div class="logo">🎉 KvízParty</div>
  <div class="tagline">2–6 fős kvízparti · 23 kategória · 1333 kérdés · 5 nehézségi szint · AI-ellenféllel is</div>
  <div class="card">
    <label>Játékosnév</label>
    <input type="text" id="inp-name" maxlength="14" placeholder="Add meg a neved…">
    <label>Válassz karaktert</label>
    <div class="avatars" id="avatars"></div>
    <div class="menu-buttons">
      <button class="btn primary" id="btn-create">🏠 Szoba létrehozása</button>
      <div class="join-row">
        <input type="text" id="inp-code" maxlength="4" placeholder="KÓD" autocomplete="off">
        <button class="btn" id="btn-join">🔗 Csatlakozás</button>
      </div>
      <button class="btn ghost" id="btn-solo">🤖 Szóló játék AI ellen</button>
      <button class="btn ghost" id="btn-rules">📖 Játékszabályok</button>
    </div>
  </div>
  <div class="conn-note">Az online játékhoz internet kell: a szobát nyitó játékos kódot kap,<br>a többiek ezzel csatlakoznak – bárhonnan, saját eszközről.
    <br><span id="ver-note" class="ver"></span></div>
</div>

<!-- ================= JÁTÉKSZABÁLYOK ================= -->
<div class="screen" id="s-rules">
  <div class="logo" style="font-size:1.8rem">📖 Játékszabályok</div>
  <div class="tagline">Kattints egy kérdésre a válaszért!</div>
  <div class="card">
    <div class="rules-list">

      <details>
        <summary>🎮 Hogyan indul egy játék?</summary>
        <div class="rules-body">
          <p>A KvízParty <b>2–6 fős</b> kvízparti. Egy játékos szobát nyit (🏠), és kap egy 4 jegyű kódot – a többiek ezzel csatlakoznak (🔗), mindenki a saját eszközéről. Egyedül is játszhatsz AI-ellenfelek ellen (🤖).</p>
          <p>A szobát nyitó játékos (a host) állítja be a játékmódot, a kérdésszámot és a tempót, és ő adhat a meccshez AI-játékosokat is – emberrel és robottal együtt legfeljebb 6 fő lehet.</p>
          <p class="dim">Ha nagyon ritkán nem jön létre a kapcsolat (szigorú céges/iskolai hálózaton fordulhat elő), mobilnetről vagy telefonos hotspotról szinte mindig működik.</p>
          <p class="dim">Ha valaki „eltérő játékverzió" üzenetet kap, az az eszköz a játék régebbi, elmentett változatát futtatja: elég frissíteni az oldalt (Ctrl+F5, mobilon húzd le a lapot). A főoldal alján mindenki látja a saját <b>játékverzióját</b> – együtt játszani csak azonos számmal lehet.</p>
        </div>
      </details>

      <details>
        <summary>🃏 Milyen kérdéstípusok vannak?</summary>
        <div class="rules-body">
          <p><b>Kérdés-válasz:</b> négy lehetőség, egy helyes – <b>20 másodperc</b> alatt kell választani.</p>
          <p><b>Tippelős:</b> egy számot kell megtippelni (évszám, mennyiség…) <b>25 másodperc</b> alatt. A legközelebbi tipp nyer, egyenlőségnél a gyorsabb. A tippet vesszővel is beírhatod, de a megoldás mindig egész szám.</p>
          <p>Minden kérdés előtt <b>kategória-sorsolás</b> jön: látod, milyen téma, milyen típus és hány pont következik, plusz hogy hányadik kérdésnél jártok és mennyi van hátra a 🎬 fináléig. A kérdés <b>🐢 Nyugodt tempónál 10, ⚡ Pörgős tempónál 4 másodperc</b> múlva indul (a lobbyban állítható) – a host korábban is elindíthatja.</p>
        </div>
      </details>

      <details>
        <summary>🗂️ Hogyan épül fel egy meccs?</summary>
        <div class="rules-body">
          <p>A klasszikus meccs blokkokban halad: először a <b>Kérdés-válasz</b> kártyák, aztán a <b>tippelős</b> kérdések, végül a <b>🎬 dupla pontos finálé</b>:</p>
          <table class="rtable">
            <tr><th>Kérdésszám</th><th>Kérdés-válasz</th><th>Tippelős</th><th>🎬 Finálé</th></tr>
            <tr><td>10</td><td>5</td><td>3</td><td>1 + 1 tipp</td></tr>
            <tr><td>15</td><td>7</td><td>5</td><td>2 + 1 tipp</td></tr>
            <tr><td>20</td><td>10</td><td>6</td><td>2 + 2 tipp</td></tr>
            <tr><td>30</td><td>14</td><td>10</td><td>4 + 2 tipp</td></tr>
          </table>
          <p>A kérdések <b>23 kategóriából</b> jönnek, sorsolással – minden kategória sorra kerül, mielőtt bármelyik ismétlődne. A tippelős kérdéseknek saját, 9 tételes sorsolása van.</p>
        </div>
      </details>

      <details>
        <summary>💰 Hogyan működik a pontozás?</summary>
        <div class="rules-body">
          <p>Minden kérdés a nehézsége szerint ér pontot:</p>
          <table class="rtable">
            <tr><th>Nehézség</th><td>★</td><td>★★</td><td>★★★</td><td>★★★★</td><td>★★★★★</td></tr>
            <tr><th>Pont</th><td>75</td><td>90</td><td>100</td><td>110</td><td>125</td></tr>
          </table>
          <p>Kérdés-válasznál <b>minden helyes válaszoló</b> megkapja a kérdés értékét, plusz gyorsasági bónuszt: minél hamarabb válaszolsz, annál többet, legfeljebb <b>+20%</b>-ot.</p>
        </div>
      </details>

      <details>
        <summary>🔥 Mi az a sorozat-bónusz?</summary>
        <div class="rules-body">
          <p>Ha a Kérdés-válasz kártyákon egymás után többször helyesen válaszolsz, szorzót kapsz a pontjaidra:</p>
          <table class="rtable">
            <tr><th>Egymás utáni helyes</th><td>1.</td><td>2.</td><td>3.</td><td>4.</td><td>5.</td><td>6.+</td></tr>
            <tr><th>Szorzó</th><td>1×</td><td>1×</td><td><b>1,3×</b></td><td><b>1,5×</b></td><td><b>1,7×</b></td><td><b>1,9×</b></td></tr>
          </table>
          <p>Rossz válasz (vagy lecsúszott idő) megszakítja a sorozatot. A <b>tippelős kérdések semlegesek</b>: nem törik meg és nem is növelik. A 🎬 fináléban nincs sorozat-szorzó – ott a dupla érték számít.</p>
        </div>
      </details>

      <details>
        <summary>🎯 Hogyan pontoz a tippelős?</summary>
        <div class="rules-body">
          <p>A legjobb tipp viszi a pontot – és minél többen játszotok, annál többet ér a győzelem:</p>
          <table class="rtable">
            <tr><th>Játékosok</th><td>2</td><td>3</td><td>4</td><td>5</td><td>6</td></tr>
            <tr><th>Nyertes szorzója</th><td>1×</td><td>1,25×</td><td>1,5×</td><td>1,75×</td><td>2×</td></tr>
          </table>
          <p>A <b>második legjobb tipp</b> is érhet pontot: 3 játékosnál a kérdés alapértékének <b>40%-át</b>, négy vagy több játékosnál a <b>teljes alapértéket</b> (a 🎬 fináléban ezek is duplázódnak). A <b>telitalálat +25%</b> bónuszt kap. Holtversenynél a gyorsabb tipp nyer.</p>
        </div>
      </details>

      <details>
        <summary>🎬 Mi a dupla pontos finálé?</summary>
        <div class="rules-body">
          <p>A meccs végén minden kérdés <b>dupla pontot</b> ér – a kérdésnél kiírt érték már a duplázott. A fináléban nincs sorozat-szorzó, és <b>joker kártyát sem lehet használni</b> – itt már csak a tudás dönt.</p>
        </div>
      </details>

      <details>
        <summary>✂️🎲 Milyen jokerek járnak a Kérdés-válaszhoz?</summary>
        <div class="rules-body">
          <p>Minden játékosnak meccsenként <b>2 joker kártyája</b> van a Kérdés-válasz szakaszra – egy körben csak az egyiket használhatod:</p>
          <p><b>✂️ Felezés:</b> két rossz válaszlehetőség eltűnik. Ha az utolsó normál Kérdés-válasz kártyáig nem használtad el, ott <b>automatikusan aktiválódik</b> – ez a joker nem veszhet kárba.</p>
          <p><b>🎲 Dupla vagy semmi:</b> a kérdés alapértékét megduplázza (a sorozat-szorzót nem veszi figyelembe). De vigyázz: rossz válasznál vagy válasz nélkül a kérdés értékét <b>elveszíted</b> – a pontszámod akár mínuszba is fordulhat! Ezt nem kötelező elhasználni.</p>
          <p class="dim">A jokerek csak a normál Kérdés-válasz blokkban élnek, a tippelős kérdéseken és a fináléban nem.</p>
        </div>
      </details>

      <details>
        <summary>🔢 Milyen jokerek járnak a tippelőshöz?</summary>
        <div class="rules-body">
          <p>A tippelős kérdésekhez két segítő kártya jár, de meccsenként <b>csak az egyiket</b> használhatod fel:</p>
          <p><b>🔢 Első számjegy:</b> megmutatja a megoldás első számjegyét (pl. 1956 → <b>1</b>).</p>
          <p><b>🔢 Utolsó számjegy:</b> az utolsót (1956 → <b>6</b>).</p>
          <p>Ha a megoldás egyjegyű, a kártya a teljes megoldást mutatja – de ezt te nem tudhatod biztosan… 😉 A finálé dupla tippjein nem használható.</p>
        </div>
      </details>

      <details>
        <summary>🤖 Milyenek az AI-ellenfelek?</summary>
        <div class="rules-body">
          <p>Három szint közül választhatsz: <b>🤖 Robo Róbert</b> (nagyon okos) · <b>⚙️ Masina Misi</b> (közepes) · <b>🤪 Félnótás Fábián</b> (bájosan kapkodó).</p>
          <p>A robotok szándékosan lassabbak nálad: sosem kapnak gyorsasági bónuszt, és minden holtversenyt elveszítenek az emberrel szemben – a tudásuk ellen kell nyerni, nem a reflexeik ellen. Tippelősben ők is emberien hibáznak: időnként jó nagyot mellélőnek.</p>
        </div>
      </details>

      <details>
        <summary>⚔️ Mi az a Hódítás mód?</summary>
        <div class="rules-body">
          <p>Két játékos térképes párbaja (ember vagy AI ellen), két választható pályán. Két szakasza van:</p>
          <p><b>Foglalás:</b> felváltva jelöltök területet, és kérdésekkel szerzitek meg – Kérdés-válasznál mindkét helyes válaszoló foglal, tippelősnél csak a győztes.</p>
          <p><b>Harc:</b> felváltva támadjátok egymás területeit. Ha mindketten tudjátok a választ, tippelős döntő jön. Sikeres támadásnál a terület gazdát cserél és <b>+25 ponttal</b> erősödik (legfeljebb 150-ig); ha a védő állja a sarat, a vára <b>+50 pontot</b> kap. A várakat nem lehet megtámadni.</p>
          <p>A végén a vár és a birtokolt területek összértéke dönt.</p>
        </div>
      </details>

      <details>
        <summary>🏆 Milyen díjak vannak a meccs végén?</summary>
        <div class="rules-body">
          <p>A klasszikus meccs végén díjátadó vár: <b>⚡ Leggyorsabb helyes válasz</b> · <b>🎯 Leggyorsabb nyerő tipp</b> · <b>🔥 Leghosszabb sorozat</b> · <b>💯 Legtöbb telitalálat</b> – és két kevésbé hízelgő is: <b>🤦 Leggyorsabb rossz válasz</b> és <b>🙈 Legnagyobb melléfogás</b>, a hozzájuk tartozó kérdéssel együtt. 😄</p>
        </div>
      </details>

    </div>
    <button class="btn primary" id="btn-rules-back" style="margin-top:16px">← Vissza a főoldalra</button>
  </div>
</div>

<!-- ================= LOBBY ================= -->
<div class="screen" id="s-lobby">
  <div class="logo" style="font-size:1.6rem">🎉 KvízParty</div>
  <div class="card">
    <div class="room-code" id="lobby-code"></div>
    <div class="players" id="lobby-players"></div>
    <div id="lobby-settings"></div>
    <div class="lobby-actions" id="lobby-actions"></div>
    <div class="hint" id="lobby-hint"></div>
  </div>
</div>

<!-- ================= JÁTÉK ================= -->
<div class="screen" id="s-game">
  <div id="cq-wrap">
    <div id="cq-banner"></div>
    <div id="cq-map"></div>
    <div class="cq-log" id="cq-log"></div>
  </div>
  <div id="g-top">
    <span id="g-count"></span>
    <span class="chip" id="g-cat"></span>
    <span class="chip diffchip" id="g-diff"></span>
    <span id="g-timer-num"></span>
  </div>
  <div id="g-timerbar"><div id="g-timerfill"></div></div>
  <div id="g-final"></div>
  <div id="g-question"></div>
  <div id="g-answers"></div>
  <div id="g-status"></div>
  <div id="g-reveal"></div>
</div>

<!-- ================= VÉGE ================= -->
<div class="screen" id="s-end">
  <div class="logo" style="font-size:1.8rem">🏆 Végeredmény</div>
  <div class="card">
    <div class="podium" id="podium"></div>
    <div class="endlist" id="end-list"></div>
    <div class="end-actions" id="end-actions"></div>
