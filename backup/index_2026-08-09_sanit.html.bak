function cqM(){ return CQ_MAPS[(cqState&&cqState.map)||'big']; }

/* A feltett kérdések MUNKAMENET-szintű memóriája: túléli a főmenübe kilépést és az
   új játékokat is, így nem térnek vissza ugyanazok a kérdések. Csak az oldal
   újratöltése törli (localStorage tilos az artifact-kompatibilitás miatt). */
const SESSION_USED = new Set();
const $ = id=>document.getElementById(id);
function shuffle(a){a=a.slice();for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]];}return a;}
function gauss(){let u=0,v=0;while(!u)u=Math.random();while(!v)v=Math.random();return Math.sqrt(-2*Math.log(u))*Math.cos(2*Math.PI*v);}
function esc(s){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));}
function fmtNum(n){ if(!isFinite(n))return '–'; return Number(n).toLocaleString('hu-HU'); }
let toastT=null;
function toast(msg,ms){ const t=$('toast'); t.textContent=msg; t.classList.add('on'); clearTimeout(toastT); toastT=setTimeout(()=>t.classList.remove('on'), ms||3200); }
function showScreen(name){ document.querySelectorAll('.screen').forEach(s=>s.classList.remove('on')); $('s-'+name).classList.add('on'); }

/* ============================================================
   HANGOK – WebAudio, asset nélkül (minden hang szintetizált)
   Az AudioContext csak felhasználói gesztusra jön létre (mobil-szabály);
   a boot() köt egy pointerdown/keydown "ébresztőt". Minden hívás
   try/catch mögött van: ha nincs hang, a játék némán megy tovább.
   ============================================================ */
const SND = { on:true, ctx:null, master:null, lastTick:-1, fanfared:false };
function sndInit(){
  if(SND.ctx) return;
  try{
    const AC=window.AudioContext||window.webkitAudioContext;
    if(!AC) return;
    SND.ctx=new AC();
    SND.master=SND.ctx.createGain();
    SND.master.gain.value=0.55;
    SND.master.connect(SND.ctx.destination);
  }catch(e){ SND.ctx=null; }
}
function sndResume(){ try{ if(SND.ctx&&SND.ctx.state==='suspended') SND.ctx.resume(); }catch(e){} }
/* egy hangjegy: f frekvencia, t0 késleltetés (mp), dur hossz, opciók: type/g(hangerő)/to(csúszás) */
function tone(f,t0,dur,o){
  if(!SND.ctx) return;
  o=o||{};
  try{
    const c=SND.ctx, osc=c.createOscillator(), v=c.createGain(), at=c.currentTime+t0;
    osc.type=o.type||'triangle';
    osc.frequency.setValueAtTime(f,at);
    if(o.to) osc.frequency.exponentialRampToValueAtTime(o.to,at+dur);
    v.gain.setValueAtTime(0.0001,at);
    v.gain.exponentialRampToValueAtTime(o.g||0.12,at+0.012);
    v.gain.exponentialRampToValueAtTime(0.0001,at+dur);
    osc.connect(v); v.connect(SND.master);
    osc.start(at); osc.stop(at+dur+0.05);
  }catch(e){}
}
function play(name){
  if(!SND.on||!SND.ctx) return;
  sndResume();
  const S={
    tick:   ()=>tone(1150,0,.04,{type:'square',g:.05}),                       // óra-ketyegés (utolsó 5 mp)
    spin:   ()=>tone(500+Math.random()*300,0,.03,{type:'square',g:.035}),     // sorsolás-pörgés kattogása
    land:   ()=>{ tone(740,0,.12,{g:.1}); tone(1108,.09,.2,{g:.12}); },       // a kategória "beesik"
    q:      ()=>tone(520,0,.1,{g:.07,to:660}),                                // új kérdés
    send:   ()=>tone(600,0,.06,{type:'square',g:.06,to:800}),                 // válasz elküldve
    good:   ()=>{ [523,659,784].forEach((f,i)=>tone(f,i*.09,.16,{g:.13})); tone(1046,.28,.3,{g:.1}); },
    small:  ()=>{ tone(523,0,.12,{g:.1}); tone(659,.1,.2,{g:.1}); },          // 2. hely
    bad:    ()=>{ tone(311,0,.2,{type:'sawtooth',g:.08,to:220}); tone(233,.18,.3,{type:'sawtooth',g:.07,to:180}); },
    meh:    ()=>tone(330,0,.15,{g:.05}),                                      // semleges (nem nyertél, nem hibáztál)
    joker:  ()=>{ [1046,1318,1568,2093].forEach((f,i)=>tone(f,i*.06,.12,{g:.07})); },
    turn:   ()=>{ tone(740,0,.12,{g:.09}); tone(740,.18,.12,{g:.09}); },      // hódítás: te jössz
    fanfare:()=>{ [392,523,659].forEach((f,i)=>tone(f,i*.12,.18,{type:'sawtooth',g:.07}));
                  [523,659,784].forEach(f=>tone(f,.4,.5,{type:'sawtooth',g:.06})); },   // finálé kezdete
    win:    ()=>{ [523,659,784,1046].forEach((f,i)=>tone(f,i*.13,.22,{type:'sawtooth',g:.06}));
                  [523,659,784,1046].forEach(f=>tone(f,.6,.7,{type:'sawtooth',g:.05}));
                  [659,784,1046].forEach(f=>tone(f,1.35,.45,{g:.05})); },      // győzelmi fanfár a végén
  }[name];
  if(S) try{ S(); }catch(e){}
}

/* ---------------- globális állapot ---------------- */
let me = {pid:null, name:'', avatar:AVATARS[0], isHost:false};
let myJok = {fifty:true, double:true, tip:true};   // a saját joker-készletem (a host validál)
let jokIntro = true;   // a joker-sáv egyszeri figyelemfelhívó pulzálása meccsenként
let net = {mode:null, peer:null, conn:null, conns:{}, code:null};  // mode: host | guest | solo
let host = null;          // csak hostnál / szólónál
let lastPlayers = [];     // legutóbb ismert játékoslista (render alap)
let view = {qi:-1,type:null,dur:0,qStart:0,answered:false,total:0,raf:0,locked:false,revealShown:false,cdT:null};
/* belső állapot elérése automatizált tesztekhez */
window.__kv = { get host(){return host}, set host(v){host=v}, get me(){return me}, set me(v){me=v},
                get cq(){return cqState}, set cq(v){cqState=v}, get proto(){return MY_PROTO} };

/* ---------------- hálózat ---------------- */
/* PROTOKOLL-VERZIÓ. A vendég a `hello`-ban, a host a `welcome`/`lobby`-ban küldi.
   Eltérésnél a csatlakozás udvariasan elutasításra kerül – a néma inkompatibilitás
   (pl. egy mező JELENTÉSÉNEK megváltozása) rossz pontozáshoz és követhetetlen
   hibákhoz vezetne. A GitHub Pages cache-el, ezért két játékos könnyen fut más buildet.
   BUMPOLD, ha bármelyik hálózati üzenet szerkezete vagy egy mező jelentése változik!
   Verziótörténet: 1 = verziószám előtti buildek · 2 = 2026-08-09, a verziókezelés bevezetése. */
const PROTO = 2;
/* Teszt/hibakereső hook: #pv=<szám> – a kliens ennyinek vallja magát, ÉS ezt várja el a
   másik oldaltól. Így egy régi (vagy újabb) build viselkedése szimulálható. Élesben
   sosem szerepel a hash-ben, és nem ad semmilyen előnyt: eltérésnél épp hogy kizár. */
const MY_PROTO = (function(){ const m=location.hash.match(/pv=(\d+)/); return m?+m[1]:PROTO; })();
const CODE_ABC="ABCDEFGHJKLMNPQRSTUVWXYZ23456789";
function genCode(){let s="";for(let i=0;i<4;i++)s+=CODE_ABC[Math.floor(Math.random()*CODE_ABC.length)];return s;}
function peerId(code){return 'kvparty-hu-'+code;}
/* Teszt/haladó hook: #srv=host:port használatával saját PeerJS szerverre köt a felhő helyett */
function peerOpts(){
  const m=location.hash.match(/srv=([^&#]+)/);
  if(m){ const parts=m[1].split(':'); return {host:parts[0], port:+(parts[1]||9000), path:'/', key:'peerjs'}; }
  return {};
}

function destroyNet(){
  /* FONTOS a sorrend: előbb ürítjük a `net`-et, és csak utána bontjuk a peert.
     A `peer.destroy()` szinkron kiváltja a conn 'close' eseményét, és ha a `net.mode`
     még 'guest' lenne, a generikus „A kapcsolat megszakadt" felülírná a valódi okot
     (verzió-eltérés, kitiltás, tele szoba). */
  const p=net.peer;
  net={mode:null,peer:null,conn:null,conns:{},code:null};
  try{ if(p) p.destroy(); }catch(e){}
}
function resetAll(){
  stopTimers(); clearHostTimers();
  destroyNet(); host=null; lastPlayers=[];
  cqState=null; $('cq-wrap').classList.remove('on');
  me.pid=null; me.isHost=false;
  showScreen('menu');
}
function stopTimers(){ cancelAnimationFrame(view.raf); clearInterval(view.cdT); view.cdT=null; }
/* az utolsó 5 másodperc jelzése: piros pulzáló szám + izzó sáv + ketyegés */
function timerUrgency(rem){
  const on=rem>0&&rem<=5000;
  $('g-timer-num').classList.toggle('urgent',on);
  $('g-timerbar').classList.toggle('urgent',on);
  if(on){
    const s=Math.ceil(rem/1000);
    if(s!==SND.lastTick){ SND.lastTick=s; play('tick'); }
  } else SND.lastTick=-1;
}
function clearHostTimers(){
  if(!host) return;
  clearTimeout(host.qDeadlineT); clearTimeout(host.autoNextT); clearTimeout(host.catT);
  (host.aiTimers||[]).forEach(clearTimeout); host.aiTimers=[];
  if(host.cq){ clearTimeout(host.cq.pickT); clearTimeout(host.cq.aiT); clearTimeout(host.cq.nextT); }
}

/* Üzenet minden kliensnek (host) + saját képernyő frissítése */
function hostBroadcast(msg){
  for(const pid in net.conns){ try{ net.conns[pid].send(msg); }catch(e){} }
  handleMsg(msg);
}
/* Privát üzenet EGY játékosnak (pl. joker-visszaigazolás) – a host saját magának is */
function sendTo(pid,msg){
  if(pid===me.pid){ handleMsg(msg); return; }
  try{ net.conns[pid].send(msg); }catch(e){}
}
function sendToHost(msg){ try{ net.conn.send(msg); }catch(e){} }

/* ---------------- host: szoba ---------------- */
function makeHost(solo){
  return { solo, players:[], settings:{count:15, mode:'classic', mapKey:'big', tempo:'calm'},
    cq:null, cqPool:{mc:[],tip:[]}, stats:{}, jokers:{}, qJok:{}, sMcLen:0,
    phase:'lobby', deck:[], qi:-1, answers:{}, qData:null, qCorrectIndex:0, qDur:0,
    qDeadlineT:null, autoNextT:null, aiTimers:[], usedIds:SESSION_USED };
}
function playersMin(){ return host.players.map(p=>({pid:p.pid,name:p.name,avatar:p.avatar,isAI:!!p.isAI,isHost:!!p.isHost,connected:p.connected!==false,score:p.score||0,streak:p.streak||0,best:p.best||0})); }
function hostLobbyMsg(){
  return {t:'lobby', v:MY_PROTO, code:net.code, solo:host.solo, players:playersMin(),
    settings:{...host.settings}, phase:host.phase};
}
function hostAddAI(tier){
  if(host.players.length>=MAXP){ toast('A szoba megtelt (max 6 játékos)'); return; }
  const ti=Math.max(0,Math.min(AI_TIERS.length-1, Number(tier)||0)), t=AI_TIERS[ti];
  let name=t.name, n=1;
  while(host.players.some(p=>p.name===name)) name=t.name+' '+(++n);
  const used=host.players.filter(p=>p.isAI).length;
  host.players.push({pid:'AI'+(used+1)+'-'+Math.floor(Math.random()*9999), name, avatar:t.avatar,
                     isAI:true, ai:ti, connected:true, score:0});
  hostBroadcast(hostLobbyMsg());
}
function hostRemovePlayer(pid){
  const i=host.players.findIndex(p=>p.pid===pid);
  if(i<0) return;
  const p=host.players[i];
  if(!p.isAI && net.conns[pid]){ try{net.conns[pid].send({t:'kicked'}); net.conns[pid].close();}catch(e){} delete net.conns[pid]; }
  host.players.splice(i,1);
  hostBroadcast(hostLobbyMsg());
}

function createRoom(){
  if(!requireName()) return;
  me.isHost=true; me.pid='H';
  net.mode='host'; net.code=genCode();
  host=makeHost(false);
  host.players.push({pid:'H', name:me.name, avatar:me.avatar, isHost:true, connected:true, score:0});
  toast('Szoba nyitása…',6000);
  let tries=0;
  const tryOpen=()=>{
    const p=new Peer(peerId(net.code), peerOpts());
    net.peer=p;
    p.on('open',()=>{ toast('Szoba kész! Oszd meg a kódot 👉 '+net.code); hostBroadcast(hostLobbyMsg()); showScreen('lobby'); });
    p.on('connection',conn=>setupHostConn(conn));
    p.on('error',err=>{
      if(err.type==='unavailable-id' && tries<3){ tries++; net.code=genCode(); tryOpen(); return; }
      if(net.mode!=='host') return;
      toast('Nem sikerült szobát nyitni ('+err.type+'). Ellenőrizd a netet – a szóló mód offline is működik!',5000);
      resetAll();
    });
  };
  tryOpen();
}
function setupHostConn(conn){
  conn.on('data',d=>{
    if(!d||typeof d!=='object') return;
    if(d.t==='hello'){
      /* Verzióellenőrzés MINDEN más előtt: ez a legbeszédesebb hibaüzenet. */
      const gv=Number(d.v)||1;
      if(gv!==MY_PROTO){
        conn.send({t:'reject', ms:9000, reason: gv<MY_PROTO
          ? 'Régebbi verziójú játékot futtatsz, mint a szoba. Frissítsd az oldalt (Ctrl+F5, mobilon húzd le a lapot), és csatlakozz újra!'
          : 'Újabb verziójú játékot futtatsz, mint a szoba. A szoba gazdájának kell frissítenie az oldalt (Ctrl+F5).'});
        toast(String(d.name||'Egy játékos').slice(0,14)+' nem tud csatlakozni: eltérő játékverzió (nála v'+gv+', a szobában v'+MY_PROTO+'). Frissítsetek oldalt (Ctrl+F5)!',9000);
        setTimeout(()=>conn.close(),600); return;
      }
      if(host.phase!=='lobby'){ conn.send({t:'reject',reason:'A játék már elkezdődött ebben a szobában.'}); setTimeout(()=>conn.close(),400); return; }
      if(host.players.length>=MAXP){ conn.send({t:'reject',reason:'A szoba megtelt (max 6 játékos).'}); setTimeout(()=>conn.close(),400); return; }
      const name=String(d.name||'Játékos').slice(0,14);
      const avatar=AVATARS.includes(d.avatar)?d.avatar:'🐼';
      net.conns[conn.peer]=conn;
      host.players.push({pid:conn.peer, name, avatar, connected:true, score:0});
      conn.send({t:'welcome', v:MY_PROTO, you:conn.peer});
      hostBroadcast(hostLobbyMsg());
    }
    else if(d.t==='answer'){
      const p=host.players.find(p=>p.pid===conn.peer);
      if(p && d.qi===host.qi) collectAnswer(p.pid, d.value, Math.max(0,Math.min(120000, Number(d.ms)||0)));
    }
    else if(d.t==='joker'){
      if(d.qi===host.qi && host.players.some(p=>p.pid===conn.peer)) hostJoker(conn.peer, d.kind);
    }
    else if(d.t==='cqpick'){
      const p=host.players.find(p=>p.pid===conn.peer);
      if(p&&host.cq&&host.cq.on) cqOnPick(p.team, Number(d.idx));
    }
    else if(d.t==='bye'){ guestGone(conn.peer); }
  });
  conn.on('close',()=>guestGone(conn.peer));
}
function guestGone(pid){
  if(net.conns[pid]){ try{net.conns[pid].close();}catch(e){} delete net.conns[pid]; }
  const p=host&&host.players.find(p=>p.pid===pid);
  if(!p||p.connected===false) return;
  if(host.phase==='lobby'){ host.players=host.players.filter(x=>x.pid!==pid); hostBroadcast(hostLobbyMsg()); }
  else if(host.cq&&host.cq.on&&host.cq.phase!=='over'){
    p.connected=false; toast(p.name+' kilépett – a hódítás véget ért.',5000);
    clearHostTimers(); cqEnd();
  }
  else { p.connected=false; toast(p.name+' kilépett a játékból'); maybeAllAnswered(); }
}

function joinRoom(){
  if(!requireName()) return;
  const code=($('inp-code').value||'').trim().toUpperCase();
  if(code.length!==4){ toast('Add meg a 4 jegyű szobakódot!'); return; }
  net.mode='guest';
  toast('Csatlakozás…',8000);
  const p=new Peer(undefined, peerOpts());
  net.peer=p;
  let opened=false;
  const failT=setTimeout(()=>{ if(!opened){ toast('Nem sikerült csatlakozni. Ellenőrizd a kódot és a netet!'); resetAll(); } },12000);
  p.on('open',()=>{
    const conn=p.connect(peerId(code),{reliable:true});
    net.conn=conn;
    conn.on('open',()=>{ opened=true; clearTimeout(failT); conn.send({t:'hello', v:MY_PROTO, name:me.name, avatar:me.avatar}); });
    conn.on('data',d=>handleMsg(d));
    conn.on('close',()=>{ if(net.mode==='guest'){ toast('A kapcsolat a szobával megszakadt.'); resetAll(); } });
  });
  p.on('error',err=>{
    if(err.type==='peer-unavailable'){ clearTimeout(failT); toast('Nincs ilyen szoba: '+code); resetAll(); }
    else if(!opened){ clearTimeout(failT); toast('Kapcsolódási hiba: '+err.type); resetAll(); }
  });
}

function startSolo(){
  if(!requireName()) return;
  me.isHost=true; me.pid='H';
  net.mode='solo'; net.code=null;
  host=makeHost(true);
  host.players.push({pid:'H', name:me.name, avatar:me.avatar, isHost:true, connected:true, score:0});
  hostAddAI();
  showScreen('lobby');
}

function requireName(){
  const n=($('inp-name').value||'').trim();
  if(!n){ toast('Előbb add meg a neved! 😊'); $('inp-name').focus(); return false; }
  me.name=n;
  return true;
}

/* ---------------- host: játékmenet ---------------- */
/* Kategória-zsák. Végigmegyünk egy megkevert listán, és csak akkor keverünk újat,
   ha elfogyott – így minden tétel sorra kerül, mielőtt bármelyik ismétlődne, és a
   kategória mérete nem befolyásolja a gyakoriságot.
   A tippelős kérdéseknek SAJÁT, rövidebb listájuk van (`tip:true` a kategórián), és
   ott több kategória közös tételként szerepelhet (`tipg`, pl. a két filmes és a két
   sportos kategória, illetve a magyar és a világföldrajz egy tétel). */
function tipKey(cat){ const c=CATEGORIES[cat-1]; return (c&&c.tipg) ? c.tipg : String(cat); }
function isTipCat(cat){ const c=CATEGORIES[cat-1]; return !!(c&&c.tip); }
/* A tippelős kérdéseknél MINDIG a 9 sorsolási tétel neve jelenik meg, nem a
   kérdés alkategóriája (pl. az űrkutatási tipp is „Feltalálók és találmányok"). */
const TIP_GROUP_INFO = {
  foldrajz:  {name:'Földrajz', icon:'🌍'},
  feltalalo: {name:'Feltalálók és találmányok', icon:'💡'},
  film:      {name:'Filmek', icon:'🎬'},
};
function tipItemInfo(cat){
  const c=CATEGORIES[cat-1]||{};
  return (c.tipg && TIP_GROUP_INFO[c.tipg]) ? TIP_GROUP_INFO[c.tipg] : {name:c.name, icon:c.icon};
}
function tipItems(){   // a 9 tétel listája (a sorsolás-pörgetéshez)
  const seen={}, out=[];
  for(const c of CATEGORIES){
    if(!c.tip) continue;
    const k=c.tipg||String(c.id);
    if(seen[k]) continue; seen[k]=1; out.push(tipItemInfo(c.id));
  }
  return out;
}
function catBag(mcPool, tipPool){
  const by={mc:{}, tip:{}}, bag={mc:[], tip:[]};
  for(const q of mcPool)  (by.mc[String(q.cat)] = by.mc[String(q.cat)] ||[]).push(q);
  for(const q of tipPool) (by.tip[tipKey(q.cat)] = by.tip[tipKey(q.cat)]||[]).push(q);
  for(const t in by) for(const k in by[t]) by[t][k]=shuffle(by[t][k]);
  return function draw(type){
    const m=by[type];
    let i=bag[type].findIndex(k=>m[k] && m[k].length);
    if(i<0){ bag[type]=shuffle(Object.keys(m).filter(k=>m[k].length));
             i=bag[type].findIndex(k=>m[k].length); }
    if(i<0) return null;
    return m[bag[type].splice(i,1)[0]].pop();
  };
}
function buildDeck(){
  /* Nincs semmilyen szűrő: minden kategória és minden nehézség mindig játékban van. */
  const mcAll =QUESTIONS.filter(q=>q.type==='mc');
  const tipAll=QUESTIONS.filter(q=>q.type==='tip' && isTipCat(q.cat));
  const un=a=>{ const f=a.filter(q=>!host.usedIds.has(q.id)); return f.length>=Math.ceil(host.settings.count/2)?f:a; };
  const plan=qPlan(host.settings.count), draw=catBag(un(mcAll), un(tipAll));
  const take=(type,n)=>{ const a=[]; for(let i=0;i<n;i++){ const q=draw(type); if(!q) break; a.push(q); } return a; };
  const sMc=take('mc',plan.mc), sTip=take('tip',plan.tip);
  const fMc=take('mc',plan.fmc), fTip=take('tip',plan.ftip);
  host.deck = sMc.concat(sTip, fMc, fTip);
  host.finalFrom = sMc.length + sTip.length;    // innentől dupla pont
  host.sMcLen = sMc.length;                     // a sima MC-blokk hossza (joker-szakasz)
}
function hostStart(){
  if(host.players.length<2){ toast('Legalább 2 játékos kell – adj hozzá AI-t vagy várd meg a többieket!'); return; }
  if(host.settings.mode==='conquest'){
    if(host.players.length!==2){ toast('A Hódítás mód pontosan 2 játékossal megy (ember vagy AI).'); return; }
    const pools=cqBuildPools();
    if(!pools.mc.length||!pools.tip.length){
      toast('A Hódítás módhoz Kérdés-válasz ÉS tippelős kérdés is kell a kérdésbázisban.',4500); return; }
    cqStart(); return;
  }
  buildDeck();
  if(!host.deck.length){ toast('Nincs elég kérdés a kérdésbázisban.'); return; }
  if(host.deck.length<host.settings.count)
    toast('Csak '+host.deck.length+' kérdés jött össze '+host.settings.count+' helyett – kevés a kérdés a bázisban.',4500);
  host.players.forEach(p=>{ p.score=0; p.streak=0; p.best=0; });
  /* Jokerek: minden EMBER játékos 1 Felezést + 1 Dupla vagy semmit kap meccsenként (AI nem),
     plusz EGY tipp-jokert, amit Első vagy Utolsó számjegy kártyaként válthat be. */
  host.jokers={}; host.players.forEach(p=>{ if(!p.isAI) host.jokers[p.pid]={fifty:true,double:true,tip:true}; });
  host.stats={};
  host.qi=-1;
  hostNext();
}
function hostNext(){
  clearTimeout(host.autoNextT); clearTimeout(host.catT);
  host.qi++;
  if(host.qi>=host.deck.length){ hostEnd(); return; }
  const q=host.deck[host.qi], cat=CATEGORIES[q.cat-1];
  host.phase='catdraw';
  host.qFinal = host.qi >= (host.finalFrom!=null?host.finalFrom:Infinity);
  const bV=QVAL[(q.d||3)-1]*(host.qFinal?2:1);
  host.qTipMult=tipMultNow(); host.qSecond=tipSecondNow();
  /* haladás-infók a sorsolás-képernyőhöz: hátralévők a fináléig + a blokk maradéka */
  const FF=(host.finalFrom!=null&&host.finalFrom<=host.deck.length)?host.finalFrom:host.deck.length;
  const rest=host.qFinal?[]:host.deck.slice(host.qi, FF);
  const cms=catCountMs();   // 🐢 10 mp vagy ⚡ 4 mp a lobby tempó-beállítása szerint
  hostBroadcast({t:'catdraw', qi:host.qi, total:host.deck.length,
    cat: q.type==='tip' ? tipItemInfo(q.cat) : {name:cat.name,icon:cat.icon}, type:q.type, d:q.d,
    spin:CAT_SPIN_MS, count:cms, final:host.qFinal, finalLen:finalLen(host.deck.length),
    toFinal:rest.length,
    mcLeft:rest.filter(x=>x.type==='mc').length,
    tipLeft:rest.filter(x=>x.type==='tip').length,
    val: q.type==='tip' ? Math.round(bV*host.qTipMult) : bV,
    val2:(q.type==='tip') ? Math.round(bV*host.qSecond) : 0, players:playersMin()});
  host.catT=setTimeout(hostAsk, CAT_SPIN_MS+cms);
}
function hostAsk(){
  if(!host||host.phase!=='catdraw') return;
  clearTimeout(host.catT);
  const q=host.deck[host.qi];
  host.usedIds.add(q.id); host.qData=q; host.answers={}; host.phase='q';
  const cat=CATEGORIES[q.cat-1];
  const dur=q.type==='mc'?MC_DUR:TIP_DUR;
  host.qDur=dur;
  const baseV = QVAL[(q.d||3)-1]*(host.qFinal?2:1);   // a sorsoláskor rögzített értékek
  const msg={t:'question', qi:host.qi, total:host.deck.length,
             cat: q.type==='tip' ? tipItemInfo(q.cat) : {name:cat.name,icon:cat.icon},
             type:q.type, d:q.d, q:q.q, dur, players:playersMin(), last:host.qi===host.deck.length-1,
             final:host.qFinal, finalLen:finalLen(host.deck.length),
             val: q.type==='tip' ? Math.round(baseV*host.qTipMult) : baseV,
             val2: (q.type==='tip') ? Math.round(baseV*host.qSecond) : 0};
  if(q.type==='mc'){ const order=shuffle([0,1,2,3]); msg.options=order.map(i=>q.o[i]); host.qCorrectIndex=order.indexOf(0); host.qOptions=msg.options; }
  else msg.unit=q.unit||'';
  /* joker a SIMA blokkokban: MC-nél Felezés/Dupla, tippnél a számjegy-kártyák (fináléban semmi) */
  msg.jok = !host.qFinal && (q.type==='mc' ? host.qi < (host.sMcLen||0) : true);
  host.qJok={};
  hostBroadcast(msg);
  /* az utolsó sima MC-n a megmaradt Felezések automatikusan élesednek */
  if(msg.jok && host.qi===host.sMcLen-1){
    for(const p of host.players){
      if(p.isAI) continue;
      const j=host.jokers[p.pid];
      if(j&&j.fifty){ j.fifty=false; host.qJok[p.pid]='fifty';
        sendTo(p.pid,{t:'jokerack',kind:'fifty',qi:host.qi,remove:jokerRemovePair(),auto:true}); }
    }
  }
  host.players.filter(p=>p.isAI).forEach(p=>scheduleAI(p,q,dur));
  host.qDeadlineT=setTimeout(finishQuestion, dur+1500);
}
/* két KÜLÖNBÖZŐ rossz opció indexe a felezéshez (a megkevert opciókra) */
function jokerRemovePair(){
  return shuffle([0,1,2,3].filter(i=>i!==host.qCorrectIndex)).slice(0,2);
}
/* A tipp-joker által mutatott számjegy (előjelet nem nézünk; egyjegyűnél a teljes
   megoldás jön vissza – de ezt a játékos nem tudhatja biztosan). */
function tipDigit(a,kind){
  const s=String(Math.abs(Math.trunc(a)));
  return kind==='first' ? s[0] : s[s.length-1];
}
/* Joker-aktiválás (host oldali validáció). Szabályok:
   – MC-joker (fifty/double): csak a sima MC-blokkban,
   – tipp-joker (first/last): csak sima (nem finálé) tippelősön, és a KETTŐBŐL
     meccsenként csak EGY váltható be,
   – fináléban és hódításban semmilyen joker, csak válaszadás ELŐTT,
   – körönként legfeljebb EGY joker. */
function hostJoker(pid,kind){
  if(!host||host.phase!=='q'||(host.cq&&host.cq.on)) return;
  const q=host.qData;
  if(!q||host.qFinal) return;
  const j=host.jokers[pid];
  if(!j||host.qJok[pid]||host.answers[pid]) return;
  if(kind==='fifty'||kind==='double'){
    if(q.type!=='mc'||host.qi>=(host.sMcLen||0)||!j[kind]) return;
    j[kind]=false; host.qJok[pid]=kind;
    const ack={t:'jokerack',kind,qi:host.qi};
    if(kind==='fifty') ack.remove=jokerRemovePair();
    sendTo(pid,ack);
  } else if(kind==='first'||kind==='last'){
    if(q.type!=='tip'||!j.tip) return;
    j.tip=false; host.qJok[pid]=kind;                 // a másik számjegy-kártya is elveszik
    sendTo(pid,{t:'jokerack',kind,qi:host.qi,digit:tipDigit(q.a,kind)});
  }
}
function collectAnswer(pid,value,ms){
  if(!host||host.phase!=='q') return;
  if(host.answers[pid]) return;
  if(!host.players.find(p=>p.pid===pid)) return;
  host.answers[pid]={value,ms};
  hostBroadcast({t:'progress', answered:Object.keys(host.answers)});
  maybeAllAnswered();
}
function maybeAllAnswered(){
  if(!host||host.phase!=='q') return;
  const act=host.players.filter(p=>p.isAI||p.connected!==false);
  if(act.length && act.every(p=>host.answers[p.pid])) setTimeout(finishQuestion, FAST?150:600);
}
/* ---- Végi statisztikák: a host úgyis ismer minden adatot, csak eltesszük. ---- */
function statOf(pid){
  if(!host.stats) host.stats={};
  if(!host.stats[pid]) host.stats[pid]={okMc:null, okTip:null, badMc:null, miss:null, exact:0};
  return host.stats[pid];
}
function statMin(cur,v){ return (cur==null||v<cur) ? v : cur; }
function buildAwards(){
  const S=host.stats||{}, out=[];
  const P=pid=>host.players.find(x=>x.pid===pid)||{name:'?',avatar:'❓'};
  const sec=ms=>((ms/1000).toFixed(1).replace('.',','))+' mp';
  const add=(icon,title,get,wantMax,fmt,floor)=>{
    let best=null, who=[];
    for(const p of host.players){
      const v=get(S[p.pid]||{}, p);
      if(v==null) continue;
      if(floor!=null && v<floor) continue;
      if(best===null || (wantMax ? v>best : v<best)){ best=v; who=[p.pid]; }
      else if(v===best) who.push(p.pid);
    }
    if(best!==null) out.push({icon, title, value:fmt(best),
      names:who.map(x=>P(x).name), avatars:who.map(x=>P(x).avatar)});
  };
  add('⚡','Leggyorsabb helyes válasz · Kérdés-válasz', s=>s.okMc,  false, sec);
  add('🎯','Leggyorsabb nyerő tipp',               s=>s.okTip, false, sec);
  add('🔥','Leghosszabb sorozat',        (s,p)=>p.best||null,   true,  v=>v+' egymás után', 2);
  add('💯','Legtöbb telitalálat',        s=>s.exact||null,      true,  v=>v+' db', 1);
  /* 🤦 leggyorsabb rossz válasz – a kérdés és az elhibázott válasz is látszik */
  { let fast=null, fWho=[];
    for(const p of host.players){
      const s=S[p.pid]||{}; if(s.badMc==null) continue;
      if(fast===null || s.badMc<fast){ fast=s.badMc; fWho=[p.pid]; }
      else if(s.badMc===fast) fWho.push(p.pid);
    }
    if(fast!==null){
      const bq=(S[fWho[0]]||{}).badQ||null;
      out.push({icon:'🤦', title:'Leggyorsabb rossz válasz · Kérdés-válasz', value:sec(fast),
        sub:bq?('„'+bq.q+'” — válasza: '+bq.wrong+' (a jó: '+bq.correct+')'):null,
        names:fWho.map(x=>P(x).name), avatars:fWho.map(x=>P(x).avatar)});
    }
  }
  /* 🙈 legnagyobb melléfogás – külön, mert részletező sort is kap */
  let worst=null, wWho=[];
  for(const p of host.players){
    const m=(S[p.pid]||{}).miss; if(!m) continue;
    if(worst===null || m.rel>worst.rel){ worst=m; wWho=[p.pid]; }
    else if(m.rel===worst.rel) wWho.push(p.pid);
  }
  if(worst){
    const u=worst.unit?(' '+worst.unit):'';
    out.push({icon:'🙈', title:'Legnagyobb melléfogás · tippelős',
      value:(worst.rel>=10 ? Math.round(worst.rel)+'× mellé' : Math.round(worst.rel*100)+'% mellé'),
      sub:(worst.q?'„'+worst.q+'” — ':'')+'tippje '+fmtNum(worst.g)+u+', a jó válasz '+fmtNum(worst.a)+u+' volt',
      names:wWho.map(x=>P(x).name), avatars:wWho.map(x=>P(x).avatar)});
  }
  return out;
}

function finishQuestion(){
  if(!host||host.phase!=='q') return;
  if(host.cq&&host.cq.on){ cqFinishQuestion(); return; }
  host.phase='reveal';
  clearTimeout(host.qDeadlineT);
  host.aiTimers.forEach(clearTimeout); host.aiTimers=[];
  const q=host.qData;
  const V=QVAL[(q.d||3)-1]*(host.qFinal?2:1);   // dupla pontos finálé
  const results=[]; let tie=false;
  if(q.type==='mc'){
    for(const p of host.players){
      const a=host.answers[p.pid];
      let pts=0, ok=false, val=null, ms=null, base=0, mult=1;
      if(a&&typeof a.value==='number'&&a.value>=0&&a.value<=3){
        val=a.value; ms=a.ms; ok=(val===host.qCorrectIndex);
      }
      const prev=p.streak||0;
      const jok=(host.qJok&&host.qJok[p.pid])||0;
      if(!host.qFinal){                               // a sorozat csak a SIMA MC-ken épül és szakad; a finálé semleges
        p.streak = ok ? prev+1 : 0;
        p.best = Math.max(p.best||0, p.streak);
      }
      if(val!=null){
        const st=statOf(p.pid);
        if(ok) st.okMc=statMin(st.okMc,ms);
        else {
          /* a leggyorsabb rossz válaszhoz a kérdést és az elrontott választ is eltesszük */
          if(st.badMc==null||ms<st.badMc)
            st.badQ={q:q.q, wrong:(host.qOptions&&host.qOptions[val])||'?', correct:q.o[0]};
          st.badMc=statMin(st.badMc,ms);
        }
      }
      if(ok){
        if(jok==='double'){                           // 🎲 dupla vagy semmi: fixen 2×alapérték, se sorozat-, se gyorsbónusz
          base=2*V; mult=1; pts=2*V;
        } else {
          base = V+Math.max(0,Math.round(V*MC_SPEED_BONUS*(1-ms/host.qDur)));
          mult = host.qFinal ? 1 : streakMult(p.streak); // a fináléban nincs sorozat-szorzó
          pts  = Math.round(base*mult);
        }
        p.score += pts;
      } else if(jok==='double'){                      // rossz VAGY elmaradt válasz: bukja az alapértéket (negatív is lehet)
        pts=-V; p.score+=pts;
      }
      results.push({pid:p.pid,val,ms,pts,ok,win:ok,base,mult,streak:p.streak,jok,
                    broke:(!host.qFinal&&!ok&&prev>=2)?prev:0});
    }
  } else {
    const cands=[];
    for(const p of host.players){
      const a=host.answers[p.pid];
      if(a&&typeof a.value==='number'&&isFinite(a.value))
        cands.push({pid:p.pid,val:a.value,ms:a.ms,dist:Math.abs(a.value-q.a)});
    }
    const ranked=cands.slice().sort((a,b)=>(a.dist-b.dist)||(a.ms-b.ms));
    const win=ranked[0]||null;
    const second=(host.qSecond&&ranked.length>1)?ranked[1]:null;
    if(win) tie=cands.filter(c=>c.dist===win.dist).length>1;
    const Vwin=Math.round(V*(host.qTipMult||1));       // a mezőny méretével skálázott érték
    for(const p of host.players){
      const c=cands.find(c=>c.pid===p.pid);
      const isW=!!(win&&win.pid===p.pid);
      const isS=!!(second&&second.pid===p.pid);
      if(c){
        const st=statOf(p.pid);
        if(c.dist===0) st.exact++;                       // telitalálat akkor is, ha nem ő volt a gyorsabb
        if(isW) st.okTip=statMin(st.okTip,c.ms);
        else {
          /* Melléfogás RELATÍV hibában – különben a nagy számú kérdések (lakosság, távolság)
             mindig elnyomnák az évszámokat. A kérdés nyertesét nem büntetjük. */
          const rel=c.dist/Math.max(1,Math.abs(q.a));
          if(!st.miss || rel>st.miss.rel) st.miss={rel, a:q.a, g:c.val, unit:q.unit||'', q:q.q};
        }
      }
      let pts=0;
      if(isW){ pts=Vwin+(win.dist===0?Math.round(Vwin*TIP_EXACT_BONUS):0); p.score+=pts; }
      else if(isS){ pts=Math.round(V*host.qSecond); p.score+=pts; }  // 2. legjobb tipp: 3 főnél 40%, 4 főtől a teljes érték
      results.push({pid:p.pid, val:c?c.val:null, ms:c?c.ms:null, dist:c?c.dist:null, pts, win:isW, second:isS,
                    base:pts, mult:1, streak:p.streak||0, jok:(host.qJok&&host.qJok[p.pid])||0});
    }
  }
  const msg={t:'reveal', qi:host.qi, type:q.type, results, players:playersMin(),
             final:host.qFinal, autoNextIn:REVEAL_AUTO, note:q.note||'', tie, last:host.qi===host.deck.length-1};
  if(q.type==='mc'){ msg.correctIndex=host.qCorrectIndex; msg.correctText=q.o[0]; }
  else { msg.correctValue=q.a; msg.unit=q.unit||''; }
  hostBroadcast(msg);
  host.autoNextT=setTimeout(hostNext, REVEAL_AUTO);
}
function hostAdvance(){ if(!host)return; clearTimeout(host.autoNextT); hostNext(); }
function hostEnd(){
  host.phase='end';
  const ranking=playersMin().sort((a,b)=>b.score-a.score);
  hostBroadcast({t:'end', ranking, awards:buildAwards()});
}
function hostRematch(){
  clearHostTimers();
  host.players=host.players.filter(p=>p.isAI||p.connected!==false);
  host.players.forEach(p=>{ p.score=0; p.streak=0; p.best=0; p.team=undefined; });
  host.cq=null; host.stats={}; host.phase='lobby'; host.qi=-1;
  cqState=null; $('cq-wrap').classList.remove('on');
  hostBroadcast(hostLobbyMsg());
}

/* ============================================================
   HÓDÍTÁS mód – hostoldali állapotgép
   ============================================================ */
function cqPlayer(team){ return host.players.find(p=>p.team===team); }
function cqOwned(team){ const a=[],n=cqMap().n; for(let i=0;i<n;i++) if(host.cq.owner[i]===team) a.push(i); return a; }
function cqFree(){ const a=[],n=cqMap().n; for(let i=0;i<n;i++) if(!host.cq.owner[i]) a.push(i); return a; }
/* Amire a csapat "rálát": a vára szomszédai + a saját területei szomszédai */
function cqReach(team){
  const M=cqMap(), s=new Set(M.cadj[team]);
  cqOwned(team).forEach(i=>M.adj[i].forEach(j=>s.add(j)));
  return s;
}
function cqPickable(team){
  const free=cqFree(); if(!free.length) return [];
  const r=cqReach(team), near=free.filter(i=>r.has(i));
  return near.length?near:free;     // ha nincs kapcsolódó szabad terület, bármelyik jöhet
}
function cqTargets(team){           // várat a bétában nem lehet támadni
  const foe=team===1?2:1, r=cqReach(team);
  return cqOwned(foe).filter(i=>r.has(i));
}
function cqPickList(team){
  if(!team||!host.cq) return [];
  if(host.cq.phase==='war') return cqTargets(team);
  const taken=host.cq.picks[team===1?2:1];
  let l=cqPickable(team).filter(i=>i!==taken);
  if(!l.length) l=cqFree().filter(i=>i!==taken);
  return l;
}
function cqTotal(team){ let s=host.cq.castle[team]; cqOwned(team).forEach(i=>s+=host.cq.val[i]); return s; }

function cqSnap(){
  const c=host.cq;
  return { phase:c.phase, sub:c.sub, owner:c.owner.slice(), val:c.val.slice(),
    castle:{1:c.castle[1],2:c.castle[2]}, picks:{1:c.picks[1],2:c.picks[2]},
    turn:c.turn, target:c.target, atkTeam:c.atkTeam, round:c.round,
    attacks:{1:c.attacks[1],2:c.attacks[2]}, tot:{1:cqTotal(1),2:cqTotal(2)},
    free:cqFree().length, sel:cqPickList(c.turn), log:c.log, pickMs:CQ_PICK_DUR,
    map:cqMap().key, maxAtk:cqMap().attacks,
    teams:host.players.map(p=>({pid:p.pid,team:p.team,name:p.name,avatar:p.avatar,isAI:!!p.isAI})) };
}
function cqBroadcast(){ hostBroadcast({t:'cq', st:cqSnap()}); }
function cqLater(fn,ms){ clearTimeout(host.cq.nextT); host.cq.nextT=setTimeout(fn,ms); }

function cqBuildPools(){
  let mcAll =QUESTIONS.filter(q=>q.type==='mc');
  let tipAll=QUESTIONS.filter(q=>q.type==='tip' && isTipCat(q.cat));
  /* a munkamenetben már feltett kérdéseket itt is kerüljük, amíg van elég friss */
  const fm=mcAll.filter(q=>!host.usedIds.has(q.id)), ft=tipAll.filter(q=>!host.usedIds.has(q.id));
  if(fm.length>=40) mcAll=fm;
  if(ft.length>=15) tipAll=ft;
  host.cqPool={mc:mcAll, tip:tipAll, draw:catBag(mcAll,tipAll)};
  return host.cqPool;
}
function cqDraw(type){
  if(!host.cqPool.draw) cqBuildPools();
  return host.cqPool.draw(type) || (cqBuildPools(), host.cqPool.draw(type));
}

function cqStart(){
  host.players[0].team=1; host.players[1].team=2;   // host/ember = piros, ellenfél = kék
  host.players.forEach(p=>p.score=0);
  cqBuildPools();
  const startTeam=Math.random()<0.5?1:2, M=cqMap();
  host.cq={ on:true, phase:'grab', sub:'pick', owner:new Array(M.n).fill(0), val:new Array(M.n).fill(0),
    castle:{1:CQ_CASTLE0,2:CQ_CASTLE0}, first:startTeam, startTeam, picks:{1:null,2:null}, turn:null,
    qtype:'mc', single:false, attacks:{1:M.attacks,2:M.attacks}, atkTeam:null, target:null,
    decider:false, round:1, dry:0, log:'🎲 Sorsolás: '+CQ_TEAM_NAME[startTeam]+' kezd a területválasztással!',
    pickT:null, aiT:null, nextT:null };
  host.phase='cq'; host.qi=-1;
  cqBroadcast();
  cqLater(cqNextGrab, FAST?400:2600);
}

/* ---- TERÜLETFOGLALÁS ---- */
function cqNextGrab(){
  const c=host.cq; if(!c||c.phase!=='grab') return;
  const free=cqFree();
  if(!free.length){ cqStartWar(); return; }
  c.picks={1:null,2:null}; c.target=null; c.single=(free.length===1);
  if(c.single){
    c.picks[1]=free[0]; c.picks[2]=free[0]; c.turn=null; c.sub='q';
    c.log='Egyetlen szabad terület maradt – nincs választás, aki jobban tudja, azé!';
    cqBroadcast();
    cqLater(()=>cqAsk(c.qtype,false), FAST?400:2200);
    return;
  }
  c.sub='pick'; c.log='';
  cqAskPick(c.first);
}
function cqAskPick(team){
  const c=host.cq; c.turn=team; c.sub='pick';
  const list=cqPickList(team);
  if(!list.length){ cqOnPick(team,null); return; }
  cqBroadcast();
  clearTimeout(c.pickT); clearTimeout(c.aiT);
  c.pickT=setTimeout(()=>cqOnPick(team, list[Math.floor(Math.random()*list.length)]), CQ_PICK_DUR+500);
  const p=cqPlayer(team);
  if(p&&p.isAI) c.aiT=setTimeout(()=>cqOnPick(team, cqAiPick(team,list)), FAST?300:(1200+Math.random()*1800));
}
function cqOnPick(team, idx){
  const c=host.cq;
  if(!c||!c.on||c.sub!=='pick'||c.turn!==team) return;
  clearTimeout(c.pickT); clearTimeout(c.aiT);
  const list=cqPickList(team);
  if(idx==null||list.indexOf(idx)<0) idx=list.length?list[Math.floor(Math.random()*list.length)]:null;

  if(c.phase==='war'){
    c.turn=null; c.target=idx;
    if(idx==null){ c.attacks[team]=0; cqAfterAttack(); return; }
    c.sub='q';
    c.log=CQ_TEAM_NAME[team]+' megtámadja a(z) '+(idx+1)+'. területet ('+c.val[idx]+' pont)!';
    cqBroadcast();
    cqLater(()=>cqAsk('mc',false), FAST?400:2200);
    return;
  }
  c.picks[team]=idx;
  const other=team===1?2:1;
  if(c.picks[other]==null){ cqAskPick(other); return; }
  c.turn=null; c.sub='q'; c.log='Mindkét terület kijelölve – jöhet a kérdés!';
  cqBroadcast();
  cqLater(()=>cqAsk(c.qtype,false), FAST?400:1800);
}

/* ---- kérdés ---- */
function cqLabel(){
  const c=host.cq;
  if(c.phase==='war') return c.decider?'⚡ DÖNTŐ':'⚔️ TÁMADÁS';
  return '🚩 FOGLALÁS';
}
function cqAsk(type, decider){
  const c=host.cq; if(!c||!c.on) return;
  const q=cqDraw(type);
  if(q.id!=null) host.usedIds.add(q.id);   // munkamenet-memória a hódításban is
  host.qData=q; host.answers={}; host.phase='q'; host.qi++; host.qDur=(type==='mc'?CQ_MC_DUR:CQ_TIP_DUR);
  c.sub='q'; c.decider=!!decider;
  const cat=CATEGORIES[q.cat-1];
  const msg={t:'question', qi:host.qi, total:0, cq:true, decider:!!decider, label:cqLabel(),
    cat: q.type==='tip' ? tipItemInfo(q.cat) : {name:cat.name,icon:cat.icon},
    type:q.type, d:q.d, q:q.q, dur:host.qDur, players:playersMin()};
  if(q.type==='mc'){ const o=shuffle([0,1,2,3]); msg.options=o.map(i=>q.o[i]); host.qCorrectIndex=o.indexOf(0); }
  else msg.unit=q.unit||'';
  cqBroadcast();
  hostBroadcast(msg);
  host.players.filter(p=>p.isAI).forEach(p=>scheduleAI(p,q,host.qDur));
  clearTimeout(host.qDeadlineT);
  host.qDeadlineT=setTimeout(finishQuestion, host.qDur+1500);
}
function cqTipWinner(ans){
  let w=null;
  for(const t of [1,2]){
    const a=ans[t]; if(a.dist==null) continue;
    if(w===null||a.dist<ans[w].dist||(a.dist===ans[w].dist&&a.ms<ans[w].ms)) w=t;
  }
  return w;
}
function cqTake(team,i,V,dl){
  host.cq.owner[i]=team; host.cq.val[i]=V;
  dl.push({good:true, txt:CQ_TEAM_NAME[team]+' elfoglalta a(z) '+(i+1)+'. területet – '+V+' pont.'});
}
function cqCapture(atk,i,dl){
  const c=host.cq, old=c.val[i];
  c.val[i]=Math.min(old+CQ_ATK_GAIN, CQ_VAL_MAX); c.owner[i]=atk;
  dl.push({good:true, txt:CQ_TEAM_NAME[atk]+' bevette a(z) '+(i+1)+'. területet! Értéke '+old+' → '+c.val[i]+
    (c.val[i]===old?' (a '+CQ_VAL_MAX+'-es plafonon van)':'')+'.'});
}
function cqDefend(def,dl){
  const c=host.cq; c.castle[def]+=CQ_DEF_BONUS;
  dl.push({good:true, txt:CQ_TEAM_NAME[def]+' megvédte a területet! A vára +'+CQ_DEF_BONUS+' pont → '+c.castle[def]+'.'});
}
function cqSendReveal(q,ans,dl){
  const msg={t:'reveal', cq:true, type:q.type, note:q.note||'', deltas:dl,
             autoNextIn:CQ_REVEAL, players:playersMin(), rows:[]};
  if(q.type==='mc'){ msg.correctIndex=host.qCorrectIndex; msg.correctText=q.o[0]; }
  else { msg.correctValue=q.a; msg.unit=q.unit||''; }
  for(const p of host.players){
    const a=ans[p.team];
    msg.rows.push({pid:p.pid, team:p.team, val:a.value, ms:a.ms, ok:a.ok, dist:a.dist});
  }
  cqBroadcast();
  hostBroadcast(msg);
}
function cqFinishQuestion(){
  const c=host.cq;
  host.phase='cqreveal'; c.sub='reveal';
  clearTimeout(host.qDeadlineT);
  host.aiTimers.forEach(clearTimeout); host.aiTimers=[];
  const q=host.qData, V=QVAL[(q.d||3)-1], dl=[];
  const ans={};
  for(const p of host.players){
    const a=host.answers[p.pid];
    const o={value:a?a.value:null, ms:a?a.ms:null, ok:false, dist:null};
    if(a){
      if(q.type==='mc') o.ok=(a.value===host.qCorrectIndex);
      else if(typeof a.value==='number'&&isFinite(a.value)){ o.dist=Math.abs(a.value-q.a); o.ok=true; }
    }
    ans[p.team]=o;
  }

  if(c.phase==='grab'){
    const freeBefore=cqFree().length;
    if(q.type==='mc'){
      if(c.single){
        let w=null;
        for(const t of [1,2]) if(ans[t].ok && (w===null||ans[t].ms<ans[w].ms)) w=t;
        if(w) cqTake(w,c.picks[w],V,dl);
        else dl.push({bad:true, txt:'Egyik csapat sem tudta – a terület szabad marad.'});
      } else {
        for(const t of [1,2]){
          if(c.picks[t]==null) continue;
          if(ans[t].ok) cqTake(t,c.picks[t],V,dl);
          else dl.push({bad:true, txt:CQ_TEAM_NAME[t]+' hibázott – a(z) '+(c.picks[t]+1)+'. terület szabad marad.'});
        }
      }
    } else {
      const w=cqTipWinner(ans);
      if(w!==null){
        cqTake(w,c.picks[w],V,dl);
        const l=w===1?2:1;
        if(!c.single&&c.picks[l]!=null)
          dl.push({bad:true, txt:CQ_TEAM_NAME[l]+' tippje volt távolabb – a(z) '+(c.picks[l]+1)+'. terület szabad marad.'});
      } else dl.push({bad:true, txt:'Senki nem tippelt – nincs foglalás.'});
    }
    /* biztonsági szelep: ha sokadszor sem foglal senki, ne pörögjön a végtelenségig */
    if(cqFree().length===freeBefore){
      if(++c.dry>=CQ_DRY_LIMIT){
        c.dry=0;
        const order=c.single?[c.first]:[c.first, c.first===1?2:1];
        for(const t of order){
          const i=c.picks[t];
          if(i!=null && !host.cq.owner[i]) cqTake(t,i,V,dl);
        }
        dl.push({txt:'🎲 '+CQ_DRY_LIMIT+' eredménytelen forduló után a kijelölt területek gazdára találtak.'});
      }
    } else c.dry=0;
    c.qtype=(q.type==='mc')?'tip':'mc';    // 4 válaszos után mindig tippelős
    c.first=(c.first===1?2:1);             // fordul a választási sorrend
    c.round++;
    cqSendReveal(q,ans,dl);
    cqLater(cqNextGrab, CQ_REVEAL);
    return;
  }

  /* ---- HARC ---- */
  const atk=c.atkTeam, def=(atk===1?2:1), i=c.target;
  if(!c.decider){
    if(ans[atk].ok && ans[def].ok){
      dl.push({txt:'⚡ Mindketten tudták! Tippelős kérdés dönt a területről.'});
      cqSendReveal(q,ans,dl);
      cqLater(()=>cqAsk('tip',true), CQ_REVEAL);
      return;
    }
    if(ans[atk].ok) cqCapture(atk,i,dl);
    else if(ans[def].ok) cqDefend(def,dl);
    else dl.push({txt:'Egyik csapat sem tudta – nem történik semmi, a terület marad.'});
  } else {
    const w=cqTipWinner(ans);
    if(w===atk) cqCapture(atk,i,dl);
    else if(w===def) cqDefend(def,dl);
    else dl.push({txt:'Senki nem tippelt – nem történik semmi.'});
  }
  c.attacks[atk]--; c.decider=false;
  cqSendReveal(q,ans,dl);
  cqLater(cqAfterAttack, CQ_REVEAL);
}

/* ---- HARC fázis ---- */
function cqStartWar(){
  const c=host.cq;
  c.phase='war'; c.sub='pick'; c.picks={1:null,2:null}; c.single=false; c.turn=null; c.target=null;
  c.atkTeam=(c.startTeam===1?2:1);   // aki a foglalásnál másodikként választott, itt kezd
  const A=cqMap().attacks;
  c.log='⚔️ Minden terület elkelt! Jön a HARC: '+A+'–'+A+' támadás, kezd '+CQ_TEAM_NAME[c.atkTeam]+'.';
  cqBroadcast();
  cqLater(()=>{ const l=cqTargets(c.atkTeam); if(!l.length) cqAfterAttack(); else cqAskPick(c.atkTeam); }, FAST?500:3400);
}
function cqAfterAttack(){
  const c=host.cq; if(!c||!c.on) return;
  c.decider=false; c.target=null; c.sub='pick';
  if(c.attacks[1]<=0 && c.attacks[2]<=0){ cqEnd(); return; }
  let nx=(c.atkTeam===1?2:1);
  if(c.attacks[nx]<=0) nx=c.atkTeam;
  c.atkTeam=nx;
  const list=cqTargets(nx);
  if(!list.length){
    c.attacks[nx]=0;
    c.log=CQ_TEAM_NAME[nx]+' nem lát rá egyetlen ellenséges területre sem – kimarad.';
    cqBroadcast();
    cqLater(cqAfterAttack, FAST?400:2600);
    return;
  }
  c.log='';
  cqAskPick(nx);
}
function cqEnd(){
  const c=host.cq; c.phase='over'; c.sub='end'; c.turn=null; c.target=null;
  const tot={1:cqTotal(1), 2:cqTotal(2)};
  host.players.forEach(p=>p.score=tot[p.team]);
  const st=cqSnap();
  hostBroadcast({t:'end', cq:true, st, tot, ranking:playersMin().sort((a,b)=>b.score-a.score)});
}

/* ---- AI a hódítás módhoz ---- */
function cqAiPick(team,list){
  const c=host.cq;
  if(c.phase==='war'){            // a legértékesebb elérhető ellenséges terület
    let best=list[0];
    for(const i of list) if(c.val[i]>c.val[best]) best=i;
    return best;
  }
  const r=cqReach(team), M=cqMap();   // foglalás: kapcsolódó és jól hálózott mező
  let best=list[0], bs=-Infinity;
  for(const i of list){
    const s=M.adj[i].length*1.0 + (r.has(i)?4:0) + Math.random()*0.9;
    if(s>bs){ bs=s; best=i; }
  }
  return best;
}

/* ---------------- AI ----------------
   Az AI "tudása" a szintjétől ÉS a kérdés nehézségétől függ (AI_TIERS).
   Időzítés: 1–2 mp múlva ténylegesen válaszol (így sosem kell rá várni),
   de a pontozásnál kap egy 5–25 mp-es Robot Idő Büntetést – vagyis a
   gyorsasági bónuszt és a holtversenyt gyakorlatilag mindig az ember viszi. */
const AI_SPREAD = [0.55, 0.75, 1.00, 1.40, 1.90];   // tipp-szórás alapszorzó d1..d5
function aiTier(p){ return AI_TIERS[Math.max(0,Math.min(AI_TIERS.length-1, p.ai||0))]; }
function rnd(r){ return r[0]+Math.random()*(r[1]-r[0]); }
function scheduleAI(p,q,dur){
  const tier=aiTier(p);
  const think=Math.round(rnd(AI_THINK));               // ennyi idő múlva válaszol
  const shown=Math.min(dur, think+Math.round(rnd(AI_LAG)));  // ennyit "számolunk fel" neki
  host.aiTimers.push(setTimeout(()=>{
    let value;
    if(q.type==='mc'){
      if(Math.random()<tier.p[(q.d||3)-1]) value=host.qCorrectIndex;
      else { const w=[0,1,2,3].filter(i=>i!==host.qCorrectIndex); value=w[Math.floor(Math.random()*w.length)]; }
    } else value=aiTip(q,tier);
    collectAnswer(p.pid,value,shown);
  },think));
}
function aiTip(q,tier){
  const a=q.a; let g;
  const m=AI_SPREAD[(q.d||3)-1]*((tier&&tier.spr)||1);
  const yearLike=a>=800&&a<=2100&&(!q.unit);
  const blunder=Math.random()<((tier&&tier.blund)||0);   // „baklövés”: nagy mellélövés, mint az embereknél
  if(yearLike){
    if(blunder) g=Math.round(a+(Math.random()<0.5?-1:1)*(40+Math.random()*180));
    else { const sigma=(10+Math.random()*30)*m; g=Math.round(a+gauss()*sigma); }
    if(a>1800) g=Math.min(g,2026);
    g=Math.max(1,g);
  } else {
    if(blunder){ const f=(Math.random()<0.5)?(0.2+Math.random()*0.4):(1.8+Math.random()*2.2); g=Math.round(a*f); }
    else { const rel=(0.12+Math.random()*0.40)*m; g=Math.round(a*(1+gauss()*rel)); }
    if(g===a&&Math.random()<0.5) g+=(Math.random()<0.5?-1:1)*Math.max(1,Math.round(a*0.05));
    g=Math.max(0,g);
  }
  return g;
}

/* ---------------- üzenetkezelés (minden kliens) ---------------- */
function handleMsg(m){
  if(!m||typeof m!=='object') return;
  switch(m.t){
    /* A fordított irány: RÉGI host + ÚJ vendég. A régi host nem ismeri a `v` mezőt,
       ezért nem tud elutasítani – itt a vendég lép ki, hogy ne induljon néma
       inkompatibilitás. (A `bye` gyorsítja a host oldali észlelést.) */
    case 'welcome': {
      const hv=Number(m.v)||1;
      if(hv!==MY_PROTO){
        toast(hv<MY_PROTO
          ? 'A szoba régebbi verziójú játékot futtat (v'+hv+', nálad v'+MY_PROTO+'). Kérd meg a szoba gazdáját, hogy frissítse az oldalt (Ctrl+F5)!'
          : 'A szoba újabb verziójú játékot futtat (v'+hv+', nálad v'+MY_PROTO+'). Frissítsd az oldalt (Ctrl+F5), és csatlakozz újra!', 9000);
        sendToHost({t:'bye'}); resetAll(); return;
      }
      me.pid=m.you; break;
    }
    case 'reject': toast(m.reason||'Elutasítva', m.ms); resetAll(); break;
    case 'kicked': toast('A host kitett a szobából.'); resetAll(); break;
    case 'hostbye': toast('A host bezárta a szobát.'); resetAll(); break;
    case 'lobby': lastPlayers=m.players; cqState=null; $('cq-wrap').classList.remove('on');
                  myJok={fifty:true,double:true,tip:true}; jokIntro=true;   // új meccs → új joker-készlet
                  SND.fanfared=false; lastPickKey=null;                     // meccs-szintű hang-flagek vissza
                  renderLobby(m); showScreen('lobby'); break;
    case 'jokerack': jokerApply(m); break;
    case 'cq': cqOnState(m.st); break;
    case 'catdraw': lastPlayers=m.players; renderCatDraw(m); break;
    case 'question': lastPlayers=m.players; renderQuestion(m); showScreen('game'); break;
    case 'progress': renderProgress(m.answered||[]); break;
    case 'reveal': lastPlayers=m.players; if(m.cq) cqRenderReveal(m); else renderReveal(m); break;
    case 'end': if(m.cq) cqRenderEnd(m); else renderEnd(m); showScreen('end'); break;
  }
}
function pinfo(pid){ return lastPlayers.find(p=>p.pid===pid)||{name:'?',avatar:'❓'}; }

/* ---------------- render: lobby ---------------- */
const DIFF_NAMES=["nagyon könnyű","könnyű","közepes","nehéz","extra nehéz"];
function renderLobby(m){
  const isHost=me.isHost;
  $('lobby-code').innerHTML = m.solo
    ? '<div class="lbl">🤖 Szóló mód – AI ellenfelekkel</div>'
    : '<div class="lbl">Szobakód – ezt add meg a többieknek:</div><div class="code">'+esc(m.code||'')+'</div>';
  $('lobby-players').innerHTML = m.players.map(p=>{
    const badges=(p.isHost?' 👑':'')+(p.isAI?' <span title="AI">🤖</span>':'');
    const off=p.connected===false?' off':'';
    const x=(isHost&&p.pid!==me.pid)?'<span class="x" data-kick="'+esc(p.pid)+'" title="Eltávolítás">✕</span>':'';
    return '<span class="pchip'+off+'"><span class="av">'+p.avatar+'</span> '+esc(p.name)+badges+x+'</span>';
  }).join('');
  if(isHost){
    const conq = m.settings.mode==='conquest';
    $('lobby-settings').innerHTML =
      '<div class="settings">'+
      '<div class="setrow"><span class="lab">Játékmód</span><span class="seg" id="seg-mode">'+
        '<button data-m="classic" class="'+(conq?'':'sel')+'">🎉 Klasszikus</button>'+
        '<button data-m="conquest" class="'+(conq?'sel':'')+'">⚔️ Hódítás (2 fő)</button>'+
      '</span></div>'+
      (conq
        ? '<div class="setrow"><span class="lab">Térkép</span><span class="seg" id="seg-map">'+
            Object.keys(CQ_MAPS).map(k=>'<button data-k="'+k+'" class="'+((m.settings.mapKey||'big')===k?'sel':'')+'">'+
              CQ_MAPS[k].label+'</button>').join('')+
          '</span></div>'+
          '<div class="hint" style="text-align:left;margin:2px 0 6px">⚔️ <b>Hódítás:</b> '+
          CQ_MAPS[m.settings.mapKey||'big'].desc+'. Pontosan 2 játékos kell (AI is jó); a kérdésszámot a térkép adja.</div>'
        : '<div class="setrow"><span class="lab">Kérdések száma</span><span class="seg" id="seg-count">'+
        Q_COUNTS.map(v=>'<button data-c="'+v+'" class="'+(m.settings.count===v?'sel':'')+'">'+v+'</button>').join('')+
      '</span></div>'+
      '<div class="setrow"><span class="lab">Tempó</span><span class="seg" id="seg-tempo">'+
        '<button data-t="calm" title="10 mp visszaszámlálás a kérdések előtt" class="'+((m.settings.tempo||'calm')!=='fast'?'sel':'')+'">🐢 Nyugodt · 10 mp</button>'+
        '<button data-t="fast" title="4 mp visszaszámlálás a kérdések előtt" class="'+(m.settings.tempo==='fast'?'sel':'')+'">⚡ Pörgős · 4 mp</button>'+
      '</span></div>'+
      '<div class="hint" style="text-align:left;margin:0 0 4px">'+
        qPlan(m.settings.count).mc+' × Kérdés-válasz → '+qPlan(m.settings.count).tip+' × tippelős → '+
        '🎬 <b>'+qPlan(m.settings.count).fmc+' dupla Kérdés-válasz + '+qPlan(m.settings.count).ftip+' dupla tippelős</b>'+
      '</div>')+
      '<div class="setrow"><span class="lab">AI hozzáadása</span><span class="seg" id="seg-ai">'+
        AI_TIERS.map((t,i)=>'<button data-ai="'+i+'" title="'+esc(t.name)+' – közepes kérdésen '+
          Math.round(t.p[2]*100)+'% eséllyel tudja a választ">+ '+t.avatar+' '+t.short+'</button>').join('')+
      '</span></div></div>';
    $('lobby-actions').innerHTML =

      '<button class="btn primary" id="btn-start">▶ Játék indítása</button>';
    $('btn-start').onclick=hostStart;
    document.querySelectorAll('#seg-ai button').forEach(b=>b.onclick=()=>hostAddAI(+b.dataset.ai));
    document.querySelectorAll('#seg-mode button').forEach(b=>b.onclick=()=>{
      host.settings.mode=b.dataset.m;
      if(b.dataset.m==='conquest'&&host.players.length!==2)
        toast('A Hódítás módhoz pontosan 2 játékos kell – most '+host.players.length+' van.',4000);
      hostBroadcast(hostLobbyMsg());
    });
    document.querySelectorAll('#seg-map button').forEach(b=>b.onclick=()=>{
      host.settings.mapKey=b.dataset.k; hostBroadcast(hostLobbyMsg()); });
    document.querySelectorAll('#seg-count button').forEach(b=>b.onclick=()=>{ host.settings.count=+b.dataset.c; hostBroadcast(hostLobbyMsg()); });
    document.querySelectorAll('#seg-tempo button').forEach(b=>b.onclick=()=>{ host.settings.tempo=b.dataset.t; hostBroadcast(hostLobbyMsg()); });
    document.querySelectorAll('[data-kick]').forEach(el=>el.onclick=()=>hostRemovePlayer(el.dataset.kick));
    $('lobby-hint').innerHTML = m.solo
      ? 'Adj hozzá további AI-ellenfeleket, állítsd be a játékot, és indíts!'
      : 'Küldd el a fájlt vagy a linket a barátaidnak – ők a főmenüben a <b>Csatlakozás</b> gombbal, a fenti kóddal lépnek be. (2–6 játékos, AI is jöhet.)';
  } else {
    const head=m.settings.mode==='conquest'
      ? '⚔️ <b>Hódítás</b> – '+CQ_MAPS[m.settings.mapKey||'big'].desc
      : m.settings.count+' kérdés · 🎬 az utolsó '+finalLen(m.settings.count)+' dupla pontos'+
        (m.settings.tempo==='fast'?' · ⚡ pörgős tempó':'');
    $('lobby-settings').innerHTML='<div class="hint">'+head+' · minden téma és nehézség játékban</div>';
    $('lobby-actions').innerHTML='<div class="hint"><span class="spinner"></span>Várakozás, hogy a host elindítsa a játékot…</div>';
    $('lobby-hint').textContent='';
  }
}

/* ---------------- render: kategória-sorsolás ---------------- */
function renderCatDraw(m){
  stopTimers();
  showScreen('game');
  if(m.final&&!SND.fanfared){ SND.fanfared=true; play('fanfare'); }   // a finálé kezdetét fanfár jelzi
  $('cq-wrap').classList.remove('on');
  $('g-count').textContent=(m.qi+1)+' / '+m.total;
  $('g-cat').textContent='🎲 Sorsolás';
  const gd=$('g-diff');
  gd.className='chip diffchip diff'+(m.d||3);
  gd.textContent='★'.repeat(m.d||3)+' · '+m.val+' p';
  $('g-timer-num').textContent=''; $('g-timerfill').style.width='100%'; timerUrgency(0);
  const gf=$('g-final');
  gf.className=m.final?'on':'';
  gf.textContent=m.final?('🎬 DUPLA PONTOS FINÁLÉ · az utolsó '+(m.finalLen||'')+' kérdés kétszer annyit ér'):'';
  $('g-question').textContent=''; $('g-status').innerHTML=''; $('g-reveal').innerHTML='';
  const tLabel = m.type==='mc'
    ? '🔵 <b>Kérdés-válasz</b> · '+m.val+' pont'
    : '🎯 <b>Tippelős</b> · '+m.val+' pont'+(m.val2?' · a másodiknak '+m.val2:'');
  /* haladás-infók: hanyadik kérdés, mennyi van a fináléig, mennyi maradt a blokkból */
  const fromSuf=n=>{ const d=n%10;
    if(d) return ['','ből','ből','ból','ből','ből','ból','ből','ból','ből'][d];
    return ['','ből','ból','ból','ből','ből','ból','ből','ból','ből'][(n/10)%10]||'ból'; };
  let prog='<b>'+(m.qi+1)+'.</b> kérdés a '+m.total+'-'+fromSuf(m.total);
  let note;
  if(m.final){
    note='<div class="draw-note fin">🎬 Dupla pontos finálé · '+(m.type==='mc'?'kérdés-válasz':'tippelős')+'</div>';
  } else {
    if(m.toFinal>0) prog+=' · még '+m.toFinal+' kérdés a 🎬 fináléig';
    note='<div class="draw-note">'+(m.type==='mc'
      ? 'Még '+m.mcLeft+' kérdés-válasz kártya maradt'
      : 'Még '+m.tipLeft+' tipp maradt')+'</div>';
  }
  $('g-answers').innerHTML='<div class="draw">'+
    '<div class="draw-prog">'+prog+'</div>'+
    '<div class="draw-lbl">A KÖVETKEZŐ KATEGÓRIA…</div>'+
    '<div class="draw-cat spin" id="draw-cat"><span class="ic">🎲</span><span class="nm">…</span></div>'+
    '<div class="draw-type">'+tLabel+'</div>'+ note +
    '<div class="draw-cd" id="draw-cd"></div>'+
    (me.isHost?'<button class="btn small ghost" id="draw-skip">▶ Mehet, ne várjunk</button>':'')+
    '</div>';
  if(me.isHost) $('draw-skip').onclick=()=>{ if(host&&host.phase==='catdraw') hostAsk(); };

  const box=$('draw-cat'), ic=box.querySelector('.ic'), nm=box.querySelector('.nm');
  const t0=performance.now(), spin=m.spin||1800, count=m.count||10000;
  /* tippelősnél a 9 sorsolási tétel pörög, négy válaszosnál a 23 kategória */
  const spinList = m.type==='tip' ? tipItems() : CATEGORIES;
  let last=0, step=55;
  const tick=()=>{
    const el=performance.now()-t0;
    if(el<spin){
      if(el-last>=step){                       // pörgetés, egyre lassulva
        last=el; step=55+Math.pow(el/spin,3)*260;
        const c=spinList[Math.floor(Math.random()*spinList.length)];
        ic.textContent=c.icon; nm.textContent=c.name;
        play('spin');
      }
    } else if(!box.classList.contains('hit')){
      box.classList.remove('spin'); box.classList.add('hit');
      ic.textContent=m.cat.icon; nm.textContent=m.cat.name;
      play('land');
    }
    const rem=spin+count-el;
    const cd=$('draw-cd');
    if(cd){
      if(el<spin) cd.textContent='';
      else if(rem>0){ cd.className='draw-cd'; cd.textContent=Math.ceil(rem/1000); }
      else { cd.className='draw-cd go'; cd.textContent='MEHET!'; }
    }
    $('g-timerfill').style.width=Math.max(0,(rem/(spin+count))*100)+'%';
    if(rem<=-400) return;
    view.raf=requestAnimationFrame(tick);
  };
  tick();
}

/* ---------------- render: kérdés ---------------- */
function renderQuestion(m){
  stopTimers();
  play('q');
  view={qi:m.qi,type:m.type,dur:m.dur,qStart:performance.now(),answered:false,total:m.total,raf:0,locked:false,cdT:null,mcLabels:m.options||[]};
  $('g-count').textContent = m.label ? m.label : ((m.qi+1)+' / '+m.total);
  $('g-cat').textContent=m.cat.icon+' '+m.cat.name;
  const gd=$('g-diff'), qv=m.val||QVAL[(m.d||3)-1];
  gd.className='chip diffchip diff'+(m.d||3);
  gd.textContent='★'.repeat(m.d||3)+' · '+qv+' p';
  gd.title=DIFF_NAMES[(m.d||3)-1]+' – '+qv+' pont'+(m.final?' (dupla pontos finálé)':'');
  const gf=$('g-final');
  gf.className=m.final?'on':'';
  gf.textContent=m.final?('🎬 DUPLA PONTOS FINÁLÉ · az utolsó '+(m.finalLen||'')+' kérdés kétszer annyit ér'):'';
  $('g-question').textContent=m.q;
  $('g-reveal').innerHTML='';
  if(m.type==='mc'){
    /* joker-sáv: csak a sima MC-blokkban, és csak ha van még kártyám */
    const jokBar=(m.jok&&(myJok.fifty||myJok.double))
      ? '<div class="jokbar'+(jokIntro?' intro':'')+'">'+
        '<button class="jokbtn" id="jok-fifty"'+(myJok.fifty?'':' disabled')+'>✂️ Felezés</button>'+
        '<button class="jokbtn" id="jok-double"'+(myJok.double?'':' disabled')+'>🎲 Dupla vagy semmi</button>'+
        '</div>'
      : '';
    $('g-answers').innerHTML='<div class="mcgrid">'+
      m.options.map((o,i)=>'<button class="mcbtn c'+i+'" data-i="'+i+'"><span class="shape">'+SHAPES[i]+'</span>'+esc(o)+'<span class="picks"></span></button>').join('')+
      '</div>'+jokBar+'<div class="jokmsg" id="jokmsg"></div><div class="sentmsg" id="sentmsg"></div>';
    document.querySelectorAll('.mcbtn').forEach(b=>b.onclick=()=>submitMC(+b.dataset.i));
    if(m.jok){
      const req=k=>{ jokBtnsOff();
        if(me.isHost) hostJoker(me.pid,k); else sendToHost({t:'joker',kind:k,qi:view.qi}); };
      const bf=$('jok-fifty'), bd=$('jok-double');
      if(bf) bf.onclick=()=>{ if(myJok.fifty&&!view.answered&&!view.locked) req('fifty'); };
      if(bd) bd.onclick=()=>{ if(myJok.double&&!view.answered&&!view.locked) req('double'); };
    }
  } else {
    const prize = m.val
      ? '<div class="tipprize">🎯 A legközelebbi tipp <b>'+m.val+' pont</b>'+
        (m.val2?' · a második legjobb <b>'+m.val2+' pont</b>':'')+'</div>'
      : '';
    /* tipp-joker sáv: a két számjegy-kártyából meccsenként csak egy váltható be */
    const jokBar=(m.jok&&myJok.tip)
      ? '<div class="jokbar'+(jokIntro?' intro':'')+'">'+
        '<button class="jokbtn" id="jok-first">🔢 Első számjegy</button>'+
        '<button class="jokbtn" id="jok-last">🔢 Utolsó számjegy</button>'+
        '</div>'
      : '';
    $('g-answers').innerHTML='<div class="tipbox">'+prize+'<div class="tiprow">'+
      '<input type="number" step="any" inputmode="decimal" id="tip-inp" placeholder="Tipped…">'+
      '<span class="unit">'+esc(m.unit||'')+'</span>'+
      '<button class="btn primary" id="tip-btn">🎯 Tippelek!</button></div>'+
      jokBar+'<div class="jokmsg" id="jokmsg"></div>'+
      '<div class="sentmsg" id="sentmsg"></div></div>';
    $('tip-btn').onclick=submitTip;
    if(m.jok){
      const req=k=>{ jokBtnsOff();
        if(me.isHost) hostJoker(me.pid,k); else sendToHost({t:'joker',kind:k,qi:view.qi}); };
      const b1=$('jok-first'), b2=$('jok-last');
      if(b1) b1.onclick=()=>{ if(myJok.tip&&!view.answered&&!view.locked) req('first'); };
      if(b2) b2.onclick=()=>{ if(myJok.tip&&!view.answered&&!view.locked) req('last'); };
    }
    $('tip-inp').addEventListener('keydown',e=>{ if(e.key==='Enter') submitTip(); });
    setTimeout(()=>{ try{$('tip-inp').focus();}catch(e){} },50);
  }
  if($('g-answers').querySelector('.jokbar')) jokIntro=false;   // az intro-pulzus csak egyszer fut le
  $('g-status').innerHTML=(m.players||[]).map(p=>
    '<div class="stav" data-pid="'+esc(p.pid)+'"><span class="em">'+p.avatar+'</span><span class="nm">'+esc(p.name)+'</span></div>').join('');
  const deadline=view.qStart+m.dur;
  const tick=()=>{
    const rem=deadline-performance.now();
    const f=Math.max(0,rem/m.dur);
    $('g-timerfill').style.width=(f*100)+'%';
    $('g-timer-num').textContent=Math.max(0,Math.ceil(rem/1000))+'s';
    timerUrgency(rem);
    if(rem<=0){ lockAnswers(view.answered?null:'Lejárt az idő! ⏰'); return; }
    view.raf=requestAnimationFrame(tick);
  };
  tick();
}
function jokBtnsOff(){ ['jok-fifty','jok-double','jok-first','jok-last'].forEach(id=>{ const b=$(id); if(b) b.disabled=true; }); }
/* joker-visszaigazolás a hosttól (privát üzenet) */
function jokerApply(m){
  if(m.qi!==view.qi) return;
  play('joker');
  jokBtnsOff();
  const jm=$('jokmsg');
  if(m.kind==='fifty'){
    myJok.fifty=false;
    (m.remove||[]).forEach(i=>{ const b=document.querySelectorAll('.mcbtn')[i]; if(b) b.classList.add('dis','faded'); });
    if(jm) jm.textContent = m.auto
      ? '✂️ A Felezésed automatikusan aktiválódott (utolsó sima kérdés) – két rossz válasz eltűnt!'
      : '✂️ Felezés: két rossz válasz eltűnt!';
  } else if(m.kind==='double'){
    myJok.double=false;
    if(jm) jm.textContent='🎲 Dupla vagy semmi: a helyes válasz duplát ér, a rossz (vagy elmaradt) ugyanannyit levon!';
  } else if(m.kind==='first'||m.kind==='last'){
    myJok.tip=false;                                   // a másik számjegy-kártya is odalett
    if(jm) jm.textContent='🔢 A megoldás '+(m.kind==='first'?'ELSŐ':'UTOLSÓ')+' számjegye: '+m.digit;
  }
}
function submitMC(i){
  if(view.locked||view.answered) return;
  view.answered=true;
  play('send');
  jokBtnsOff();
  const ms=Math.round(performance.now()-view.qStart);
  document.querySelectorAll('.mcbtn').forEach((b,bi)=>{ b.classList.add('dis'); if(bi===i)b.classList.add('sel'); });
  $('sentmsg').textContent='Válasz elküldve! ✔';
  sendAnswer(i,ms);
}
function submitTip(){
  if(view.locked||view.answered) return;
  const raw=($('tip-inp').value||'').replace(',','.').trim();
  const v=parseFloat(raw);
  if(!isFinite(v)){ toast('Írj be egy számot!'); return; }
  view.answered=true;
  play('send');
  jokBtnsOff();
  const ms=Math.round(performance.now()-view.qStart);
  $('tip-inp').disabled=true; $('tip-btn').disabled=true;
  $('sentmsg').textContent='Tipped elment: '+fmtNum(v)+' ✔';
  sendAnswer(v,ms);
}
function sendAnswer(value,ms){
  if(me.isHost) collectAnswer(me.pid,value,ms);
  else sendToHost({t:'answer', qi:view.qi, value, ms});
}
function lockAnswers(msgText){
  view.locked=true;
  cancelAnimationFrame(view.raf);
  jokBtnsOff();
  document.querySelectorAll('.mcbtn').forEach(b=>b.classList.add('dis'));
  const ti=$('tip-inp'); if(ti){ ti.disabled=true; const tb=$('tip-btn'); if(tb)tb.disabled=true; }
  if(msgText){ const sm=$('sentmsg'); if(sm) sm.textContent=msgText; }
}
function renderProgress(pids){
  document.querySelectorAll('.stav').forEach(el=>{
    if(pids.indexOf(el.dataset.pid)>=0) el.classList.add('done');
  });
}

/* ============================================================
   HÓDÍTÁS mód – kliensoldali megjelenítés
   ============================================================ */
let cqState=null;
let lastPickKey=null;   // hódítás: "te jössz" hang csak fordulóváltáskor szóljon
function cqMyTeam(){
  if(!cqState) return 0;
  const t=cqState.teams.find(x=>x.pid===me.pid);
  return t?t.team:0;
}
function cqTeamPl(t){ return (cqState.teams.find(x=>x.team===t))||{name:'?',avatar:'❓'}; }
function cqHexPts(cx,cy,r){
  let p='';
  for(let k=0;k<6;k++){
    const a=Math.PI/180*(60*k-90);
    p+=(k?' ':'')+(cx+r*Math.cos(a)).toFixed(1)+','+(cy+r*Math.sin(a)).toFixed(1);
  }
  return p;
}
/* 3 élet a vár alatt. A logika még NINCS bekötve, ezért a rombuszok CSAK akkor
   rajzolódnak ki, ha a host `cq` állapota tényleg küld `lives` mezőt – addig a
   térkép és a fejléc pips nélkül jelenik meg (ne ígérjen a UI olyat, ami nincs). */
function cqPips(cx,cy,team,lives){
  const S=13, G=33; let s='';
  for(let k=0;k<3;k++){
    const x=cx-G+k*G;
    s+= (k<lives)
      ? '<polygon class="pip t'+team+'" points="'+x+','+(cy-S)+' '+(x+S)+','+cy+' '+x+','+(cy+S)+' '+(x-S)+','+cy+'"/>'
      : '<polygon fill="none" stroke="#34405e" stroke-width="2.5" stroke-linejoin="round" stroke-dasharray="4 4" points="'+
        x+','+(cy-S)+' '+(x+S)+','+cy+' '+x+','+(cy+S)+' '+(x-S)+','+cy+'"/>';
  }
  return s;
}
function cqSvg(domId){
  const st=cqState, my=cqMyTeam(), M=cqM(), P=M.pos, R=M.r+3, CC=M.cc;
  const sel=(st.sub==='pick'&&st.turn===my)?(st.sel||[]):[];
  const vb=M.vb.split(' ').map(Number);
  const lives=st.lives;   // pips csak akkor, ha van tényleges élet-adat

  let s='<svg class="cqsvg" id="'+(domId||'cq-svg')+'" viewBox="'+M.vb+'" xmlns="http://www.w3.org/2000/svg">'+
    '<defs>'+
      '<filter id="cqGlow" x="-70%" y="-70%" width="240%" height="240%">'+
        '<feGaussianBlur stdDeviation="3.2" result="b"/>'+
        '<feMerge><feMergeNode in="b"/><feMergeNode in="SourceGraphic"/></feMerge></filter>'+
      '<pattern id="cqGrid" width="34" height="34" patternUnits="userSpaceOnUse">'+
        '<path d="M34 0 L0 0 0 34" fill="none" stroke="#131d33" stroke-width="1"/></pattern>'+
    '</defs>'+
    '<rect x="'+vb[0]+'" y="'+vb[1]+'" width="'+vb[2]+'" height="'+vb[3]+'" fill="url(#cqGrid)"/>';

  /* élek – a saját láncok a csapat színében izzanak (mindkét vég ugyanazé) */
  const seen={}, dead=[], live=[];
  const put=(x1,y1,x2,y2,t)=>{
    const l='<line class="lnk'+(t?' t'+t:'')+'" x1="'+x1+'" y1="'+y1+'" x2="'+x2+'" y2="'+y2+'"/>';
    (t?live:dead).push(l);
  };
  for(const t of [1,2]) for(const i of M.cadj[t])
    put(CC[t][0],CC[t][1],P[i][0],P[i][1], st.owner[i]===t?t:0);
  for(let i=0;i<M.n;i++) for(const j of M.adj[i]){
    const k=Math.min(i,j)+'-'+Math.max(i,j); if(seen[k]) continue; seen[k]=1;
    const a=st.owner[i], b=st.owner[j];
    put(P[i][0],P[i][1],P[j][0],P[j][1], (a&&a===b)?a:0);
  }
  s+='<g>'+dead.join('')+'</g><g class="glow">'+live.join('')+'</g>';

  /* semleges (szabad) területek – izzás nélkül */
  for(let i=0;i<M.n;i++) if(!st.owner[i])
    s+='<polygon class="nd" points="'+cqHexPts(P[i][0],P[i][1],R)+'"/>';

  /* várak + elfoglalt területek – egy közös izzó rétegben (olcsóbb, mint elemenként) */
  let g='';
  for(const t of [1,2]){
    g+='<polygon class="cas t'+t+'" points="'+cqHexPts(CC[t][0],CC[t][1],36)+'"/>'+
       '<polygon class="casin t'+t+'" points="'+cqHexPts(CC[t][0],CC[t][1],27)+'"/>'+
       (lives?cqPips(CC[t][0],CC[t][1]+62,t,lives[t]):'');
  }
  for(let i=0;i<M.n;i++) if(st.owner[i])
    g+='<polygon class="nd t'+st.owner[i]+'" points="'+cqHexPts(P[i][0],P[i][1],R)+'"/>';
  s+='<g class="glow">'+g+'</g>';

  /* feliratok */
  for(const t of [1,2])
    s+='<text class="cval" x="'+CC[t][0]+'" y="'+CC[t][1]+'">'+st.castle[t]+'</text>';
  for(let i=0;i<M.n;i++){
    const x=P[i][0], y=P[i][1], o=st.owner[i];
    s+= o ? '<text class="vv" x="'+x+'" y="'+y+'">'+st.val[i]+'</text>'
          : '<text class="idn" x="'+x+'" y="'+y+'">'+(i+1)+'</text>';
  }

  /* jelölések, célkereszt, választható mezők */
  for(let i=0;i<M.n;i++){
    const x=P[i][0], y=P[i][1];
    if(st.phase==='grab'){
      if(st.picks[1]===i) s+='<polygon class="mark1" points="'+cqHexPts(x,y,R+8)+'"/>';
      if(st.picks[2]===i) s+='<polygon class="mark2" points="'+cqHexPts(x,y,R+14)+'"/>';
    }
    if(st.target===i){
      s+='<g class="glow"><circle class="tgt" cx="'+x+'" cy="'+y+'" r="'+(R+13)+'">'+
         '<animateTransform attributeName="transform" type="rotate" from="0 '+x+' '+y+'" to="360 '+x+' '+y+
         '" dur="5s" repeatCount="indefinite"/></circle>';
      const d=R+19;
      for(const c of [[-1,-1],[1,-1],[-1,1],[1,1]])
        s+='<path class="brk" d="M '+(x+c[0]*d)+' '+(y+c[1]*d-c[1]*9)+' L '+(x+c[0]*d)+' '+(y+c[1]*d)+
           ' L '+(x+c[0]*d-c[0]*9)+' '+(y+c[1]*d)+'"/>';
      s+='</g>';
    }
    if(sel.indexOf(i)>=0)
      s+='<g class="glow"><polygon class="sel-ring" points="'+cqHexPts(x,y,R+7)+'"/></g>'+
         '<circle class="hit" data-cq="'+i+'" cx="'+x+'" cy="'+y+'" r="'+(R+10)+'" fill="transparent"/>';
  }

  s+='<text class="cap" x="'+(vb[0]+20)+'" y="'+(vb[1]+26)+'" text-anchor="start">FRONTVONAL // '+
     (st.phase==='war'?'HARC':st.phase==='grab'?'FOGLALAS':'VEGE')+'</text>';
  return s+'</svg>';
}
function cqBindClicks(){
  document.querySelectorAll('#cq-svg .hit').forEach(el=>el.onclick=()=>{
    if(!cqState||cqState.turn!==cqMyTeam()) return;
    const i=+el.dataset.cq;
    cqState.turn=null; cqState.sel=[];        // azonnali visszajelzés, dupla kattintás ellen
    cqRenderMap();
    $('g-question').textContent='✔ Kijelölve: '+(i+1)+'. terület';
    $('g-answers').innerHTML='<div class="cq-hint wait"><span class="spinner"></span>Várakozás…</div>';
    if(me.isHost) cqOnPick(cqMyTeam(), i); else sendToHost({t:'cqpick', idx:i});
  });
}
function cqRenderMap(){
  if(!cqState) return;
  const st=cqState, my=cqMyTeam();
  const lives=st.lives;   // pips csak akkor, ha van tényleges élet-adat
  const tm=t=>{
    const p=cqTeamPl(t), act=(st.sub==='pick'&&st.turn===t)||(st.phase==='war'&&st.atkTeam===t&&st.sub!=='pick');
    let pips='';
    if(lives){
      pips='<span class="pips">';
      for(let k=0;k<3;k++) pips+='<span class="pip"'+(k<lives[t]?'':' style="background:none;box-shadow:none;border-color:#34405e"')+'></span>';
      pips+='</span>';
    }
    return '<span class="cq-team t'+t+(act?' act':'')+'">'+p.avatar+
           '<span class="nmx">'+esc(p.name)+(t===my?' (te)':'')+'</span>'+pips+
           '<span class="tot">'+st.tot[t]+'</span></span>';
  };
  const ph = st.phase==='grab' ? ('FÁZIS 1 // FOGLALÁS · '+st.free+' szabad')
           : st.phase==='war'  ? ('FÁZIS 2 // HARC · '+st.attacks[1]+' ◈ '+st.attacks[2])
           : 'KÜLDETÉS TELJESÍTVE';
  $('cq-banner').innerHTML='<span class="cq-phase">'+ph+'</span>'+tm(1)+tm(2);
  $('cq-map').innerHTML=cqSvg();
  $('cq-log').innerHTML=st.log?esc(st.log):'';
  if(st.sub==='pick') cqBindClicks();
}
function cqRenderPickUI(){
  const st=cqState, my=cqMyTeam(), mine=(st.turn===my);
  $('g-count').textContent = st.phase==='war' ? '⚔️ HARC' : '🚩 FOGLALÁS';
  $('g-cat').textContent   = st.phase==='war' ? (CQ_TEAM_NAME[st.atkTeam]+' támad') : (st.round+'. forduló');
  $('g-diff').className='chip diffchip';
  $('g-final').className=''; $('g-final').textContent='';
  $('g-diff').textContent  = st.phase==='war' ? ('🔴 '+st.attacks[1]+' | '+st.attacks[2]+' 🔵') : (st.free+' szabad');
  if(!st.turn){
    $('g-question').textContent = st.log || 'Egy pillanat…';
    $('g-answers').innerHTML='<div class="cq-hint wait"><span class="spinner"></span>Készülj…</div>';
    $('g-status').innerHTML=''; $('g-reveal').innerHTML='';
    stopTimers(); $('g-timerfill').style.width='100%'; $('g-timer-num').textContent=''; timerUrgency(0);
    return;
  }
  const who=cqTeamPl(st.turn);
  const pkey=st.phase+':'+st.round+':'+st.turn+':'+(st.attacks?st.attacks[1]+'|'+st.attacks[2]:'');
  if(mine&&pkey!==lastPickKey) play('turn');
  lastPickKey=pkey;
  $('g-question').textContent = mine
    ? (st.phase==='war' ? '⚔️ Melyik területet támadod meg?' : '🚩 Melyik területet foglalnád el?')
    : (who.avatar+' '+who.name+' épp választ…');
  $('g-answers').innerHTML='<div class="cq-hint'+(mine?'':' wait')+'">'+
    (mine ? 'Kattints a térképen egy <b>sárgán villogó</b> területre.'
          : 'Utána te jössz – nézd a térképet!')+'</div>';
  $('g-status').innerHTML=''; $('g-reveal').innerHTML='';
  cqBar(st.pickMs||CQ_PICK_DUR);
}
function cqBar(ms){
  stopTimers();
  const t0=performance.now();
  const tick=()=>{
    const rem=ms-(performance.now()-t0), f=Math.max(0,rem/ms);
    $('g-timerfill').style.width=(f*100)+'%';
    $('g-timer-num').textContent=rem>0?(Math.ceil(rem/1000)+'s'):'';
    timerUrgency(rem);
    if(rem<=0) return;
    view.raf=requestAnimationFrame(tick);
  };
  tick();
}
function cqOnState(st){
  cqState=st;
  if(st.phase==='over') return;
  $('cq-wrap').classList.add('on');
  showScreen('game');
  cqRenderMap();
  if(st.sub==='pick') cqRenderPickUI();
}
function cqRenderReveal(m){
  stopTimers(); view.locked=true;
  cancelAnimationFrame(view.raf);
  $('g-timerfill').style.width='0%'; $('g-timer-num').textContent=''; timerUrgency(0); $('g-status').innerHTML='';
  if(m.type==='mc'){
    document.querySelectorAll('.mcbtn').forEach((b,i)=>{
      b.classList.add('dis');
      if(i===m.correctIndex) b.classList.add('correct'); else b.classList.add('faded');
      if(b.classList.contains('sel')&&i!==m.correctIndex){ b.classList.remove('faded'); b.classList.add('wrongsel'); }
    });
  } else lockAnswers(null);
  /* a saját csapatom hangja a hódítás-eredménynél */
  { const my=cqMyTeam(), a=(m.rows||[]).find(r=>r.team===my), b=(m.rows||[]).find(r=>r.team!==my);
    let s='meh';
    if(m.type==='mc'){ if(a&&a.ok) s='good'; else if(a&&a.val!=null) s='bad'; }
    else { const ad=(a&&a.dist!=null)?a.dist:null, bd=(b&&b.dist!=null)?b.dist:null;
      if(ad!=null&&(bd==null||ad<bd||(ad===bd&&a.ms<=b.ms))) s='good'; }
    play(s);
  }
  const unit=m.unit?(' '+esc(m.unit)):'';
  const correctLine = m.type==='mc'
    ? 'Helyes válasz: <b>'+esc(m.correctText)+'</b>'
    : 'Helyes válasz: <b>'+fmtNum(m.correctValue)+unit+'</b>';
  const rows=(m.rows||[]).map(r=>{
    const p=pinfo(r.pid);
    let val;
    if(m.type==='mc') val=(r.val==null)?'–':(SHAPES[r.val]+(r.ok?' ✔':' ✘'));
    else val=(r.val==null)?'– nem tippelt'
      :(fmtNum(r.val)+(r.dist>0?' <span style="color:var(--dim);font-size:.85em">(±'+fmtNum(r.dist)+')</span>':(r.dist===0?' 🎯':'')));
    const tm=(r.ms!=null)?((r.ms/1000).toFixed(1)+'s'):'';
    return '<div class="rrow'+(r.pid===me.pid?' me':'')+'"><span class="av">'+p.avatar+'</span>'+
      '<span class="nm">'+esc(p.name)+'<span class="cq-tag t'+r.team+'">'+(r.team===1?'piros':'kék')+'</span></span>'+
      '<span class="val">'+val+'</span><span class="tm">'+tm+'</span></div>';
  }).join('');
  const dl=(m.deltas||[]).map(d=>
    '<div class="cq-delta '+(d.good?'good':(d.bad?'bad':''))+'">'+esc(d.txt)+'</div>').join('');
  $('g-reveal').innerHTML='<div class="revcard">'+
    '<div class="rev-correct">'+correctLine+'</div>'+
    (m.note?'<div class="rev-note">💡 '+esc(m.note)+'</div>':'')+
    rows+'<div class="cq-deltas">'+dl+'</div></div>';
}
function cqRenderEnd(m){
  stopTimers();
  cqState=m.st;
  const t1=m.tot[1], t2=m.tot[2], win=(t1===t2)?0:(t1>t2?1:2);
  const card=t=>{
    const p=cqTeamPl(t), owned=m.st.owner.filter(o=>o===t).length;
    return '<div class="cq-fcard t'+t+(win===t?' win':'')+'">'+
      '<div style="font-size:1.7rem">'+p.avatar+'</div>'+
      '<div style="font-weight:800">'+esc(p.name)+(win===t?' 👑':'')+'</div>'+
      '<div class="big">'+(t===1?t1:t2)+'</div>'+
      '<div class="sub">'+owned+' terület · vár '+m.st.castle[t]+'</div></div>';
  };
  $('podium').innerHTML='<div class="cq-final">'+card(1)+card(2)+'</div>';
  $('end-list').innerHTML='<div class="cq-hint">'+(win?(CQ_TEAM_NAME[win]+' nyerte a hódítást!'):'Döntetlen! 🤝')+'</div>'+
    '<div style="margin-top:12px">'+cqSvg('cq-endsvg')+'</div>';
  $('end-actions').innerHTML = me.isHost
    ? '<button class="btn primary" id="btn-rematch">🔁 Új meccs (vissza a lobbyba)</button>'+
      '<button class="btn ghost" id="btn-exit">🏠 Főmenü</button>'
    : '<div class="hint"><span class="spinner"></span>A host indíthat új meccset…</div>'+
      '<button class="btn ghost" id="btn-exit">🚪 Kilépés a főmenübe</button>';
  if(me.isHost) $('btn-rematch').onclick=hostRematch;
  $('btn-exit').onclick=resetAll;
  if(win){ confettiBurst(); play('win'); }     // döntetlennél nincs konfetti/fanfár
}

/* Saját sorozat visszajelzése a 4 válaszos kérdések után (klasszikus mód).
   Csak 2+ hosszú sorozatnál jelenik meg; a fináléban egyáltalán nem. */
function streakBlock(m){
  if(m.type!=='mc'||m.final) return '';
  const r=(m.results||[]).find(x=>x.pid===me.pid);
  if(!r) return '';
  if(r.broke) return '<div class="strk-line broke">💔 Megszakadt a '+r.broke+'-es sorozatod</div>';
  if(r.streak<2) return '';
  const next=streakMult(r.streak+1), maxed=(next<=r.mult&&r.mult>1);
  const s=Math.min(r.streak,STREAK_MULT.length);   // 7+ sorozatnál az utolsó (1,9×) chip marad kiemelve
  const scale=STREAK_MULT.map((v,i)=>{
    const n=i+1, cls=(n===s)?'now':(n<s?'on':'');
    return '<span class="'+cls+'">'+fmtMult(v)+'</span>';
  }).join('');
  return '<div class="strk-line">🔥 '+r.streak+' helyes válasz egymás után · '+
    (maxed ? 'a szorzód a csúcson: '+fmtMult(r.mult)
           : 'a következő helyes válasz '+fmtMult(next)+' szorzót ér')+
    '</div><div class="strk-scale">'+scale+'</div>';
}

/* ---------------- render: eredmény ---------------- */
function renderReveal(m){
  stopTimers(); view.locked=true;
  cancelAnimationFrame(view.raf);
  $('g-timerfill').style.width='0%'; $('g-timer-num').textContent=''; timerUrgency(0);
  $('g-status').innerHTML='';
  if(m.type==='mc'){
    document.querySelectorAll('.mcbtn').forEach((b,i)=>{
      b.classList.add('dis');
      if(i===m.correctIndex) b.classList.add('correct');
      else b.classList.add('faded');
      if(b.classList.contains('sel')&&i!==m.correctIndex){ b.classList.remove('faded'); b.classList.add('wrongsel'); }
    });
    m.results.forEach(r=>{
      if(r.val==null) return;
      const b=document.querySelectorAll('.mcbtn')[r.val];
      if(b) b.querySelector('.picks').textContent+=pinfo(r.pid).avatar;
    });
  } else {
    lockAnswers(null);
  }
  /* a saját eredményem hangja: nyertem / 2. hely / hibáztam / semleges */
  { const r0=(m.results||[]).find(r=>r.pid===me.pid);
    if(r0){
      if(r0.win) play('good');
      else if(r0.second) play('small');
      else if(r0.pts<0||(m.type==='mc'&&r0.val!=null&&!r0.ok)) play('bad');
      else play('meh');
    } }
  const unit=m.unit?(' '+esc(m.unit)):'';
  let rows;
  if(m.type==='mc'){
    rows=m.results.slice().sort((a,b)=>(b.pts-a.pts)||((a.ms==null)-(b.ms==null))||(a.ms-b.ms));
  } else {
    rows=m.results.slice().sort((a,b)=>((a.dist==null)-(b.dist==null))||(a.dist-b.dist)||(a.ms-b.ms));
  }
  const rowsHtml=rows.map(r=>{
    const p=pinfo(r.pid);
    let val;
    if(m.type==='mc') val=(r.val==null)?'–':(SHAPES[r.val]+(r.ok?' ✔':' ✘'));
    else val=(r.val==null)?'– nem tippelt':(fmtNum(r.val)+(r.dist!=null&&r.dist>0?' <span style="color:var(--dim);font-size:.85em">(±'+fmtNum(r.dist)+')</span>':r.dist===0?' 🎯':''));
    const tm=(r.ms!=null)?((r.ms/1000).toFixed(1)+'s'):'';
    const pts=r.pts>0?('+'+r.pts):(r.pts<0?String(r.pts):'0');
    const strk=(r.mult>1)?'<span class="strk">🔥'+fmtMult(r.mult)+'</span>':'';
    const jk=r.jok==='double'?'<span class="jk" title="Dupla vagy semmi">🎲</span>'
            :(r.jok==='fifty'?'<span class="jk" title="Felezés">✂️</span>'
            :((r.jok==='first'||r.jok==='last')?'<span class="jk" title="Számjegy-joker">🔢</span>':''));
    const rk=r.win?'<span class="rk">👑</span>':(r.second?'<span class="rk">🥈</span>':'');
    return '<div class="rrow'+(r.win?' win':(r.second?' second':''))+(r.pid===me.pid?' me':'')+'">'+
      '<span class="av">'+p.avatar+'</span><span class="nm">'+esc(p.name)+'</span>'+rk+jk+
      '<span class="val">'+val+'</span><span class="tm">'+tm+'</span>'+strk+
      '<span class="pts'+(r.pts>0?'':(r.pts<0?' neg':' zero'))+'">'+pts+'</span></div>';
  }).join('');
  const standings=m.players.slice().sort((a,b)=>b.score-a.score).map((p,i)=>{
    const med=i===0?'🥇':i===1?'🥈':i===2?'🥉':'';
    const fl=(!m.final&&p.streak>=2)?'<span class="fl">'+p.streak+'🔥</span>':'';   // a fináléban nincs sorozat-jelzés; szám ELÖL, hogy ne folyjon egybe a pontszámmal
    return '<span class="sc">'+med+p.avatar+' '+esc(p.name)+fl+' <span class="s">'+p.score+'</span></span>';
  }).join('');
  const correctLine = m.type==='mc'
    ? 'Helyes válasz: <b>'+esc(m.correctText)+'</b>'
    : 'Helyes válasz: <b>'+fmtNum(m.correctValue)+unit+'</b>';
  $('g-reveal').innerHTML='<div class="revcard">'+
    '<div class="rev-correct">'+correctLine+'</div>'+
    (m.note?'<div class="rev-note">💡 '+esc(m.note)+'</div>':'')+
    (m.tie?'<div class="rev-tie">⚡ Holtverseny volt – a gyorsabb tipp vitte a pontot!</div>':'')+
    rowsHtml+ streakBlock(m) +
    '<div class="standings">'+standings+'</div>'+
    '<div class="nextzone">'+
      (me.isHost?'<button class="btn small primary" id="btn-next">▶ '+(m.last?'Eredményhirdetés':'Következő')+'</button>':'')+
      '<span class="countdown" id="cd"></span>'+
    '</div></div>';
  if(me.isHost) $('btn-next').onclick=hostAdvance;
  const t0=performance.now(), total=m.autoNextIn;
  clearInterval(view.cdT);
  view.cdT=setInterval(()=>{
    const rem=Math.max(0,total-(performance.now()-t0));
    const cd=$('cd');
    if(cd) cd.textContent=(m.last?'Eredményhirdetés':'Következő kérdés')+' '+Math.ceil(rem/1000)+' mp múlva…';
    if(rem<=0) clearInterval(view.cdT);
  },250);
}

/* ---- konfetti a végeredményhez (canvas, könyvtár nélkül, ~3,4 mp) ---- */
let confettiCv=null;
function confettiBurst(){
  if(window.matchMedia&&matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  if(confettiCv){ try{confettiCv.remove();}catch(e){} confettiCv=null; }
  const cv=document.createElement('canvas'); confettiCv=cv;
  cv.style.cssText='position:fixed;inset:0;width:100%;height:100%;pointer-events:none;z-index:98;';
  cv.width=innerWidth; cv.height=innerHeight;
  document.body.appendChild(cv);
  const ctx=cv.getContext('2d');
  const COLS=['#fbbf24','#f472b6','#8b5cf6','#22c55e','#00e5ff','#ff2e63','#fde68a'];
  const P=[];
  for(let i=0;i<140;i++) P.push({
    x:Math.random()*cv.width, y:-20-Math.random()*cv.height*0.5,
    w:5+Math.random()*6, h:8+Math.random()*8,
    vy:1.6+Math.random()*2.6, vx:-1+Math.random()*2,
    rot:Math.random()*Math.PI, vr:-0.12+Math.random()*0.24,
    c:COLS[i%COLS.length], sw:Math.random()*Math.PI*2});
  const t0=performance.now();
  (function fall(){
    if(confettiCv!==cv){ cv.remove(); return; }
    const el=performance.now()-t0;
    ctx.clearRect(0,0,cv.width,cv.height);
    ctx.globalAlpha=Math.max(0,Math.min(1,(3400-el)/700));
    for(const p of P){
      p.y+=p.vy; p.x+=p.vx+Math.sin(p.sw+=0.06)*0.8; p.rot+=p.vr;
      ctx.save(); ctx.translate(p.x,p.y); ctx.rotate(p.rot);
      ctx.fillStyle=p.c; ctx.fillRect(-p.w/2,-p.h/2,p.w,p.h); ctx.restore();
    }
    if(el<3400) requestAnimationFrame(fall);
    else { cv.remove(); confettiCv=null; }
  })();
}

/* ---------------- render: végeredmény ---------------- */
function renderEnd(m){
  stopTimers();
  const r=m.ranking;
  const podOrder=[1,0,2].filter(i=>i<r.length);
  $('podium').innerHTML=podOrder.map(i=>{
    const p=r[i];
    return '<div class="pod p'+(i+1)+'"><span class="em">'+p.avatar+'</span>'+
      '<span class="nm">'+esc(p.name)+'</span><span class="scr">'+p.score+' pont</span>'+
      '<div class="base">'+(i+1)+'.</div></div>';
  }).join('');
  const awards=(m.awards||[]).map(a=>
    '<div class="aw'+(a.sub?' wsub':'')+'"><span class="ic">'+a.icon+'</span>'+
    '<span class="ti">'+esc(a.title)+'</span>'+
    '<span class="wh">'+a.avatars.join('')+' '+esc(a.names.join(', '))+'</span>'+
    '<span class="vl">'+esc(a.value)+'</span>'+
    (a.sub?'<span class="sb">'+esc(a.sub)+'</span>':'')+'</div>').join('');
  $('end-list').innerHTML=r.map((p,i)=>
    '<div class="rrow'+(p.pid===me.pid?' me':'')+'"><span class="av">'+p.avatar+'</span>'+
    '<span class="nm">'+(i+1)+'. '+esc(p.name)+(p.isAI?' 🤖':'')+'</span>'+
    ((p.best||0)>=2?'<span class="strk">'+p.best+'🔥</span>':'')+
    '<span class="pts">'+p.score+' pont</span></div>').join('')+
    (awards?'<div class="awards"><div class="hd">📊 A meccs díjai</div>'+awards+'</div>':'');
  $('end-actions').innerHTML= me.isHost
    ? '<button class="btn primary" id="btn-rematch">🔁 Új meccs (vissza a lobbyba)</button>'+
      '<button class="btn ghost" id="btn-exit">🏠 Főmenü</button>'
    : '<div class="hint"><span class="spinner"></span>A host indíthat új meccset…</div>'+
      '<button class="btn ghost" id="btn-exit">🚪 Kilépés a főmenübe</button>';
  if(me.isHost) $('btn-rematch').onclick=hostRematch;
  $('btn-exit').onclick=resetAll;
  confettiBurst();
  play('win');
}

/* ---------------- indítás ---------------- */
function boot(){
  $('ver-note').textContent='Játékverzió: v'+MY_PROTO+' · együtt játszani csak azonos verzióval lehet';
  $('avatars').innerHTML=AVATARS.map((a,i)=>'<button data-a="'+a+'" class="'+(i===0?'sel':'')+'">'+a+'</button>').join('');
  document.querySelectorAll('#avatars button').forEach(b=>b.onclick=()=>{
    document.querySelectorAll('#avatars button').forEach(x=>x.classList.remove('sel'));
    b.classList.add('sel'); me.avatar=b.dataset.a;
  });
  $('inp-code').addEventListener('input',()=>{ $('inp-code').value=$('inp-code').value.toUpperCase().replace(/[^A-Z0-9]/g,''); });
  $('inp-code').addEventListener('keydown',e=>{ if(e.key==='Enter') joinRoom(); });
  $('btn-create').onclick=createRoom;
  $('btn-join').onclick=joinRoom;
  $('btn-solo').onclick=startSolo;
  $('btn-rules').onclick=()=>showScreen('rules');
  $('btn-rules-back').onclick=()=>showScreen('menu');
  /* hangok: az AudioContext az ELSŐ gesztusra jön létre (mobil autoplay-szabály),
     és minden további gesztus felébreszti, ha a böngésző felfüggesztette */
  const sndWake=()=>{ sndInit(); sndResume(); };
  window.addEventListener('pointerdown',sndWake,true);
  window.addEventListener('keydown',sndWake,true);
  const sb=$('snd-btn');
  sb.onclick=()=>{ sndInit(); SND.on=!SND.on;
    sb.textContent=SND.on?'🔊':'🔇'; sb.classList.toggle('off',!SND.on);
    sb.title=SND.on?'Hangok némítása':'Hangok bekapcsolása';
    if(SND.on) play('send'); };
  /* gyors "búcsúüzenet" lapbezáráskor, hogy a többiek ne várjanak percekig */
  window.addEventListener('pagehide',()=>{
    try{
      if(net.mode==='guest'&&net.conn) net.conn.send({t:'bye'});
      else if(net.mode==='host') for(const pid in net.conns) net.conns[pid].send({t:'hostbye'});
    }catch(e){}
  });
}
boot();

</script>
</body>
</html>
