<script>
"use strict";
// KvízParty kérdésbázis – 1/5 darab (a build fűzi össze; kategóriák: 1–5)
// ============================================================
// KvízParty – kérdésbázis (1333 kérdés = 959 „1 a 4-ből” + 374 tippelős, 23 kategória)
// Nehézség (d): 1=nagyon könnyű, 2=könnyű, 3=közepes, 4=nehéz, 5=extra nehéz
// mc:  {cat, type, d, q, o:[4 opció], c:0 (a helyes mindig az első, a játék kever)}
// tip: {cat, type, d, q, a:szám, unit, note}
// A kategória-terv: design/kategoriak.md · tippelős tételek: design/tipp_kategoriak.md
// ============================================================

const CATEGORIES = [
 {"id":1, "name":"Magyar történelem", "icon":"🏰", "tip":true},
 {"id":2, "name":"Magyar irodalom", "icon":"📜", "tip":false},
 {"id":3, "name":"Magyarország földrajza", "icon":"🗺️", "tip":true, "tipg":"foldrajz"},
 {"id":4, "name":"Magyar nyelv és szólások", "icon":"🗣️", "tip":false},
 {"id":5, "name":"Magyar néphagyomány", "icon":"🎎", "tip":false},
 {"id":6, "name":"Gasztronómia", "icon":"🌶️", "tip":false},
 {"id":7, "name":"Világtörténelem", "icon":"⚔️", "tip":true},
 {"id":8, "name":"Világföldrajz", "icon":"🌍", "tip":true, "tipg":"foldrajz"},
 {"id":9, "name":"Világirodalom", "icon":"📖", "tip":false},
 {"id":10, "name":"Képzőművészet", "icon":"🖼️", "tip":false},
 {"id":11, "name":"Filozófia", "icon":"🧠", "tip":false},
 {"id":12, "name":"Állatok", "icon":"🦁", "tip":true},
 {"id":13, "name":"Növények és kertészet", "icon":"🌿", "tip":true},
