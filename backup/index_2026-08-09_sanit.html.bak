QUESTIONS.forEach((q,i)=>q.id=i);

const FAST = location.hash.indexOf('fast')>=0;   // teszt mód: #fast
const MC_DUR   = FAST?3000:20000;
const TIP_DUR  = FAST?3500:25000;
const REVEAL_AUTO = FAST?1800:7000;
/* Kategória-sorsolás minden kérdés előtt: pörgetés, majd visszaszámlálás.
   Ettől minden kategória egyenlő eséllyel jön, akárhány kérdés van benne.
   Kategória-szűrő NINCS (2026-08-08-án kivezetve): minden téma mindig játékban van. */
const CAT_SPIN_MS  = FAST?400:1800;
const CAT_COUNT_MS      = FAST?700:10000;   // 🐢 Nyugodt tempó (alapértelmezés)
const CAT_COUNT_FAST_MS = FAST?700:4000;    // ⚡ Pörgős tempó (lobby-kapcsoló)
function catCountMs(){ return (host&&host.settings&&host.settings.tempo==='fast') ? CAT_COUNT_FAST_MS : CAT_COUNT_MS; }
const MAXP = 6;
/* Kérdésérték nehézség szerint: 1★=75, 2★=90, 3★=100, 4★=110, 5★=125 pont */
const QVAL = [75, 90, 100, 110, 125];
const MC_SPEED_BONUS = 0.20;   // "1 a 4-ből": max +20% gyorsasági bónusz
const TIP_EXACT_BONUS = 0.25;  // tippelős: telitalálat +25%
/* Tippelős kérdésérték a mezőny méretétől függően (klasszikus mód):
   minél többen tippelnek, annál nehezebb a legközelebbinek lenni, ezért többet is ér.
   A MÁSODIK legjobb tipp is pontot kaphat: 3 játékosnál a normál kérdésérték 40%-át,
   4 játékostól a teljes normál kérdésértéket. A fináléban V már duplázott, ezért ott
   a második 3 főnél a normál érték 0,8-szeresét, 4 főtől a kétszeresét kapja. */
const TIP_PLAYER_MULT = {2:1.00, 3:1.25, 4:1.50, 5:1.75, 6:2.00};
const TIP_SECOND_MULT = {2:0, 3:0.40, 4:1.00, 5:1.00, 6:1.00};
function activePlayers(){ return host.players.filter(p=>p.isAI||p.connected!==false).length; }
function tipMultNow(){ return TIP_PLAYER_MULT[Math.max(2,Math.min(6,activePlayers()))]; }
function tipSecondNow(){ return TIP_SECOND_MULT[Math.max(2,Math.min(6,activePlayers()))]; }
/* Sorozat-bónusz (CSAK a klasszikus módban, CSAK a „4 válaszos” kérdéseken).
   Az n-edik egymás utáni helyes válasz szorzója; az első KÉT találatnak nincs
   bónusza, a szorzó a 3.-tól indul, és a 6. után nem nő tovább (plafon 1,90×).
   A tippelős kérdés semleges: nem folytatja és nem is töri meg a sorozatot,
   és a rajta szerzett pont nem kap szorzót.
   A DUPLA PONTOS FINÁLÉ szintén sorozat-semleges: ott csak a dupla érték él,
   a sorozat se nem épül, se nem szakad, és a szorzó sem érvényesül. */
const STREAK_MULT = [1.00, 1.00, 1.30, 1.50, 1.70, 1.90];
/* A pakli felépítése és SORRENDJE (csak klasszikus mód).
   Előbb az összes sima „4 válaszos” kérdés egymás után – így a sorozat jól követhető –,
   utána a sima tippelősök, végül a DUPLA PONTOS blokk (előbb MC, aztán tipp).
   A tippelős és a finálé is semleges a sorozatra nézve: a szorzó a sima MC-blokkban
   érvényesül, a finálé jutalma pedig maga a dupla érték. */
const Q_PLAN = {
  10: { mc: 5,  tip: 3,  fmc: 1, ftip: 1 },
  15: { mc: 7,  tip: 5,  fmc: 2, ftip: 1 },
  20: { mc: 10, tip: 6,  fmc: 2, ftip: 2 },
  30: { mc: 14, tip: 10, fmc: 4, ftip: 2 },
};
const Q_COUNTS = Object.keys(Q_PLAN).map(Number).sort((a,b)=>a-b);
function qPlan(n){ return Q_PLAN[n] || Q_PLAN[15]; }
function finalLen(n){ const p=Q_PLAN[n]; return p ? p.fmc+p.ftip : 0; }
function streakMult(n){ return STREAK_MULT[Math.min(Math.max(n|0,1), STREAK_MULT.length)-1]; }
function fmtMult(m){ return m.toFixed(2).replace('.',',').replace(/,?0+$/,'')+'×'; }
/* ---- AI-szintek ----------------------------------------------------------
   p[]  : találati esély a „4 válaszos” kérdésre nehézségenként (d1..d5)
