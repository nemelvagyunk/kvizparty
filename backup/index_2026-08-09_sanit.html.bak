{cat:13,type:'tip',d:2,q:"Hány sziromlevele van a vadrózsának?",a:5,unit:"db",note:"Az öttagú virág a rózsafélék családjának ismertetőjegye."},
{cat:13,type:'tip',d:2,q:"Átlagosan hány szem borsó van egy hüvelyben?",a:7,unit:"szem",note:"Általában 5-8 szem sorakozik egy hüvelyben."},
{cat:13,type:'tip',d:2,q:"Hány gerezdből áll egy átlagos fej fokhagyma?",a:10,unit:"gerezd",note:"Fajtától függően 8-12 gerezd bújik meg egy fejben."},
{cat:13,type:'tip',d:2,q:"Hány méter magasra nő a jegenyenyár?",a:30,unit:"m",note:"Gyökerei messzire kúsznak, ezért házak közelébe nem ültetik."},
{cat:13,type:'tip',d:2,q:"Hány százalék víz van a friss uborkában?",a:96,unit:"%",note:"Az egyik legmagasabb víztartalmú zöldségünk."},
{cat:13,type:'tip',d:2,q:"Hány évgyűrűt növeszt a fa törzse évente?",a:1,unit:"db",note:"A világos tavaszi és a sötét őszi pászta együtt ad ki egy gyűrűt."},
{cat:13,type:'tip',d:3,q:"Hány éves korában fordul termőre a magról nevelt diófa?",a:10,unit:"év",note:"A mondás szerint a diófát az unokáinknak ültetjük."},
{cat:13,type:'tip',d:3,q:"Hány nap alatt kel ki a retek magja?",a:4,unit:"nap",note:"Az egyik leggyorsabban csírázó konyhakerti növény."},
{cat:13,type:'tip',d:3,q:"Hány centiméter mélyre ültetjük ősszel a tulipánhagymát?",a:15,unit:"cm",note:"Ökölszabály: a hagyma magasságának háromszorosa a jó mélység."},
{cat:13,type:'tip',d:3,q:"Hány hónap telik el az őszi búza vetésétől az aratásig?",a:9,unit:"hónap",note:"Ősszel vetik, átteleltetik, és a következő nyáron aratják."},
{cat:13,type:'tip',d:3,q:"Hány centimétert nőhet naponta az óriásbambusz?",a:90,unit:"cm",note:"A világ leggyorsabban növő növénye – szinte szemmel látható a növekedése."},
{cat:13,type:'tip',d:3,q:"Hány évig élhet a kocsányos tölgy?",a:500,unit:"év",note:"A matuzsálemi példányok az ezer évet is megérhetik."},
{cat:13,type:'tip',d:3,q:"Hány nap alatt dugja ki csíráját a földből a vetett bab?",a:7,unit:"nap",note:"A kerti vetemények közül az egyik leglátványosabban kel."},
{cat:13,type:'tip',d:3,q:"Hány kilogramm almát terem egy kifejlett almafa egy jó évben?",a:100,unit:"kg",note:"Egy idős, nagy koronájú fa ennek a többszörösét is hozhatja."},
{cat:13,type:'tip',d:3,q:"Hány éves korától terem a frissen telepített szőlő?",a:3,unit:"év",note:"Az első két évben a tőke erősödik, csak azután hoz fürtöket."},
{cat:13,type:'tip',d:3,q:"Hány méter mélyre hatol le a lucerna gyökérzete?",a:5,unit:"m",note:"Szárazságban akár tíz méter mélyről is szerez vizet."},
{cat:13,type:'tip',d:3,q:"Hány méter hosszúra nő a sütőtök indája egy nyár alatt?",a:10,unit:"m",note:"Ha hagyják, az egész kertet befutja."},
{cat:13,type:'tip',d:3,q:"Hány kilogramm paradicsom terem egy tőről egy szezonban?",a:5,unit:"kg",note:"Gondos kötözéssel és öntözéssel ennél több is elérhető."},
{cat:13,type:'tip',d:3,q:"Hány százalék cukrot tartalmaz az érett szőlő mustja?",a:20,unit:"%",note:"Ezt méri a szüretkor emlegetett mustfok."},
{cat:13,type:'tip',d:3,q:"Hány méter magasra kúszik fel a komló egyetlen nyár alatt?",a:6,unit:"m",note:"A sörfőzés fontos növénye villámgyorsan futja be a támrendszert."},
{cat:13,type:'tip',d:3,q:"Hány mag van egy átlagos almában?",a:10,unit:"db",note:"Öt magrekesze van, mindegyikben általában két maggal."},
{cat:13,type:'tip',d:3,q:"Hány napig virágzik az akác, a méhészek legfontosabb mézelő fája?",a:10,unit:"nap",note:"Ezalatt gyűjtik a méhek az akácméz javát."},
{cat:13,type:'tip',d:4,q:"Hány százalék olajat tartalmaz a napraforgómag?",a:40,unit:"%",note:"A legjobb fajtákban a fele is olaj lehet."},
{cat:13,type:'tip',d:4,q:"Hány centiméter átmérőjű a világ legnagyobb virága, az óriás Rafflesia?",a:100,unit:"cm",note:"Méteres virága van, és dögszagával csalogatja a legyeket."},
{cat:13,type:'tip',d:4,q:"Hány éves a legidősebb ismert szálkásfenyő, a Matuzsálem nevű példány?",a:4800,unit:"év",note:"Már állt, amikor az egyiptomi piramisok épültek."},
{cat:13,type:'tip',d:4,q:"Hány liter vizet párologtat el egy nagy lombos fa egy forró nyári napon?",a:400,unit:"liter",note:"Ezért érezni hűvösebbnek a levegőt egy öreg fa alatt."},
{cat:13,type:'tip',d:4,q:"Hány szem van egy átlagos kukoricacsövön?",a:800,unit:"szem",note:"A szemek mindig páros számú sorban ülnek a csutkán."},
{cat:13,type:'tip',d:4,q:"Hány méter magas volt a valaha mért legmagasabb napraforgó?",a:9,unit:"m",note:"A rekordot egy német kertész állította fel 2014-ben."},
{cat:13,type:'tip',d:4,q:"Hány méter magas volt felfedezésekor a világ legmagasabb ismert fája, a Hyperion nevű parti mamutfenyő?",a:115,unit:"m",note:"2006-ban találták Kaliforniában; pontos helyét titokban tartják."},
{cat:13,type:'tip',d:4,q:"Hány ezer évvel ezelőtt kezdte el az ember termeszteni a búzát?",a:10,unit:"ezer éve",note:"A Közel-Kelet „termékeny félholdján” kezdődött a földművelés."},
{cat:13,type:'tip',d:5,q:"Hány év után is képes még kicsírázni a lótusz magja?",a:1000,unit:"év",note:"Egy 1300 éves, tómederből előkerült magot sikerült kicsíráztatni."},
{cat:13,type:'tip',d:5,q:"Hány méter mélyre hatolt le a valaha mért legmélyebb fagyökér, egy dél-afrikai vadfügéé?",a:120,unit:"m",note:"Egy barlangban bukkantak rá a mélybe kúszó gyökerekre."},
{cat:13,type:'tip',d:5,q:"Hány kilogrammos a Seychelle-pálma magja, a növényvilág legnagyobb magja?",a:20,unit:"kg",note:"A coco de mer beérése hat-hét évig tart."},
{cat:13,type:'tip',d:5,q:"Hány másodperc alatt csukja össze leveleit az érintésre érzékeny mimóza?",a:1,unit:"mp",note:"A gyors mozgás a növényvilágban ritka kivétel."},

