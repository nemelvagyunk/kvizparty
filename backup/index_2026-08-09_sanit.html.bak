{cat:1,type:'tip',d:3,q:"Melyik évben lépett trónra I. (Szent) László király?",a:1077,unit:"",note:"A lovagkirályt 1192-ben avatták szentté."},
{cat:1,type:'tip',d:3,q:"Melyik évben hunyt el Kossuth Lajos?",a:1894,unit:"",note:"Torinóban, emigrációban halt meg; temetése nemzeti gyásznap volt."},
