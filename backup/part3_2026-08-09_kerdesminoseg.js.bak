// – tippelős (40 db) –
{cat:14,type:'tip',d:1,q:"Hány bolygó kering a Naprendszerben?",a:8,unit:"db",note:"A Plútót 2006-ban törpebolygóvá minősítették át."},
{cat:14,type:'tip',d:1,q:"Hány Celsius-fokon forr a víz normál légnyomáson?",a:100,unit:"°C",note:"Magas hegyekben a kisebb légnyomás miatt alacsonyabb hőfokon forr."},
{cat:14,type:'tip',d:1,q:"Hány színe van a szivárványnak?",a:7,unit:"db",note:"Vörös, narancs, sárga, zöld, kék, indigó és ibolya."},
{cat:14,type:'tip',d:1,q:"Hány érzékszerve van az embernek a hagyományos felosztás szerint?",a:5,unit:"db",note:"Látás, hallás, szaglás, ízlelés és tapintás."},
{cat:14,type:'tip',d:2,q:"Hány csontja van egy felnőtt embernek?",a:206,unit:"db",note:""},
{cat:14,type:'tip',d:2,q:"Hány km/s a fény sebessége vákuumban?",a:299792,unit:"km/s",note:"kb. 300 000 km/s"},
{cat:14,type:'tip',d:2,q:"A felnőtt emberi test hány százaléka víz körülbelül?",a:60,unit:"%",note:""},
{cat:14,type:'tip',d:2,q:"Hány fogból áll a felnőtt ember teljes fogazata a bölcsességfogakkal együtt?",a:32,unit:"db",note:"A tejfogazat ezzel szemben csak 20 fogból áll."},
{cat:14,type:'tip',d:2,q:"Hány Celsius-fok az egészséges ember testhőmérséklete?",a:37,unit:"°C",note:"Napszaktól függően néhány tized fokot ingadozik."},
{cat:14,type:'tip',d:2,q:"Hány liter vér kering egy felnőtt ember testében?",a:5,unit:"liter",note:"A testtömeg nagyjából 7-8 százaléka vér."},
{cat:14,type:'tip',d:2,q:"Hány kamrája van az emberi szívnek?",a:4,unit:"db",note:"Két pitvar és két kamra dolgozik összehangoltan."},
{cat:14,type:'tip',d:2,q:"Hány másodperc alatt tesz meg a hang egy kilométert a levegőben?",a:3,unit:"mp",note:"Ezért számolhatod ki a villámlás távolságát a dörgésig eltelt időből."},
{cat:14,type:'tip',d:3,q:"Hány elemet tartalmaz jelenleg a periódusos rendszer?",a:118,unit:"",note:"az utolsó az oganeszon"},
{cat:14,type:'tip',d:3,q:"Hány pár bordája van az embernek?",a:12,unit:"pár",note:"Az alsó két pár az úgynevezett lengőborda."},
{cat:14,type:'tip',d:3,q:"Hány kromoszóma található az ember testi sejtjeiben?",a:46,unit:"db",note:"23 párba rendeződnek."},
{cat:14,type:'tip',d:3,q:"Hány perc alatt ér a napfény a Napból a Földre?",a:8,unit:"perc",note:"Pontosabban körülbelül 8 perc 20 másodperc alatt."},
{cat:14,type:'tip',d:3,q:"Hány nap alatt kerüli meg a Hold a Földet?",a:27,unit:"nap",note:"Pontosabban 27,3 nap a sziderikus keringési idő."},
{cat:14,type:'tip',d:3,q:"A Föld felszínének hány százalékát borítja víz?",a:71,unit:"%",note:"Ezért nevezik a Földet kék bolygónak."},
{cat:14,type:'tip',d:3,q:"Hány proton található a szénatom magjában?",a:6,unit:"db",note:"A protonok száma adja meg az elem rendszámát."},
{cat:14,type:'tip',d:3,q:"Hány izom van az emberi testben?",a:600,unit:"db",note:"A legnagyobb a farizom, a legkisebb a fülben található kengyelizom."},
{cat:14,type:'tip',d:3,q:"Hányszor dobban az emberi szív egy nap alatt?",a:100000,unit:"db",note:"Egy élet alatt több mint hárommilliárd dobbanás."},
{cat:14,type:'tip',d:3,q:"Hány Hz a legmagasabb hang, amit az emberi fül még hall?",a:20000,unit:"Hz",note:"A kutyák és a denevérek ennél jóval magasabb hangokat is hallanak."},
{cat:14,type:'tip',d:3,q:"Hány proton van az oxigénatom magjában?",a:8,unit:"db",note:"A protonok száma adja az elem rendszámát a periódusos rendszerben."},
{cat:14,type:'tip',d:3,q:"Hány liter levegőt lélegzik be egy felnőtt ember percenként, nyugalomban?",a:8,unit:"liter",note:"Terhelés alatt ennek a tízszerese is lehet."},
{cat:14,type:'tip',d:3,q:"Hány földi nap alatt kerüli meg a Mars a Napot?",a:687,unit:"nap",note:"Egy marsi év csaknem két földi évig tart."},
{cat:14,type:'tip',d:3,q:"Hány csigolyából áll az emberi gerinc?",a:33,unit:"db",note:"Ebből a keresztcsonti és farkcsonti csigolyák felnőttkorra összecsontosodnak."},
{cat:14,type:'tip',d:3,q:"Hány milliárd éves a világegyetem?",a:14,unit:"milliárd év",note:"A mérések szerint pontosabban 13,8 milliárd éves."},
{cat:14,type:'tip',d:3,q:"A test energiafelhasználásának hány százalékát fogyasztja el az agy?",a:20,unit:"%",note:"Pedig a testtömegnek csupán két százalékát teszi ki."},
{cat:14,type:'tip',d:4,q:"Hány Celsius-fok az abszolút nulla, az elérhető legalacsonyabb hőmérséklet?",a:-273,unit:"°C",note:"Pontosan −273,15 °C, ami 0 kelvinnek felel meg."},
{cat:14,type:'tip',d:4,q:"Hány km/s a szökési sebesség a Föld felszínén?",a:11,unit:"km/s",note:"Pontosabban kb. 11,2 km/s kell a Föld vonzásának elhagyásához."},
{cat:14,type:'tip',d:4,q:"Hány év a Halley-üstökös keringési ideje?",a:76,unit:"év",note:"Legutóbb 1986-ban járt a Föld közelében, legközelebb 2061-ben tér vissza."},
{cat:14,type:'tip',d:4,q:"Hány km/s sebességgel kering a Föld a Nap körül?",a:30,unit:"km/s",note:"Pontosabban átlagosan kb. 29,8 km/s-mal."},
{cat:14,type:'tip',d:4,q:"Hány kilométer hosszú az emberi test teljes érhálózata?",a:100000,unit:"km",note:"Két és félszer körbeérné a Földet az Egyenlítőnél."},
{cat:14,type:'tip',d:4,q:"Hány Celsius-fokra hevül a levegő egy villám csatornájában?",a:30000,unit:"°C",note:"A hirtelen felrobbanó levegő hangja a mennydörgés."},
{cat:14,type:'tip',d:4,q:"Hány kémiai elem fordul elő természetes formában a Földön?",a:92,unit:"db",note:"A többit mesterségesen, laboratóriumban állították elő."},
{cat:14,type:'tip',d:4,q:"Hány nap alatt újul meg teljesen a bőr legfelső hámrétege?",a:28,unit:"nap",note:"Észrevétlenül, apró hámsejtek formájában kopik le."},
{cat:14,type:'tip',d:5,q:"Hány Celsius-fok a Nap felszínének (fotoszférájának) hőmérséklete?",a:5500,unit:"°C",note:"A Nap magjában ezzel szemben sok millió fok uralkodik."},
{cat:14,type:'tip',d:5,q:"Hány Celsius-fokon forr a nitrogén, vagyis milyen hőmérsékletű a folyékony nitrogén?",a:-196,unit:"°C",note:"Ezért használják mélyfagyasztásra és hűtésre."},
{cat:14,type:'tip',d:5,q:"Hány millió Celsius-fok a Nap magjának hőmérséklete?",a:15,unit:"millió °C",note:"Itt zajlik a hidrogénfúzió, a Nap energiájának forrása."},
{cat:14,type:'tip',d:5,q:"Hány év a plutónium-239 felezési ideje?",a:24000,unit:"év",note:"Ezért jelent hosszú távú gondot a nukleáris hulladék tárolása."},

