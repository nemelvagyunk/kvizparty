{cat:15,type:'mc',d:5,q:"Melyik magyar feltaláló töltéstárolásos szabadalmai alapozták meg a modern televíziós képfelvevő csöveket?",
 o:["Tihanyi Kálmán","Mihály Dénes","Okolicsányi Ferenc","Goldmark Péter"], c:0},
{cat:15,type:'mc',d:5,q:"Ki építette meg a világ első működő turbólégcsavaros repülőgép-hajtóművét?",
 o:["Jendrassik György","Fonó Albert","Kandó Kálmán","Asbóth Oszkár"], c:0},
{cat:15,type:'mc',d:5,q:"Melyik magyar származású kémikus kapott Nobel-díjat a kolloidkémiai kutatásaiért és az ultramikroszkóp kifejlesztéséért?",
 o:["Zsigmondy Richárd","Hevesy György","Polányi Mihály","Oláh György"], c:0},
{cat:15,type:'mc',d:5,q:"Ki készítette a világ első fennmaradt fényképét az 1820-as években?",
 o:["Joseph Nicéphore Niépce","Louis Daguerre","William Fox Talbot","George Eastman"], c:0},
// – tippelős (22 db) –
{cat:15,type:'tip',d:1,q:"Hány különböző színt használ a klasszikus Rubik-kocka?",a:6,unit:"db",note:"Fehér, sárga, piros, narancs, kék és zöld."},
{cat:15,type:'tip',d:1,q:"Hány kis négyzet látható a klasszikus, 3×3-as Rubik-kocka egy oldalán?",a:9,unit:"db",note:"Egy oldalon 3×3-as elrendezésben."},
{cat:15,type:'tip',d:2,q:"Melyik évben kapott fizikai Nobel-díjat Krausz Ferenc az attoszekundumos fényimpulzusok kutatásáért?",a:2023,unit:"",note:"A díjon Pierre Agostinivel és Anne L'Huillier-vel osztozott."},
{cat:15,type:'tip',d:2,q:"Hány kilométeres magasságban húzódik a Kármán Tódorról elnevezett vonal, amelyet a világűr határának tekintenek?",a:100,unit:"km",note:"A magyar származású mérnök-fizikus a modern aerodinamika egyik atyja volt."},
{cat:15,type:'tip',d:2,q:"Melyik évben adták át Budapesten a kontinentális Európa első földalatti vasútját?",a:1896,unit:"",note:"A millenniumi ünnepségekre készült el a Millenniumi Földalatti."},
{cat:15,type:'tip',d:2,q:"Melyik évben jutott a világűrbe Farkas Bertalan, az első magyar űrhajós?",a:1980,unit:"",note:"A Szojuz–36 fedélzetén indult a Szaljut–6 űrállomásra."},
{cat:15,type:'tip',d:2,q:"Melyik évben szabadalmaztatta Thomas Edison a szénszálas izzólámpát?",a:1879,unit:"",note:"Az izzó tömeggyártásával az elektromos világítás korszakát nyitotta meg."},
{cat:15,type:'tip',d:3,q:"Melyik évben találta fel Rubik Ernő a bűvös kockát?",a:1974,unit:"",note:""},
{cat:15,type:'tip',d:3,q:"Melyik évben kapta Szent-Györgyi Albert az orvosi Nobel-díjat?",a:1937,unit:"",note:""},
{cat:15,type:'tip',d:3,q:"Hány kis kockából (elemből) áll össze a klasszikus 3×3-as Rubik-kocka?",a:26,unit:"db",note:"8 sarok + 12 él + 6 középső elem"},
{cat:15,type:'tip',d:3,q:"Melyik évben alapította Richter Gedeon gyógyszerész a később világhírűvé vált gyógyszergyárát?",a:1901,unit:"",note:"A budapesti Sas patikában kezdte meg a gyógyszergyártást."},
{cat:15,type:'tip',d:3,q:"Melyik évben halt meg Semmelweis Ignác?",a:1865,unit:"",note:"Születésnapja, július 1. ma a magyar egészségügy napja."},
{cat:15,type:'tip',d:3,q:"Melyik évben mutatta be Kempelen Farkas a sakkozó törököt, a világhírű sakkautomatát?",a:1769,unit:"",note:"Mária Terézia udvarának készült; valójában egy elrejtett ember irányította"},
{cat:15,type:'tip',d:3,q:"Melyik évben adták át a Széchenyi lánchidat, Pest és Buda első állandó hídját?",a:1849,unit:"",note:"Korának egyik legnagyobb mérnöki teljesítménye volt."},
{cat:15,type:'tip',d:3,q:"Melyik évben indult el az első villamos Budapesten?",a:1887,unit:"",note:"Próbajáratként közlekedett a Nagykörúton."},
{cat:15,type:'tip',d:4,q:"Melyik évben született Neumann János?",a:1903,unit:"",note:"Budapesten"},
{cat:15,type:'tip',d:4,q:"Melyik évben fogta fel Bay Zoltán kutatócsoportja a Holdról visszavert radarjeleket?",a:1946,unit:"",note:"A világon az elsők között sikerült radarvisszhangot venni a Holdról."},
{cat:15,type:'tip',d:4,q:"Melyik évben kapott közgazdasági Nobel-díjat Harsányi János a játékelméleti munkásságáért?",a:1994,unit:"",note:"John Nash-sel és Reinhard Seltennel megosztva kapta a díjat."},
{cat:15,type:'tip',d:4,q:"Melyik évben kapott orvosi Nobel-díjat Bárány Róbert az egyensúlyszerv kutatásáért?",a:1914,unit:"",note:"A díj hírét orosz hadifogságban kapta meg."},
{cat:15,type:'tip',d:5,q:"Melyik évben kapta meg Lénárd Fülöp, az első magyar származású Nobel-díjas a fizikai Nobel-díjat?",a:1905,unit:"",note:"A katódsugarakkal kapcsolatos kutatásaiért tüntették ki."},
{cat:15,type:'tip',d:5,q:"Melyik évben kezdte meg működését az első telefonközpont Budapesten?",a:1881,unit:"",note:"Európa legelső telefonközpontjai között nyílt meg."},
{cat:15,type:'tip',d:5,q:"Melyik évben készült el a Gutenberg-biblia, az első nagy példányszámban nyomtatott európai könyv?",a:1455,unit:"",note:"Körülbelül 180 példány készült belőle."},
