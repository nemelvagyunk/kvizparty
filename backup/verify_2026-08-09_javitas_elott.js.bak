const hash = s => { let h = 5381; for (let i = 0; i < s.length; i++) h = ((h << 5) + h + s.charCodeAt(i)) >>> 0; return h.toString(16).padStart(8, '0'); };

let err = 0, warn = 0, known = 0;
let SECTION = '', sectionWarns = [];
const E = m => { err++; console.log('  ✘ HIBA: ' + m); };
const pending = [];   // {key, msg} – a szakasz végén szűrjük a BASELINE-nal
const W = (key, msg) => pending.push({ key, msg });
function flushWarns(limit){
  const cap = ALL ? Infinity : (limit || 12);
  let shown = 0, hidden = 0, mine = 0;
  for (const p of pending) {
    if (KEYS) console.log("  '" + p.key + "',  // " + p.msg.slice(0, 90));
    if (BASELINE.has(p.key) && !ALL) { known++; continue; }
    warn++; mine++;
    if (shown < cap) { shown++; console.log('  ⚠ ' + (BASELINE.has(p.key) ? '(baseline) ' : 'ÚJ: ') + p.msg); }
    else hidden++;
  }
  if (hidden) console.log('  … és még ' + hidden + ' hasonló (mind: --all)');
  if (mine && SECTION) sectionWarns.push([SECTION, mine]);
  pending.length = 0;
}
/* a szakasz címe + a figyelmeztetés-számlálás egy helyen */
function section(title){ SECTION = title; console.log('— ' + title + ' —'); }
/* szavak a normalizált szövegből */
const words = s => norm(s).split(' ').filter(Boolean);

console.log('KvízParty kérdésbázis-ellenőrző · ' + files.join(' + '));
console.log('Összesen ' + Q.length + ' kérdés (' + Q.filter(q => q.type === 'mc').length + ' mc + '
  + Q.filter(q => q.type === 'tip').length + ' tip), ' + C.length + ' kategória\n');

/* ---------- 1) formai ellenőrzés ---------- */
console.log('— formai ellenőrzés —');
Q.forEach((q, i) => {
  const tag = '#' + i + ' [' + (catOf(q.cat) ? catOf(q.cat).name : '?') + '] „' + short(q.q) + '”';
  if (!catOf(q.cat)) E('érvénytelen kategória (' + q.cat + '): ' + tag);
  if (![1, 2, 3, 4, 5].includes(q.d)) E('érvénytelen nehézség (' + q.d + '): ' + tag);
  if (!q.q || !String(q.q).trim()) E('üres kérdésszöveg: #' + i);
  if (q.type === 'mc') {
    if (!Array.isArray(q.o) || q.o.length !== 4) E('nem 4 opció: ' + tag);
    else if (new Set(q.o.map(norm)).size !== 4) E('ismétlődő opció: ' + tag);
    if (q.c !== 0) E('a helyes válasznak az első opciónak kell lennie (c:0): ' + tag);
  } else if (q.type === 'tip') {
    if (!Number.isInteger(q.a)) E('a tipp-megoldás nem egész szám (' + q.a + '): ' + tag);
    if (q.unit === undefined) E('hiányzó unit mező: ' + tag);
  } else E('ismeretlen típus (' + q.type + '): ' + tag);
});

/* ---------- 2) duplikátum ---------- */
console.log('— duplikátum-keresés —');
{
  const seen = {};
  Q.forEach((q, i) => {
    const k = q.type + ':' + norm(q.q);
    if (seen[k] != null) E('azonos kérdésszöveg: #' + seen[k] + ' és #' + i + ' „' + short(q.q) + '”');
    seen[k] = i;
  });
}

/* ---------- 3) alvó tippek ---------- */
console.log('— alvó tippek (tip:false kategóriában) —');
Q.filter(q => q.type === 'tip' && !(catOf(q.cat) || {}).tip)
  .forEach(q => E('alvó tipp a(z) ' + (catOf(q.cat) || {}).name + ' kategóriában: „' + short(q.q) + '”'));

/* ---------- 4) évszám-szivárgás (azonos témán belül) ---------- */
section('évszám-szivárgás');
{
  const tips = Q.filter(q => q.type === 'tip' && !q.unit && q.a >= 800 && q.a <= 2100);
  let cross = 0;
  for (const t of tips) {
    for (const q of Q) {
      if (q === t) continue;
      const txt = q.q + ' ' + (q.type === 'mc' ? q.o.join(' ') : '') + ' ' + (q.note || '');
      if (!new RegExp('\\b' + t.a + '\\b').test(txt)) continue;
      if (sameTopic(q.cat, t.cat))
        W(hash('y|' + t.a + '|' + norm(t.q) + '|' + norm(q.q)),
          'a(z) ' + t.a + ' évszám kiolvasható innen: „' + short(q.q) + '” → tipp: „' + short(t.q) + '”');
      else cross++;
    }
  }
  flushWarns();
  console.log('  (kereszt-témájú évszám-egybeesés: ' + cross + ' db – ezek jellemzően ártalmatlanok)');
}

/* ---------- 5) válasz-szivárgás: mc-válasz másik ÉLŐ kérdés szövegében/note-jában ---------- */
section('válasz-szivárgás (mc-válaszok más kérdésekben)');
{
  let cross = 0;
  for (const m of Q.filter(q => q.type === 'mc')) {
    const ans = norm(m.o[0]);
    if (ans.length < 8 || ans.split(' ').length < 2) continue;      // rövid/egyszavas: túl zajos lenne
    for (const q of Q) {
      if (q === m) continue;
      if (!norm(q.q + ' ' + (q.note || '')).includes(ans)) continue;
      if (sameTopic(q.cat, m.cat))
        W(hash('a|' + ans + '|' + norm(m.q) + '|' + norm(q.q)),
          '„' + m.o[0] + '” (válasz erre: „' + short(m.q) + '”) megjelenik itt: „' + short(q.q) + '”'
          + (q.note ? ' / note: „' + short(q.note) + '”' : ''));
      else cross++;
    }
  }
  flushWarns();
  console.log('  (kereszt-témájú említés: ' + cross + ' db – kézi átnézés csak akkor kell, ha gyanús)');
}

/* ---------- 6) hossz-árulkodás: a helyes opció feltűnően hosszabb ----------
   Ha a helyes válasz jóval hosszabb a disztraktoroknál, a játékos tudás nélkül is
   ráismer (a leghosszabb, legárnyaltabb opció szokott a helyes lenni). A javítás
   NEM a helyes válasz rövidítése, hanem a rosszak feltöltése azonos regiszterre. */
section('hossz-árulkodás (a helyes opció túl hosszú)');
{
  const RATIO = 1.5, MINLEN = 18;
  let longest = 0, total = 0;
  for (const q of Q.filter(q => q.type === 'mc' && Array.isArray(q.o) && q.o.length === 4)) {
    total++;
    const L = q.o.map(o => String(o).length);
    if (L[0] === Math.max(...L) && L.filter(x => x === L[0]).length === 1) longest++;
    const avg = (L[1] + L[2] + L[3]) / 3;
    if (L[0] >= MINLEN && L[0] > avg * RATIO)
      W(hash('len|' + norm(q.q)),
        'a helyes válasz ' + (L[0] / avg).toFixed(1) + '× hosszabb a disztraktorok átlagánál: „'
        + short(q.q) + '” ✓„' + short(q.o[0]) + '”');
  }
  const n = pending.length;
  flushWarns();
  console.log('  (a helyes válasz ' + (100 * longest / total).toFixed(1) + '%-ban a leghosszabb opció – '
    + 'a véletlen ~25% · ' + n + ' kérdés lépi túl az ' + RATIO + '× küszöböt)');
}

/* ---------- 7) a kérdés elárulja a saját válaszát ----------
   „Hány púpja van a KÉTPÚPÚ tevének?” → 2. Nulla megkülönböztető erő, tiszta
   sebességverseny. Tippnél számnév-összetételt keresünk, mc-nél olyan szót,
   ami a helyes válaszban ÉS a kérdésben szerepel, de egyik rossz válaszban sem. */
section('a kérdés elárulja a választ');
{
  const NUM = {1:'egy', 2:'ket', 3:'harom', 4:'negy', 5:'ot', 6:'hat', 7:'het', 8:'nyolc', 9:'kilenc', 10:'tiz'};
  for (const q of Q.filter(q => q.type === 'tip' && NUM[q.a])) {
    const w = NUM[q.a];
    /* csak ÖSSZETÉTELT fogadunk el találatnak (kétpúpú, egynyári, négylevelű),
       a puszta számnevet nem – az „hat”/„öt” magyarul túl sok szó eleje */
    if (words(q.q).some(t => t.startsWith(w) && t.length >= w.length + 3))
      W(hash('leak|' + norm(q.q)), 'a kérdés szövege tartalmazza a megoldást (' + q.a + '): „' + short(q.q) + '”');
  }
  for (const q of Q.filter(q => q.type === 'mc' && Array.isArray(q.o) && q.o.length === 4)) {
    const qw = new Set(words(q.q));
    const dw = new Set(q.o.slice(1).flatMap(o => words(o)));
    const hit = words(q.o[0]).filter(w => w.length >= 6 && qw.has(w) && !dw.has(w));
    if (hit.length)
      W(hash('leakmc|' + norm(q.q)), 'a „' + hit.join(', ') + '” szó a kérdésben ÉS a helyes válaszban is szerepel, '
        + 'a rosszakban nem: „' + short(q.q) + '” ✓„' + short(q.o[0]) + '”');
  }
  flushWarns();
}

/* ---------- 8) elévülő megfogalmazás ----------
   Időtálló tény a szabály. A „jelenleg” típusú szavak és a rekord-jellegű
   szuperlatívuszok egyszer biztosan hazuggá teszik a kérdést. */
section('elévülő megfogalmazás');
{
  const NOW = /(^|[^a-z])(jelenleg|jelenlegi|manapsag|napjainkban|az aktualis|aktualisan|iden|tavaly|a mai napig|eddig osszesen)([^a-z]|$)/;
  /* szuperlatívusz ÖNMAGÁBAN rendben (a legmagasabb hegy nem változik) – csak
     akkor gyanús, ha rekordhoz/teljesítményhez kötődik, mert az megdőlhet */
  const SUP = /(legtobb|legnagyobb|legdragabb|legnepesebb|legmagasabb|leggyorsabb|leghosszabb|legfiatalabb|legidosebb)/;
  /* a „legjobb” szándékosan kimarad: nálunk szinte mindig Oscar-KATEGÓRIA neve, nem rekord */
  const REC = /(nyert|gyozelem|trofea|rekord|eladott|nezett|bevetel|gazdag|ertekes|nepesebb|nepessegu|dijat)/;
  for (const q of Q) {
    const txt = norm(q.q + ' ' + (q.note || ''));
    if (NOW.test(' ' + txt + ' '))
      W(hash('now|' + norm(q.q)), 'elévülő szóhasználat („jelenleg” jellegű): „' + short(q.q) + '”');
    else if (SUP.test(txt) && REC.test(txt))
      W(hash('sup|' + norm(q.q)), 'megdönthető rekord-szuperlatívusz: „' + short(q.q) + '”');
  }
  flushWarns();
}

/* ---------- 9) tippelős józansági ellenőrzés ---------- */
section('tippelős kérdések józansági ellenőrzése');
{
  for (const q of Q.filter(q => q.type === 'tip')) {
    const tag = '„' + short(q.q) + '” → ' + q.a;
    /* üres unit = ÉVSZÁM: a játék évszámként formázza. Ha nem évet kérdez, hibás. */
    if (q.unit === '' && !/ev/.test(norm(q.q)))
      E('üres unit, de a kérdés nem évszámot kér (a játék évként írná ki): ' + tag);
    if (q.unit === '' && (q.a < 1 || q.a > 2100))
      E('üres unit (évszám-formátum), de a megoldás nem lehet évszám: ' + tag);
    if (!q.note || !String(q.note).trim())
      W(hash('note|' + norm(q.q)), 'nincs note – az eredményhirdetésnél elvész egy „nahát!”: ' + tag);
    /* nagy, horgonyzatlan érték: a nyertes a nagyságrendet találja el, nem a tényt,
       és a telitalálat-bónusz tiszta szerencse. Kérdezd ezerben/millióban vagy arányban. */
    if (q.unit !== '' && Math.abs(q.a) >= 10000 && !/(ezer|millio|milliard)/.test(norm(q.q + ' ' + q.unit)))
      W(hash('big|' + norm(q.q)), 'nagy, horgonyzatlan érték (' + q.a + ') – érdemes ezerben/millióban vagy '
        + 'arányban kérdezni: „' + short(q.q) + '”');
  }
  flushWarns();
}

/* ---------- 10) változatosság-riport (információ, nem hiba) ---------- */
console.log('\n— változatosság (információ) —');
{
  const tipGroups = {};
  for (const q of Q.filter(q => q.type === 'tip')) {
    const k = tipgOf(q.cat);
    (tipGroups[k] = tipGroups[k] || { n: 0, y: 0 }).n++;
    if (q.unit === '') tipGroups[k].y++;
  }
  console.log('  évszám-arány a tippelős tételekben (a 40–50% fölötti egyhangú):');
  Object.keys(tipGroups).sort((a, b) => tipGroups[b].y / tipGroups[b].n - tipGroups[a].y / tipGroups[a].n)
    .forEach(k => {
      const t = tipGroups[k], pct = Math.round(100 * t.y / t.n);
      console.log('    ' + (k + ' ').padEnd(16, '·') + ' ' + String(pct).padStart(3) + '%  ('
        + t.y + '/' + t.n + ')  ' + '█'.repeat(Math.round(pct / 5)));
    });

  const starts = {};
  const mcs = Q.filter(q => q.type === 'mc');
  mcs.forEach(q => { const w = words(q.q).slice(0, 2).join(' '); starts[w] = (starts[w] || 0) + 1; });
  const top = Object.entries(starts).sort((a, b) => b[1] - a[1]).slice(0, 8);
  console.log('  leggyakoribb kérdéskezdetek (' + mcs.length + ' mc):');
  top.forEach(([w, n]) => console.log('    ' + (w + ' ').padEnd(20, '·') + ' ' + String(n).padStart(3)
    + '  (' + (100 * n / mcs.length).toFixed(1) + '%)'));
  const first = {};
  mcs.forEach(q => { const w = words(q.q)[0] || '?'; first[w] = (first[w] || 0) + 1; });
  const t2 = Object.entries(first).sort((a, b) => b[1] - a[1]).slice(0, 3)
    .map(([w, n]) => w + ' ' + (100 * n / mcs.length).toFixed(0) + '%').join(' · ');
  console.log('    első szó szerint: ' + t2);
}

/* ---------- 11) kvóta-áttekintés (információ) ---------- */
console.log('\n— kvóták (információ) —');
for (const c of C) {
  const mc = Q.filter(q => q.cat === c.id && q.type === 'mc').length;
  const tip = Q.filter(q => q.cat === c.id && q.type === 'tip').length;
  console.log('  ' + String(c.id).padStart(2) + ' ' + (c.name + ' ').padEnd(33, '·')
    + ' mc:' + String(mc).padStart(3) + (c.tip ? ('  tip:' + String(tip).padStart(3) + '  [' + tipgOf(c.id) + ']') : ''));
}
const dd = { mc: [0, 0, 0, 0, 0], tip: [0, 0, 0, 0, 0] };
Q.forEach(q => { if (dd[q.type]) dd[q.type][(q.d || 3) - 1]++; });
console.log('  nehézség (d1..d5)  mc: ' + dd.mc.join(' / ') + '   tip: ' + dd.tip.join(' / '));

/* ---------- összegzés ---------- */
if (sectionWarns.length) {
  console.log('\n— átnézendő (szakaszonként) —');
  sectionWarns.sort((a, b) => b[1] - a[1]).forEach(([t, n]) =>
    console.log('  ' + String(n).padStart(4) + ' × ' + t));
  console.log('  (részletek: --all · ha valamelyiket ÁTNÉZTED és rendben van, a --keys kimenetből emeld a BASELINE-ba)');
}
console.log('\n' + (err ? ('❌ ' + err + ' hiba') : '✅ nincs hiba')
  + (warn ? (' · ⚠ ' + warn + ' ÚJ, átnézendő figyelmeztetés') : ' · nincs új figyelmeztetés')
  + (known ? (' · ' + known + ' ismert egyezés a baseline-ban') : ''));
process.exitCode = err ? 1 : 0;
